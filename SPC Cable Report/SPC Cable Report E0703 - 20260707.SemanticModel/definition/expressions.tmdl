expression 'Query1 (Original)' =
		let
		    Source = Oracle.Database("SPFC5DUP.world", [HierarchicalNavigation=true, Query="with SPCRPT_WORKSTEP_IOBJ_PROP_TMP as (#(lf)SELECT#(lf)            COMPWORKSTEP.OBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP.OBJUID AS ""COMPWORKSTEPUID"",#(tab)  #(lf)            COMPWORKSTEP.CONFIG AS ""PROJECT""#(lf)FROM DATAOBJ COMPWORKSTEP WHERE COMPWORKSTEP.OBJDEFUID = 'SPC_ComponentWorkTypeStep' AND COMPWORKSTEP.TERMINATIONDATE = '9999/12/31-23:59:59:999'),#(lf)#(lf)SPCRPT_WORKSTEP_DIR_PROP_TMP as (#(lf)SELECT#(lf)            COMPWORKSTEP.COMPWORKSTEPOBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP_NAME.STRVALUE AS ""STEPNAME"", #(lf)            COMPWORKSTEP_DESCRIPTION.STRVALUE AS ""DESCRIPTION"",#(lf)            CAST(COMPWORKSTEP_SEQUENCE.STRVALUE AS INT) AS ""SEQUENCE"",#(lf)            CAST(COMPWORKSTEP_UNITRATE.STRVALUE AS FLOAT) AS ""UNITRATE"",#(lf)            COMPWORKSTEP_RATEUOM.STRVALUE AS ""RATEUOM"",#(lf)            COMPWORKSTEP_NOTES.STRVALUE AS ""NOTES"",#(lf)#(tab)#(tab)#(tab)COMPWORKSTEP_ACTUALDRUMNO.STRVALUE AS ""ACTUALDRUMNO_WS"",#(lf)            CAST(COMPWORKSTEP_PLANNEDMANHOURS.STRVALUE AS FLOAT) AS ""PLANNEDMANHOURS"",#(lf)            CAST(COMPWORKSTEP_ACTUALMANHOURS.STRVALUE AS FLOAT) AS ""ACTUALMANHOURS"",#(lf)            COMPWORKSTEP_DATECOMPLETE.STRVALUE AS ""ACTUALDATECOMPLETE"",#(lf)            CAST(COMPWORKSTEP_QUANTITYCOMPLETE.STRVALUE AS FLOAT) AS ""QUANTITYCOMPLETE"",#(lf)            CAST(COMPWORKSTEP_ACTUALQUANTITY.STRVALUE AS FLOAT) AS ""ACTUALQUANTITY"",#(lf)            COMPWORKSTEP_QUANTITYCOMPLETE.TERMINATIONDATE,               #(lf)            SUBSTR(COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONDATE,0, INSTR(COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONDATE,'-')-1) AS ""CREATIONDATE"" ,#(lf)            COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONUSER#(lf)            #(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP COMPWORKSTEP#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_NAME ON COMPWORKSTEP_NAME.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_NAME.PROPERTYDEFUID = 'Name' AND COMPWORKSTEP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_DESCRIPTION ON COMPWORKSTEP_DESCRIPTION.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_DESCRIPTION.PROPERTYDEFUID = 'Description' AND COMPWORKSTEP_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_SEQUENCE ON COMPWORKSTEP_SEQUENCE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_SEQUENCE.PROPERTYDEFUID = 'ComponentWorkTypeStep_Sequence' AND COMPWORKSTEP_SEQUENCE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_UNITRATE ON COMPWORKSTEP_UNITRATE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_UNITRATE.PROPERTYDEFUID = 'ComponentWorkTypeStep_UnitRate' AND COMPWORKSTEP_UNITRATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_RATEUOM ON COMPWORKSTEP_RATEUOM.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_RATEUOM.PROPERTYDEFUID = 'ComponentWorkTypeStep_RateUoM' AND COMPWORKSTEP_RATEUOM.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_NOTES ON COMPWORKSTEP_NOTES.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_NOTES.PROPERTYDEFUID = 'ComponentWorkTypeStep_Notes' AND COMPWORKSTEP_NOTES.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_PLANNEDMANHOURS ON COMPWORKSTEP_PLANNEDMANHOURS.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_PLANNEDMANHOURS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ManHours' AND COMPWORKSTEP_PLANNEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)LEFT JOIN DATAOBJPR COMPWORKSTEP_ACTUALMANHOURS ON COMPWORKSTEP_ACTUALMANHOURS.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_ACTUALMANHOURS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualHours' AND COMPWORKSTEP_ACTUALMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_DATECOMPLETE ON COMPWORKSTEP_DATECOMPLETE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_DATECOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualDateComplete' AND COMPWORKSTEP_DATECOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_QUANTITYCOMPLETE ON COMPWORKSTEP_QUANTITYCOMPLETE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_QUANTITYCOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_QuantityComplete' AND COMPWORKSTEP_QUANTITYCOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_ACTUALQUANTITY ON COMPWORKSTEP_ACTUALQUANTITY.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_ACTUALQUANTITY.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualQuantity' AND COMPWORKSTEP_ACTUALQUANTITY.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--ACTUAL DRUM NO#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_ACTUALDRUMNO ON COMPWORKSTEP_ACTUALDRUMNO.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_ACTUALDRUMNO.PROPERTYDEFUID = 'SPC_ActucalDrumNo_WS' AND COMPWORKSTEP_ACTUALDRUMNO.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)),#(lf)#(lf)SPCRPT_WORKSTEP_REL_PROP_TMP as (#(lf)SELECT#(lf)            COMPWORKSTEP.COMPWORKSTEPOBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP_WORKTYPE_COSTCODE.STRVALUE AS ""COSTCODE"",#(lf)            COMPWORKSTEP_FIWP.OBID AS ""FIWPOBID"",#(tab)  #(lf)            COMPWORKSTEP_WORKTYPE.OBID AS ""WORKTYPEOBID"",#(lf)            COMPWORKSTEP_COMP.OBID AS ""COMPOBID"",#(lf)           CAST(COMPONENTITEM_QUANTITYPLANNED.STRVALUE AS FLOAT) AS ""QUANTITYPLANNED""#(lf)           #(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP COMPWORKSTEP#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_FIWP_REL ON COMPWORKSTEP_FIWP_REL.UID2 = COMPWORKSTEP.COMPWORKSTEPUID  AND COMPWORKSTEP_FIWP_REL.DEFUID = 'SPC_Package_ComponentWorkTypeStep' AND COMPWORKSTEP_FIWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_FIWP ON COMPWORKSTEP_FIWP.OBJUID = COMPWORKSTEP_FIWP_REL.UID1 AND COMPWORKSTEP_FIWP.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_FIWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_WORKTYPE_REL ON COMPWORKSTEP_WORKTYPE_REL.UID2 = COMPWORKSTEP.COMPWORKSTEPUID AND COMPWORKSTEP_WORKTYPE_REL.DEFUID = 'SPC_ComponentWorkType_ComponentWorkTypeSteps' AND COMPWORKSTEP_WORKTYPE_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_WORKTYPE ON COMPWORKSTEP_WORKTYPE.OBJUID = COMPWORKSTEP_WORKTYPE_REL.UID1 AND COMPWORKSTEP_WORKTYPE.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_WORKTYPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_WORKTYPE_COSTCODE ON COMPWORKSTEP_WORKTYPE_COSTCODE.OBJOBID = COMPWORKSTEP_WORKTYPE.OBID AND COMPWORKSTEP_WORKTYPE_COSTCODE.PROPERTYDEFUID = 'ComponentWorkType_CostCode' AND COMPWORKSTEP_WORKTYPE_COSTCODE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_COMP_REL ON COMPWORKSTEP_COMP_REL.UID2 = COMPWORKSTEP_WORKTYPE.OBJUID AND COMPWORKSTEP_COMP_REL.DEFUID = 'SPC_ComponentItem_ComponentWorkType' AND COMPWORKSTEP_COMP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_COMP ON COMPWORKSTEP_COMP.OBJUID = COMPWORKSTEP_COMP_REL.UID1 AND COMPWORKSTEP_COMP.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_COMP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_QUANTITYPLANNED ON COMPONENTITEM_QUANTITYPLANNED.OBJOBID = COMPWORKSTEP_COMP.OBID AND COMPONENTITEM_QUANTITYPLANNED.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_QUANTITYPLANNED.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)),#(lf)WorkSteps as (#(lf)SELECT#(lf)#(tab)    t1.COMPWORKSTEPOBID, COMPWORKSTEPUID, PROJECT, #(lf)      STEPNAME, DESCRIPTION, SEQUENCE, UNITRATE, RATEUOM, ACTUALDRUMNO_WS, NOTES, PLANNEDMANHOURS, ACTUALMANHOURS, ACTUALDATECOMPLETE, QUANTITYCOMPLETE, #(lf)      COSTCODE, FIWPOBID, WORKTYPEOBID, COMPOBID, QUANTITYPLANNED, ACTUALQUANTITY,  TERMINATIONDATE, CREATIONDATE, CREATIONUSER,#(lf)      CASE WHEN UNITRATE = 0 then #(lf)        decode(ACTUALQUANTITY, 0, null, round(QUANTITYCOMPLETE/ACTUALQUANTITY,2)) *100 ELSE#(lf)        decode(PLANNEDMANHOURS, 0, null, round(ACTUALMANHOURS/PLANNEDMANHOURS,2)) *100  END AS WorkStepPercComp,#(lf)        CASE WHEN PLANNEDMANHOURS = ACTUALMANHOURS THEN 1 ELSE 0 END AS PROGRESSCOMPLETE#(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_WORKSTEP_DIR_PROP_TMP t2 ON t2.COMPWORKSTEPOBID = t1.COMPWORKSTEPOBID#(lf)LEFT JOIN SPCRPT_WORKSTEP_REL_PROP_TMP t3 ON t3.COMPWORKSTEPOBID = t1.COMPWORKSTEPOBID),#(lf)#(lf)#(lf)--Select * From WorkSteps  where COMPworkstepuid = 'ee13e375-6939-4d9f-b3bb-bc7f4c1824f8'#(lf)#(lf)#(lf) SPCRPT_COMP_IOBJECT_PROP_TMP as (#(lf)SELECT #(lf)            COMPONENTITEM.OBID AS ""COMPOBID"",#(lf)            COMPONENTITEM.OBJUID AS ""COMPUID"",#(lf)            COMPONENTITEM.CONFIG AS ""PROJECT"",#(lf)            COMPONENTITEM.OBJDEFUID AS ""OBJTYPE""#(lf)FROM DATAOBJ COMPONENTITEM WHERE COMPONENTITEM.OBJDEFUID IN ( 'SPC_NonPublishedComponentItem') AND COMPONENTITEM.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)--'SPC_ComponentItem', 'SPC_AdhocComponentItem',  'SPC_NonPublishedComponentItem',#(lf)SPCRPT_COMP_DIRECT_PROP_TMP as (#(lf)SELECT #(lf)            COMPONENTITEM.COMPOBID AS ""COMPOBID"",#(lf)            COMPONENTITEM_NAME.STRVALUE AS ""NAME"", #(lf)            COMPONENTITEM_DESCRIPTION.STRVALUE AS ""DESCRIPTION"",#(tab)  #(lf)            COMPONENTITEM_MATERIAL.STRVALUE AS ""MATERIAL"",#(tab)  #(lf)            COMPONENTITEM_RATING.STRVALUE AS ""RATING"",#(tab)  #(lf)            COMPONENTITEM_CLASS.STRVALUE AS ""CLASS"",#(tab)  #(lf)            CAST(COMPONENTITEM_SIZE.STRVALUE AS FLOAT) AS ""COMPSIZE"",#(tab)  #(lf)            COMPONENTITEM_THICKNESS.STRVALUE AS ""THICKNESS"",#(tab)  #(lf)            CAST(COMPONENTITEM_UNITS.STRVALUE AS FLOAT) AS ""UNITS"",#(lf)            COMPONENTITEM_COMMODITYCODE.STRVALUE AS ""COMMODITYCODE"",#(lf)            COMPONENTITEM_DRAWINGTITLE.STRVALUE AS ""DRAWINGTITLE"",#(lf)            COMPONENTITEM_DRAWINGREVISION.STRVALUE AS ""DRAWINGREVISION"",#(lf)            COMPONENTITEM_REVISIONDATE.STRVALUE AS ""REVISIONDATE"",#(lf)            COMPONENTITEM_TRANSMITTALNO.STRVALUE AS ""TRANSMITTALNO"",#(lf)            COMPONENTITEM_COMPONENTSTATUS.STRVALUE AS ""COMPONENTSTATUS"",#(lf)            COMPONENTITEM_NESTDWG.STRVALUE AS ""NESTINGDWG"",#(lf)            COMPONENTITEM_DRUMNO.STRVALUE AS ""ACTUALDRUMNO"",#(lf)            COMPONENTITEM_ELECTSERVICES.STRVALUE AS ""ELECTSERVICES"",#(lf)            OBJTYPE#(lf)FROM SPCRPT_COMP_IOBJECT_PROP_TMP COMPONENTITEM#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_NAME ON COMPONENTITEM_NAME.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_NAME.PROPERTYDEFUID = 'Name' AND COMPONENTITEM_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DESCRIPTION ON COMPONENTITEM_DESCRIPTION.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DESCRIPTION.PROPERTYDEFUID = 'SPC_ComponentItem_ShortDescription' AND COMPONENTITEM_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)    LEFT JOIN DATAOBJPR COMPONENTITEM_MATERIAL ON COMPONENTITEM_MATERIAL.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_MATERIAL.PROPERTYDEFUID = 'SPC_ComponentItem_Material' AND COMPONENTITEM_MATERIAL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_RATING ON COMPONENTITEM_RATING.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_RATING.PROPERTYDEFUID = 'SPC_ComponentItem_Rating' AND COMPONENTITEM_RATING.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)    LEFT JOIN DATAOBJPR COMPONENTITEM_CLASS ON COMPONENTITEM_CLASS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_CLASS.PROPERTYDEFUID = 'SpcNonPublishedClassDesignation' AND COMPONENTITEM_CLASS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_SIZE ON COMPONENTITEM_SIZE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_SIZE.PROPERTYDEFUID = 'SPC_ComponentItem_Size' AND COMPONENTITEM_SIZE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_THICKNESS ON COMPONENTITEM_THICKNESS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_THICKNESS.PROPERTYDEFUID = 'SPC_ComponentItem_Thickness' AND COMPONENTITEM_THICKNESS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_UNITS ON COMPONENTITEM_UNITS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_UNITS.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_UNITS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_COMMODITYCODE ON COMPONENTITEM_COMMODITYCODE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_COMMODITYCODE.PROPERTYDEFUID = 'SPC_ComponentItem_CommodityCode' AND COMPONENTITEM_COMMODITYCODE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DRAWINGTITLE ON COMPONENTITEM_DRAWINGTITLE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DRAWINGTITLE.PROPERTYDEFUID = 'MDR_IDOCS_DrawingTitle' AND COMPONENTITEM_DRAWINGTITLE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DRAWINGREVISION ON COMPONENTITEM_DRAWINGREVISION.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DRAWINGREVISION.PROPERTYDEFUID = 'MDR_IDOCS_DrawingRevision' AND COMPONENTITEM_DRAWINGREVISION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_REVISIONDATE ON COMPONENTITEM_REVISIONDATE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_REVISIONDATE.PROPERTYDEFUID = 'MDR_IDOCS_RevisionDate' AND COMPONENTITEM_REVISIONDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_TRANSMITTALNO ON COMPONENTITEM_TRANSMITTALNO.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_TRANSMITTALNO.PROPERTYDEFUID = 'MDR_IDOCS_TransmittalNo' AND COMPONENTITEM_TRANSMITTALNO.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_COMPONENTSTATUS ON COMPONENTITEM_COMPONENTSTATUS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_COMPONENTSTATUS.PROPERTYDEFUID = 'MDR_ComponentStatus' AND COMPONENTITEM_COMPONENTSTATUS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_NESTDWG ON COMPONENTITEM_NESTDWG.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_NESTDWG.PROPERTYDEFUID = 'SPC_ComponentItem_NestDwg' AND COMPONENTITEM_NESTDWG.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DRUMNO ON COMPONENTITEM_DRUMNO.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DRUMNO.PROPERTYDEFUID = 'MDR_ActualDrumNo' AND COMPONENTITEM_DRUMNO.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR COMPONENTITEM_ELECTSERVICES ON COMPONENTITEM_ELECTSERVICES.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_ELECTSERVICES.PROPERTYDEFUID = 'SPC_DataObject_ElecServices' AND COMPONENTITEM_ELECTSERVICES.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)SPCRPT_COMPONENTITEM1 as (#(lf)SELECT#(lf)      #(lf)#(tab)    t1.COMPOBID, COMPUID, PROJECT, ACTUALDRUMNO,ELECTSERVICES,    #(lf)#(tab)    NAME, DESCRIPTION, MATERIAL, RATING, CLASS, COMPSIZE, THICKNESS, UNITS, #(lf)#(tab)    COMMODITYCODE,DRAWINGTITLE,DRAWINGREVISION,REVISIONDATE,TRANSMITTALNO,#(lf)#(tab)    COMPONENTSTATUS, NESTINGDWG, T2.OBJTYPE#(lf)FROM SPCRPT_COMP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_COMP_DIRECT_PROP_TMP t2 ON t2.COMPOBID = t1.COMPOBID#(lf)),#(lf)SPCRPT_REG_IOBJECT_PROP_TMP as (#(lf)#(lf)--SELECT #(lf)--            REG.OBID AS ""REGOBID"",#(lf)--            REG.OBJUID AS ""REGUID"",#(lf)--            REG.CONFIG AS ""PROJECT"" #(lf)      #(lf)--FROM DATAOBJ REG WHERE REG.OBJDEFUID = 'SPC_DataObject' AND REG.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)--And#(lf)--REG.OBJUID in (#(lf)--select UID2 from datarel where DEFUID ='SPC_NonPublishedDocVersion_DataObject' and terminationdate ='9999/12/31-23:59:59:999' and uid1 in (#(lf)--select uid2 from docrel where terminationdate='9999/12/31-23:59:59:999' and DEFUID ='SPFRevisionVersions' and uid1 in (#(lf)--select OBJUID from docobj where terminationdate='9999/12/31-23:59:59:999' and OBJDEFUID ='SPFDesignDocRevision' And Objname like '%CABLE SCH%' and obid in (#(lf)--select OBJOBID from docobjpr where propertydefuid ='SPFRevState' and strvalue ='e1CURRENT' and terminationdate='9999/12/31-23:59:59:999'))))#(lf)#(lf)SELECT #(lf)            REG.OBID AS ""REGOBID"",#(lf)            REG.OBJUID AS ""REGUID"",#(lf)            REG.CONFIG AS ""PROJECT"" #(lf)            --Pr1.terminationdate#(lf)      #(lf)FROM DATAOBJ REG #(lf)Left Join DataRel Rel1 On REG.OBJUID = Rel1.UID2 And Rel1.DEFUID ='SPC_NonPublishedDocVersion_DataObject' and Rel1.terminationdate ='9999/12/31-23:59:59:999'#(lf)Left Join DocRel  DRel1 On Rel1.UID1 = DRel1.UID2 And DRel1.DEFUID ='SPFRevisionVersions' And DRel1.terminationdate='9999/12/31-23:59:59:999'#(lf)Left Join DocObj  DObj  On DRel1.UID1 = DObj.OBJUID and DObj.OBJDEFUID ='SPFDesignDocRevision' And DObj.Objname like '%CABLE SCH%'#(lf)Left Join DocObjPr Pr1 On DObj.OBID = Pr1.OBJOBID And Pr1.propertydefuid ='SPFRevState' and Pr1.strvalue ='e1CURRENT' And Pr1.terminationdate='9999/12/31-23:59:59:999'#(lf)#(lf)WHERE REG.OBJDEFUID = 'SPC_DataObject' AND REG.TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)--And REG.Objname = 'BW61.N1.NE01.N001~N010.WF0001'#(lf)And Pr1.terminationdate Is Not Null#(lf)#(lf)),#(lf)SPCRPT_REG_DIRECT_PROP_TMP  as (#(lf)SELECT #(lf)            REG.REGOBID AS ""REGOBID"",#(lf)            REG_NAME.STRVALUE AS ""TAGID"",#(lf)            REG_DECKNAME.STRVALUE AS ""DECKNAME"",#(lf)            REG_ELESERVICE.STRVALUE AS ""SERVICE"",#(lf)            REG_CABLEPOWER.STRVALUE AS ""CABLEPOWER"",#(lf)            REG_VOLT.STRVALUE AS ""Volt_AC_DC""