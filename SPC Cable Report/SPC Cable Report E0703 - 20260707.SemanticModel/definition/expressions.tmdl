DRUMNO_WS"") as ""PULLING ACTUALDRUMNO_WS"",#(lf)MAX(""PULLING ACTUAL DATE"") as ""PULLING ACTUAL DATE"",#(lf)#(lf)CASE WHEN SUM(""PULLING MANHOURS"")>0 THEN SUM(""PULLING ACTUAL"")/ SUM(""PULLING MANHOURS"") * 100  ELSE 0 END AS ""Pulled %"",#(lf)#(lf)CASE WHEN SUM(""PULLING ACTUAL"")>0 THEN MAX(Y.PullProgressDate)  ELSE '' END AS ""Pulled Comp Date"",#(lf)CASE WHEN SUM(""PULLING ACTUAL"")>0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Pulled Prog By"",#(lf)#(lf)#(lf)MAX(""Dressing IWP No"") as ""Dressing IWP No"",#(lf)MAX(""Dressing Cost Code"") as ""Dressing Cost Code"",#(lf)SUM(DressingManhours) as ""Dressing Manhours"",#(lf)SUM(""Dressing ACTUAL"") as ""Dressing ACTUAL"",#(lf)MAX(""Dressing ACTUAL DATE"") as ""Dressing ACTUAL DATE"",#(lf)MAX(""Dressing ACTUALDRUMNO_WS"") as ""Dressing ACTUALDRUMNO_WS"",#(lf) #(lf)#(lf)CASE WHEN SUM(DressingManhours)>0 THEN SUM(""Dressing ACTUAL"")/ SUM(DressingManhours) * 100  ELSE 0 END AS ""Dressing %"",#(lf)CASE WHEN SUM(""Dressing ACTUAL"")>0 THEN MAX(Y.DressProgressDate) ELSE '' END AS ""Dressing Comp Date"",#(lf)CASE WHEN SUM(""Dressing ACTUAL"")>0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Dressing Prog By"",#(lf)#(lf)MAX(""GLANDING FROM IWP NO"") as ""GLANDING FROM IWP NO"",#(lf)MAX(""Glanding From Cost Code"") as ""Glanding From Cost Code"",#(lf)SUM(""Glanding From Manhours"") as ""Glanding From Manhours"",#(lf)SUM(""Glanding From Actual"") as ""Glanding From Actual"",#(lf)MAX(""Glanding From ACTUAL DATE"") as ""Glanding From ACTUAL DATE"",#(lf)#(lf)CASE WHEN SUM(""Glanding From Manhours"")>0 THEN SUM(""Glanding From Actual"") / SUM(""Glanding From Manhours"")  * 100  else 0 end as ""Glanded From %"",#(lf)CASE WHEN SUM(""Glanding From Actual"") >0  THEN MAX(Y.GlandFromProgressDate) ELSE '' END AS ""Glanding From Comp Date"",#(lf)CASE WHEN SUM(""Glanding From Actual"") >0  THEN MAX(""Last Progress User"") ELSE '' END AS ""Glanding From Prog By"",#(lf)#(lf)MAX(""GLANDING TO IWP NO"") as ""GLANDING TO IWP NO""