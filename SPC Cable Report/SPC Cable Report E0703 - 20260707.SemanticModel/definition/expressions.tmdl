tual"") >0 THEN MAX(Y.TerminateToProgressDate) ELSE '' END AS ""Termination To Comp Date"",#(lf)CASE WHEN SUM(""Termination To Actual"") >0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Termination To Prog By"",#(lf)#(lf)MAX(""Testing IWP No"") as ""Testing IWP No"",#(lf)MAX(""Testing Cost Code"") as ""Testing Cost Code"",#(lf)SUM(""Testing Manhours"") as ""Testing Manhours"",#(lf)SUM(""Testing Actual"") as ""Testing Actual"",#(lf)MAX(""Testing ACTUAL DATE"") as ""Testing ACTUAL DATE"",#(lf)#(lf)CASE WHEN SUM(""Testing Manhours"")>0 THEN SUM(""Testing Actual"") / SUM(""Testing Manhours"")  * 100  else 0 end as ""Testing %"",#(lf)CASE WHEN SUM(""Testing Actual"") >0 THEN MAX(Y.TestProgressDate) ELSE '' END AS ""Testing Comp Date"",#(lf)CASE WHEN SUM(""Testing Actual"") >0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Testing Prog By"",#(lf)#(lf)SUM(""Accep Manhours"") as ""Accep Manhours"",#(lf)SUM(""Accep Actual"") as ""Accep Actual"" ,#(lf)MAX(""Accep ACTUAL DATE"") as ""Accep ACTUAL DATE"",#(lf)#(lf)CASE WHEN SUM(""Accep Manhours"")>0 THEN SUM(""Accep Actual"") / SUM(""Accep Manhours"")  * 100  else 0 end as ""Accep %"",#(lf)CASE WHEN SUM(""Accep Actual"") >0 THEN MAX(""PROGRESSEDDATE"") ELSE '' END AS ""Accep Comp Date"",#(lf) #(lf)CASE WHEN SUM(""Accep Actual"") >0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Accep Prog By"" ,#(lf)(FROM_GLANDCOUNT * CASE WHEN SUM(""Glanding From Manhours"")>0 THEN SUM(""Glanding From Actual"") / SUM(""Glanding From Manhours"")  * 100  else 0 end)/100 AS ""FROM_GLAND_COMPLETED"",#(lf)(TO_GLANDCOUNT * CASE WHEN SUM(""Glanding To Manhours"")>0 THEN SUM(""Glanding To Actual"") / SUM(""Glanding To Manhours"")  * 100  else 0 end)/100 AS ""TO_GLAND_COMPLETED"",#(lf)#(lf)(FROM_GLANDCOUNT * CASE WHEN SUM(""Termination From Manhours"")>0 THEN SUM(""Termination From Actual"") / SUM(""Termination From Manhours"")  * 100  else 0 end)/100 AS ""FROM_TERMINATION_COMPLETED"",#(lf)(TO_GLANDCOUNT * CASE WHEN SUM(""Termination To Manhours"")>0 THEN SUM(""Termination To Actual"") / SUM(""Termination To Manhours"")  * 100  else 0 end)/100 AS ""TO_TERMINATION_COMPLETED"",#(lf) #(lf) ( CASE WHEN SUM(""Testing Manhours"")>0 THEN SUM(""Testing Actual"") / SUM(""Testing Manhours"")  * 100  else 0 end)/100 AS ""TESTING_COMPLETED""#(lf)#(lf) #(lf)from DETAIL_DS X#(lf)LEFT JOIN PROGRESS_TABLE Y#(lf)ON X.TAGID=Y.cTAGID#(lf) where  ""ClassDesignation"" = 'Non_Published_CableSchedule'#(lf)--where  TAGID = '634-002-CC-1581'#(lf)#(lf)GROUP BY  ""DECKNAME"", ""TAGID"", ""SERVICE"", ""CABLEPOWER"", ""Volt_AC_DC"", ""FromEquipment"", ""ToEquipment"", ""FromTag"", ""FromDescription"",""FromEqpStatus"", ""ToEqpStatus"",""ToTag"", ""TODESCRIPTION"", ""CoreNo"", ""CoreSize"", ""CableVoltage"", ""From_RoomNo"",""To_RoomNo"",""UNITS"",#(lf)""SCOPE"", ""FROMDECKLEVEL"", ""TODECKLEVEL"", ""FromGlandScope"", ""ToGlandScope"", ""CableDrumNo"", ""ActualDrumNo"", ""RevHistory"",""CableSpecification"", ""Remarks"", ""Remarks1"", ""LocationDescription"", ""CableAssociatedTo"", ""CommodityCode"", ""PartNumber"", ""ClassDesignation"", ""CREATED_BY"",""CREATED_DATE"", ""SYSTEM"", ""SUBSYSTEM"",#(lf)""FROM_CORRECTEDTAG"", ""FROM_GROUPCATEGORYL2"", ""FROM_GROUPDESCL4"", ""FROM_LOCATION"", ""FROM_GLANDCOUNT"", ""FROM_EQPTIDENTCODE"", ""FROM_EQPTPOREF"", #(lf)""TO_CORRECTEDTAG"", ""TO_GROUPCATEGORYL3"", ""TO_GROUPDESCL4"", ""TO_TOLOCATION"", ""TO_GLANDCOUNT"", ""TO_EQPTIDENTCODE"", ""TO_EQPTPOREF"",#(lf)""FROM_TERMINATIONCOUNT"",""TO_TERMINATIONCOUNT"",""TESTINGCOUNT"", ""TYPE"", ""STAGE""#(lf) #(lf)"])
