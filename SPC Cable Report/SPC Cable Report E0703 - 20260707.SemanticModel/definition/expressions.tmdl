SCRIPTION.STRVALUE AS ""DESCRIPTION"", #(lf)            TO_DATE(FIWP_PLANNEDSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDSTARTDATE"",            #(lf)            TO_DATE(FIWP_PLANNEDFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDFINISHDATE"",#(lf)            TO_DATE(FIWP_ACTUALSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALSTARTDATE"",#(lf)            TO_DATE(FIWP_ACTUALFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALFINISHDATE"",#(lf)            CAST(FIWP_ESTIMATEDMANHOURS.STRVALUE AS FLOAT) AS ""ESTIMATEDMANHOURS"",#(lf)            FIWP_SCOPE.STRVALUE AS ""SCOPE"",#(lf)            FIWP_NOTES.STRVALUE AS ""NOTES""#(lf)      #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_NAME ON FIWP_NAME.OBJOBID = FIWP.FIWPOBID AND FIWP_NAME.PROPERTYDEFUID = 'Name' AND FIWP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DESCRIPTION ON FIWP_DESCRIPTION.OBJOBID = FIWP.FIWPOBID AND FIWP_DESCRIPTION.PROPERTYDEFUID = 'Description' AND FIWP_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PLANNEDSTARTDATE ON FIWP_PLANNEDSTARTDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_PLANNEDSTARTDATE.PROPERTYDEFUID = 'FIWP_PlannedStartDate' AND FIWP_PLANNEDSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PLANNEDFINISHDATE ON FIWP_PLANNEDFINISHDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_PLANNEDFINISHDATE.PROPERTYDEFUID = 'FIWP_PlannedFinishDate' AND FIWP_PLANNEDFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALSTARTDATE ON FIWP_ACTUALSTARTDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_ACTUALSTARTDATE.PROPERTYDEFUID = 'FIWP_ActualStartDate'  AND FIWP_ACTUALSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALFINISHDATE ON FIWP_ACTUALFINISHDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_ACTUALFINISHDATE.PROPERTYDEFUID = 'FIWP_ActualFinishDate'  AND FIWP_ACTUALFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ESTIMATEDMANHOURS ON FIWP_ESTIMATEDMANHOURS.OBJOBID = FIWP.FIWPOBID AND FIWP_ESTIMATEDMANHOURS.PROPERTYDEFUID = 'FIWP_Estimated_Manhours'  AND FIWP_ESTIMATEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_SCOPE ON FIWP_SCOPE.OBJOBID = FIWP.FIWPOBID AND FIWP_SCOPE.PROPERTYDEFUID = 'FIWP_Scope' AND FIWP_SCOPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_NOTES ON FIWP_NOTES.OBJOBID = FIWP.FIWPOBID AND FIWP_NOTES.PROPERTYDEFUID like 'FIWP_Notes' AND FIWP_NOTES.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)),#(lf)  #(lf)SPCRPT_FIWP_DIR_ENUM_PROP_TMP as ( #(lf)  SELECT #(lf)            FIWP.FIWPOBID AS ""FIWPOBID"",#(lf)            FIWP_PURPOSE.OBJNAME AS ""PURPOSE"",#(lf)            FIWP_DISCIPLINE.OBJNAME AS ""DISCIPLINE"",#(lf)            FIWP_STATUS.OBJNAME AS ""STATUS"" #(lf)      #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PURPOSE_PR ON FIWP_PURPOSE_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_PURPOSE_PR.PROPERTYDEFUID = 'FIWP_Purpose' AND FIWP_PURPOSE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_PURPOSE ON FIWP_PURPOSE.OBJUID = FIWP_PURPOSE_PR.STRVALUE AND FIWP_PURPOSE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DISCIPLINE_PR ON FIWP_DISCIPLINE_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_DISCIPLINE_PR.PROPERTYDEFUID = 'FIWP_Discipline' AND FIWP_DISCIPLINE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_DISCIPLINE ON FIWP_DISCIPLINE.OBJUID = FIWP_DISCIPLINE_PR.STRVALUE AND FIWP_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_STATUS_PR ON FIWP_STATUS_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_STATUS_PR.PROPERTYDEFUID = 'Package_Status' AND FIWP_STATUS_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_STATUS ON FIWP_STATUS.OBJUID = FIWP_STATUS_PR.STRVALUE AND FIWP_STATUS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)),#(lf)#(lf)SPCRPT_FIWP_REL_PROP_TMP as (#(lf)  SELECT#(lf)            FIWP.FIWPOBID AS ""FIWPOBID"",#(lf)            CAST(FIWP_PLANNEDMANHOURS.STRVALUE AS FLOAT) AS ""PLANNEDMANHOURS"",#(lf)            CAST(FIWP_ACTUALMANHOURS.STRVALUE AS FLOAT) AS ""ACTUALMANHOURS"",#(lf)            CAST(FIWP_COMPLETEDMANHOURS.STRVALUE AS FLOAT) AS ""COMPLETEDMANHOURS"",#(lf)            --CAST(FIWP_COMPONENTTOTALCONSTRAINTS.STRVALUE AS INT) AS ""TOTALCOMPONENTCONSTRAINTS"",#(lf)            --CAST(FIWP_COMPONENTOPENCONSTRAINTS.STRVALUE AS INT) AS ""OPENCOMPONENTCONSTRAINTS"",#(lf)            FIWP_CONTRACT.STRVALUE AS ""CONTRACT"",#(lf)            FIWP_CONTRACTOR.STRVALUE AS ""CONTRACTOR"",#(lf)            FIWP_DESIGNAREA.STRVALUE AS ""DESIGNAREA"",#(lf)#(lf)            --FIWP_NAMEDCREW.OBID AS ""CREWOBID"",#(lf)        #(tab)FIWP_CWP.OBID AS ""CWPOBID""#(lf)    #(lf)#(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)#(tab)LEFT JOIN DATAREL FIWP_PACKAGEROLLUPDATE_REL ON FIWP_PACKAGEROLLUPDATE_REL.UID1 = FIWP.FIWPUID AND FIWP_PACKAGEROLLUPDATE_REL.DEFUID = 'SPC_Package_PackageRollupData' AND FIWP_PACKAGEROLLUPDATE_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_PACKAGEROLLUPDATE ON FIWP_PACKAGEROLLUPDATE.OBJUID = FIWP_PACKAGEROLLUPDATE_REL.UID2 AND FIWP_PACKAGEROLLUPDATE.CONFIG = FIWP.PROJECT AND FIWP_PACKAGEROLLUPDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)    LEFT JOIN DATAOBJPR FIWP_PLANNEDMANHOURS ON FIWP_PLANNEDMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_PLANNEDMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalManHours' AND FIWP_PLANNEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALMANHOURS ON FIWP_ACTUALMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_ACTUALMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalActualManHours' AND FIWP_ACTUALMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_COMPLETEDMANHOURS ON FIWP_COMPLETEDMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPLETEDMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalManHoursCompleted' AND FIWP_COMPLETEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)--LEFT JOIN DATAOBJPR FIWP_COMPONENTTOTALCONSTRAINTS ON FIWP_COMPONENTTOTALCONSTRAINTS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPONENTTOTALCONSTRAINTS.PROPERTYDEFUID = 'PackageRollupData_TotalConstraints' AND FIWP_COMPONENTTOTALCONSTRAINTS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)--LEFT JOIN DATAOBJPR FIWP_COMPONENTOPENCONSTRAINTS ON FIWP_COMPONENTOPENCONSTRAINTS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPONENTOPENCONSTRAINTS.PROPERTYDEFUID = 'PackageRollupData_OpenConstraints' AND FIWP_COMPONENTOPENCONSTRAINTS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_CONTRACT_REL ON FIWP_CONTRACT_REL.UID1 = FIWP.FIWPUID AND FIWP_CONTRACT_REL.DEFUID = 'SPC_Package_Contract' AND FIWP_CONTRACT_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CONTRACT_OBJ ON FIWP_CONTRACT_OBJ.OBJUID = FIWP_CONTRACT_REL.UID2 AND FIWP_CONTRACT_OBJ.CONFIG = FIWP.PROJECT AND FIWP_CONTRACT_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CONTRACT ON FIWP_CONTRACT.OBJOBID = FIWP_CONTRACT_OBJ.OBID AND FIWP_CONTRACT.PROPERTYDEFUID = 'Description' AND FIWP_CONTRACT.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_CONTRACTOR_REL ON FIWP_CONTRACTOR_REL.UID1 = FIWP.FIWPUID AND FIWP_CONTRACTOR_REL.DEFUID = 'SPC_Package_Contractor' AND FIWP_CONTRACTOR_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CONTRACTOR_OBJ ON FIWP_CONTRACTOR_OBJ.OBJUID = FIWP_CONTRACTOR_REL.UID2 AND FIWP_CONTRACTOR_OBJ.CONFIG = FIWP.PROJECT AND FIWP_CONTRACTOR_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CONTRACTOR ON FIWP_CONTRACTOR.OBJOBID = FIWP_CONTRACTOR_OBJ.OBID AND FIWP_CONTRACTOR.PROPERTYDEFUID = 'Name' AND FIWP_CONTRACTOR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_DESIGNAREA_REL ON FIWP_DESIGNAREA_REL.UID2 = FIWP.FIWPUID AND FIWP_DESIGNAREA_REL.DEFUID = 'SPC_FunctionalArea_FIWPs' AND FIWP_DESIGNAREA_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_DESIGNAREA_OBJ ON FIWP_DESIGNAREA_OBJ.OBJUID = FIWP_DESIGNAREA_REL.UID1 AND FIWP_DESIGNAREA_OBJ.CONFIG = FIWP.PROJECT AND FIWP_DESIGNAREA_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DESIGNAREA ON FIWP_DESIGNAREA.OBJOBID = FIWP_DESIGNAREA_OBJ.OBID AND FIWP_DESIGNAREA.PROPERTYDEFUID = 'Name' AND FIWP_DESIGNAREA.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)--LEFT JOIN DATAREL FIWP_NAMEDCREW_REL ON FIWP_NAMEDCREW_REL.UID1 = FIWP.FIWPUID AND FIWP_NAMEDCREW_REL.DEFUID = 'SPC_Package_Crew' AND FIWP_NAMEDCREW_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)--LEFT JOIN DATAOBJ FIWP_NAMEDCREW ON FIWP_NAMEDCREW.OBJUID = FIWP_NAMEDCREW_REL.UID2 AND FIWP_NAMEDCREW.CONFIG = FIWP.PROJECT AND FIWP_NAMEDCREW.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_CWP_REL ON FIWP_CWP_REL.UID2 = FIWP.FIWPUID AND FIWP_CWP_REL.DEFUID = 'SPC_CWP_FIWPs' AND FIWP_CWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CWP ON FIWP_CWP.OBJUID = FIWP_CWP_REL.UID1 AND FIWP_CWP.CONFIG = FIWP.PROJECT AND FIWP_CWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)#(lf)DETAIL_DS AS (#(lf) #(lf)  SELECT NULLIF(PURPOSE,'NA') as ""PURPOSE"",    #(lf)    RG.""DECKNAME"",#(lf)    RG.""TAGID"",#(lf)    RG.""SERVICE"",#(lf)    RG.""CABLEPOWER"",#(lf)    RG.""Volt_AC_DC"",#(lf)    RG.""FromEquipment"",#(lf)    RG.""ToEquipment"",#(lf)    RG.""FromTag"",#(lf)    RG.""FromDescription"",#(lf)    RG.""ToTag"",#(lf)#(tab)RG.""FromEqpStatus"",#(lf)#(tab)RG.""ToEqpStatus"",#(lf)    RG.""ToDescription"" AS ""TODESCRIPTION"",#(lf)    RG.""CoreNo"",#(lf)    RG.""CoreSize"",#(lf)    RG.""CableVoltage"",#(lf)#(tab)RG.""From_RoomNo"",#(lf)#(tab)RG.""To_RoomNo"",#(tab)#(lf)    RG.""UNITS"",#(lf)    RG.""SCOPE"",#(lf)    RG.""FROMDECKLEVEL"",#(lf)    RG.""TODECKLEVEL"",#(lf)    RG.""FromGlandScope"",#(lf)    RG.""ToGlandScope"",#(lf)    RG.""CableDrumNo"",#(lf)#(tab)RG.""ActualDrumNo"",#(lf)    RG.""RevHistory"",#(lf)    RG.""CableSpecification"",#(tab)#(lf)    RG.""Remarks"",#(lf)    RG.""Remarks1"",#(lf)    RG.""LocationDescription"",#(lf)    RG.""CableAssociatedTo"",#(lf)    RG.""CommodityCode"",#(lf)    RG.""PartNumber"",#(lf)    RG.""ClassDesignation"",#(lf)    RG.""CREATED_BY"", #(lf)    RG.""CREATED_DATE"",#(lf)            #(lf)    case when STEPNAME='Pull' then ACTUALDRUMNO  else null end  AS ""ACTUAL DRUM NO"",#(lf)    case when STEPNAME='Pull' then ACTUALQUANTITY  else null end AS ""ACTUALLENGTH"",#(lf)#(tab)case when STEPNAME='Pull' then QUANTITYCOMPLETE  else null end AS ""LENGTHQTYCOMPLETE"",#(lf)    #(lf)    CASE WHEN STEPNAME='Pull' THEN t2.NAME ELSE '' END AS ""PULLING IWP NO"",#(lf)    CASE WHEN STEPNAME='Pull' THEN t5.COSTCODE  ELSE '' END AS ""PULLING COST CODE"",#(lf)    CASE WHEN STEPNAME='Pull' THEN CAST(T5.PLANNEDMANHOURS as DEC(9,2))  ELSE 0 END AS ""PULLING MANHOURS"",#(lf)    CASE WHEN STEPNAME='Pull' THEN T5.ACTUALMANHOURS   ELSE 0 END AS ""PULLING ACTUAL"",#(lf)#(tab)CASE WHEN STEPNAME='Pull' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""PULLING ACTUAL DATE"",#(lf)#(tab)#(lf)#(tab)CASE WHEN STEPNAME='Pull' THEN T5.ACTUALDRUMNO_WS   ELSE '' END AS ""PULLING ACTUALDRUMNO_WS"",#(lf)    #(lf)    #(lf)    #(lf)    CASE WHEN STEPNAME='Dress' THEN t2.NAME ELSE '' END AS ""Dressing IWP No"",#(lf)    CASE WHEN STEPNAME='Dress' THEN t5.COSTCODE ELSE '' END AS ""Dressing Cost Code"",#(lf)    CASE WHEN STEPNAME='Dress' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2)) ELSE 0 END AS DressingManhours,#(lf)    CASE WHEN STEPNAME='Dress' THEN T5.ACTUALMANHOURS   ELSE 0 END AS ""Dressing ACTUAL"",#(lf)#(tab)CASE WHEN STEPNAME='Dress' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Dressing ACTUAL DATE"",#(lf)#(tab)CASE WHEN STEPNAME='Dress' THEN T5.ACTUALDRUMNO_WS   ELSE '' END AS ""Dressing ACTUALDRUMNO_WS"",#(lf)    #(lf)    CASE WHEN PURPOSE='Glanding From' THEN t2.NAME ELSE '' END AS ""GLANDING FROM IWP NO"",#(lf)    CASE WHEN PURPOSE='Glanding From' THEN t5.COSTCODE ELSE '' END AS ""Glanding From Cost Code"",#(lf)#(lf)    CASE WHEN STEPNAME='Glanding From' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2)) ELSE 0 END AS ""Glanding From Manhours"",#(lf)    CASE WHEN STEPNAME='Glanding From' THEN T5.ACTUALMANHOURS ELSE 0 END AS ""Glanding From Actual"",#(lf)#(tab)CASE WHEN STEPNAME='Glanding From' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Glanding From ACTUAL DATE"",#(lf)#(tab)#(lf)    CASE WHEN PURPOSE='Glanding To' THEN t2.NAME ELSE '' END AS ""GLANDING TO IWP NO"",#(lf)    CASE WHEN PURPOSE='Glanding To' THEN t5.COSTCODE ELSE '' END AS ""Glanding To Cost Code"",#(lf)#(tab)#(lf)    CASE WHEN STEPNAME='Glanding To' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2)) ELSE 0 END AS ""Glanding To Manhours"",#(lf)    CASE WHEN STEPNAME='Glanding To' THEN T5.ACTUALMANHOURS ELSE 0 END AS ""Glanding To Actual"",#(lf)#(tab)CASE WHEN STEPNAME='Glanding To' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Glanding To ACTUAL DATE"",#(lf)    #(lf)    CASE WHEN PURPOSE='Termination From' THEN t2.NAME ELSE '' END AS ""Termination From IWP No"",#(lf)    CASE WHEN PURPOSE='Termination From' THEN t5.COSTCODE ELSE '' END AS ""Termination From Cost Code"",#(lf)    #(lf)#(lf)    CASE WHEN STEPNAME='Termination From' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2))  ELSE 0 END AS ""Termination From Manhours"",#(lf)    CASE WHEN STEPNAME='Termination From' THEN T5.ACTUALMANHOURS ELSE 0 END AS ""Termination From Actual"",#(lf)#(tab)CASE WHEN STEPNAME='Termination From' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Termination From ACTUAL DATE"",#(lf)#(tab)#(lf)    CASE WHEN PURPOSE='Termination To' THEN t2.NAME ELSE '' END AS ""Termination To IWP No"",#(lf)    CASE WHEN PURPOSE='Termination To' THEN t5.COSTCODE ELSE '' END AS ""Termination To Cost Code"",#(lf)#(tab)#(lf)    CASE WHEN STEPNAME='Termination To' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2)) ELSE 0 END AS ""Termination To Manhours"",   #(lf)    CASE WHEN STEPNAME='Termination To' THEN T5.ACTUALMANHOURS ELSE 0 END AS ""Termination To Actual"",#(lf)#(tab)CASE WHEN STEPNAME='Termination To' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Termination To ACTUAL DATE"",    #(lf)     #(lf)    CASE WHEN PURPOSE='Testing' THEN t2.NAME ELSE '' END AS ""Testing IWP No"",#(lf)    CASE WHEN PURPOSE='Testing' THEN t5.COSTCODE ELSE '' END AS ""Testing Cost Code"",#(lf)#(lf)    CASE WHEN STEPNAME='Test' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2)) ELSE 0 END AS ""Testing Manhours"",    #(lf)    CASE WHEN STEPNAME='Test' THEN T5.ACTUALMANHOURS ELSE 0 END AS ""Testing Actual"",    #(lf)#(tab)#(lf)#(tab)CASE WHEN STEPNAME='Test' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Testing ACTUAL DATE"",  #(lf)#(tab)#(lf)    CASE WHEN STEPNAME='Accep' THEN CAST(NVL(T5.PLANNEDMANHOURS,0) as DEC(9,2))  ELSE 0 END AS ""Accep Manhours"",   #(lf)    CASE WHEN STEPNAME='Accep' THEN T5.ACTUALMANHOURS ELSE 0 END AS ""Accep Actual"",#(lf)#(tab)#(tab)CASE WHEN STEPNAME='Accep' THEN T5.ACTUALDATECOMPLETE ELSE '' END AS ""Accep ACTUAL DATE"",  #(lf)    #(lf)    CREATIONUSER AS ""Last Progress User"", #(lf)    CASE WHEN PROGRESSCOMPLETE = 1  THEN CREATIONDATE ELSE '' END AS PROGRESSEDDATE,#(lf)    STEPNAME, PROGRESSCOMPLETE, RG.SYSTEM, RG.SUBSYSTEM, #(lf)    FROM_CORRECTEDTAG,  FROM_GROUPCATEGORYL2, FROM_GROUPDESCL4, FROM_LOCATION, FROM_GLANDCOUNT, FROM_EQPTIDENTCODE, FROM_EQPTPOREF,#(lf)    TO_CORRECTEDTAG, TO_GROUPCATEGORYL3, TO_GROUPDESCL4, TO_TOLOCATION, TO_GLANDCOUNT, TO_EQPTIDENTCODE, TO_EQPTPOREF,#(lf)#(lf)    FROM_TERMINATIONCOUNT, TYPE, STAGE, TO_TERMINATIONCOUNT,TESTINGCOUNT#(lf)     #(lf)    #(lf)    #(lf)    #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_FIWP_DIRECT_PROP_TMP t2 ON t2.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_FIWP_DIR_ENUM_PROP_TMP t3 ON t3.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_FIWP_REL_PROP_TMP t4 ON t4.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN WORKSTEPS t5 ON t5.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_COMPONENTITEM1 t6 ON t6.COMPOBID = t5.COMPOBID#(lf)FULL OUTER JOIN SPCRPT_REG_DIRECT_PROP_TMP RG ON RG.TAGID = T6.NAME#(lf)--WHERE RG.""ClassDesignation""='Non_Published_CableSchedule'#(lf)--WHERE  PURPOSE in('NA', 'Cable Pull','Glanding','Termination','Testing') --and NULLIF(stepname,'') in('', 'Glanding From','Glanding To','Termination From','Termination To','Pull','Dress','Test', 'Accep')#(lf) #(lf)),#(lf)#(lf)#(lf)#(lf)#(lf)PROGRESS_TABLE as#(lf)(#(lf)  SELECT cTAGID, #(lf)   MAX(DressProgressDate) as DressProgressDate, #(lf)   MAX(TestProgressDate) as TestProgressDate, #(lf)   MAX(PullProgressDate) as PullProgressDate, #(lf)   MAX(GlandFromProgressDate) as GlandFromProgressDate, #(lf)   MAX(GlandToProgressDate) as GlandToProgressDate, #(lf)   MAX(TerminateFromProgressDate) as TerminateFromProgressDate, #(lf)   MAX(TerminateToProgressDate) as TerminateToProgressDate#(lf)   FROM#(lf)   (#(lf)    SELECT TAGID as cTAGID,        #(lf)    CASE WHEN STEPNAME ='Dress' THEN PROGRESSEDDATE END as DressProgressDate,#(lf)    CASE WHEN STEPNAME ='Test' THEN PROGRESSEDDATE END as TestProgressDate,#(lf)    CASE WHEN STEPNAME ='Pull' THEN PROGRESSEDDATE END as PullProgressDate,#(lf)    CASE WHEN STEPNAME ='Glanding From'  THEN PROGRESSEDDATE END as GlandFromProgressDate,#(lf)    CASE WHEN STEPNAME ='Glanding To' THEN PROGRESSEDDATE END as GlandToProgressDate,#(lf)    CASE WHEN STEPNAME ='Termination From' THEN PROGRESSEDDATE END as TerminateFromProgressDate,#(lf)    CASE WHEN STEPNAME ='Termination To' THEN PROGRESSEDDATE END as TerminateToProgressDate#(lf)     FROM DETAIL_DS  #(lf)   )xx GROUP BY XX.cTAGID#(lf)  #(lf))#(lf) #(lf) --sel