	partition 'Cable Grounding' = m
		mode: import
		source =
				let
				    Source = Oracle.Database("SPFC5DUP.world", [HierarchicalNavigation=true, Query="WITH SPCRPT_WORKSTEP_IOBJ_PROP_TMP as #(lf)(#(lf)  #(lf)SELECT#(lf)            COMPWORKSTEP.OBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP.OBJUID AS ""COMPWORKSTEPUID"",#(tab)  #(lf)            COMPWORKSTEP.CONFIG AS ""PROJECT"",#(lf)            COMPWORKSTEP.LASTUPDATED AS ""LASTUPDATED"",#(lf)            COMPWORKSTEP.CREATIONUSER AS ""LASTUPDATEDBY""#(lf)FROM DATAOBJ COMPWORKSTEP WHERE COMPWORKSTEP.OBJDEFUID = 'SPC_ComponentWorkTypeStep' AND COMPWORKSTEP.TERMINATIONDATE = '9999/12/31-23:59:59:999'),#(lf)#(lf)SPCRPT_WORKSTEP_DIR_PROP_TMP as #(lf)(#(tab)#(lf)SELECT#(lf)            COMPWORKSTEP.COMPWORKSTEPOBID AS ""COMPWORKSTEPOBID"",#(lf)            CASE WHEN COMPWORKSTEP_QUANTITYCOMPLETE.STRVALUE>0 then  COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONDATE ELSE COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONDATE  END as ""LASTUPDATED"",#(lf)            COMPWORKSTEP_NAME.STRVALUE AS ""NAME"", #(lf)            COMPWORKSTEP_DESCRIPTION.STRVALUE AS ""DESCRIPTION"",#(lf)            CAST(COMPWORKSTEP_SEQUENCE.STRVALUE AS INT) AS ""SEQUENCE"",#(lf)            CAST(COMPWORKSTEP_PLANNEDMANHOURS.STRVALUE AS FLOAT) AS ""PLANNEDMANHOURS"",#(lf)            CAST(COMPWORKSTEP_ACTUALMANHOURS.STRVALUE AS FLOAT) AS ""ACTUALMANHOURS"",#(lf)            COMPWORKSTEP_DATECOMPLETE.STRVALUE AS ""ACTUALDATECOMPLETE"",#(lf)            CAST(COMPWORKSTEP_QUANTITYCOMPLETE.STRVALUE AS FLOAT) AS ""QUANTITYCOMPLETE"",#(lf)            CASE WHEN COMPWORKSTEP_QUANTITYCOMPLETE.STRVALUE>0 then  COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONUSER ELSE COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONUSER  END as  ""LASTUPDATEDBY""#(lf)          #(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP COMPWORKSTEP#(lf)#(tab)#(lf)#(tab)--Name#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_NAME ON COMPWORKSTEP_NAME.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_NAME.PROPERTYDEFUID = 'Name' AND COMPWORKSTEP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--Description#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_DESCRIPTION ON COMPWORKSTEP_DESCRIPTION.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_DESCRIPTION.PROPERTYDEFUID = 'Description' AND COMPWORKSTEP_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--Sequence#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_SEQUENCE ON COMPWORKSTEP_SEQUENCE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_SEQUENCE.PROPERTYDEFUID = 'ComponentWorkTypeStep_Sequence' AND COMPWORKSTEP_SEQUENCE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--PlannedManHours#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_PLANNEDMANHOURS ON COMPWORKSTEP_PLANNEDMANHOURS.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_PLANNEDMANHOURS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ManHours' AND COMPWORKSTEP_PLANNEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--ActualManHours#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_ACTUALMANHOURS ON COMPWORKSTEP_ACTUALMANHOURS.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_ACTUALMANHOURS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualHours' AND COMPWORKSTEP_ACTUALMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  LEFT JOIN DATAOBJPR COMPWORKSTEP_DATECOMPLETE ON COMPWORKSTEP_DATECOMPLETE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_DATECOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualDateComplete' AND COMPWORKSTEP_DATECOMPLETE.CREATIONUSER<>'superuser' AND COMPWORKSTEP_DATECOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_QUANTITYCOMPLETE ON COMPWORKSTEP_QUANTITYCOMPLETE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_QUANTITYCOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_QuantityComplete' AND COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONUSER<>'superuser' AND  COMPWORKSTEP_QUANTITYCOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)#(lf)SPCRPT_WORKSTEP_REL_PROP_TMP as #(lf)(#(tab)#(lf)#(tab)#(lf)SELECT#(lf)            COMPWORKSTEP.COMPWORKSTEPOBID AS ""COMPWORKSTEPOBID"",            #(lf)            COMPWORKSTEP_WORKTYPE_COSTCODE.STRVALUE AS ""COSTCODE"",#(lf)            COMPWORKSTEP_FIWP.OBID AS ""FIWPOBID"",#(tab)  #(lf)            COMPWORKSTEP_WORKTYPE.OBID AS ""WORKTYPEOBID"",#(lf)            COMPWORKSTEP_COMP.OBID AS ""COMPOBID"",#(lf)            CAST(COMPONENTITEM_QUANTITYPLANNED.STRVALUE AS FLOAT) AS ""QUANTITYPLANNED"",#(lf)            FIWP_PURPOSE.OBJNAME AS ""PURPOSE""#(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP COMPWORKSTEP#(lf)#(tab)#(lf)#(tab)--IWP#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_FIWP_REL ON COMPWORKSTEP_FIWP_REL.UID2 = COMPWORKSTEP.COMPWORKSTEPUID  AND COMPWORKSTEP_FIWP_REL.DEFUID = 'SPC_Package_ComponentWorkTypeStep' AND COMPWORKSTEP_FIWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_FIWP ON COMPWORKSTEP_FIWP.OBJUID = COMPWORKSTEP_FIWP_REL.UID1 AND COMPWORKSTEP_FIWP.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_FIWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--WorkType#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_WORKTYPE_REL ON COMPWORKSTEP_WORKTYPE_REL.UID2 = COMPWORKSTEP.COMPWORKSTEPUID AND COMPWORKSTEP_WORKTYPE_REL.DEFUID = 'SPC_ComponentWorkType_ComponentWorkTypeSteps' AND COMPWORKSTEP_WORKTYPE_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_WORKTYPE ON COMPWORKSTEP_WORKTYPE.OBJUID = COMPWORKSTEP_WORKTYPE_REL.UID1 AND COMPWORKSTEP_WORKTYPE.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_WORKTYPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)--Cost Code#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_WORKTYPE_COSTCODE ON COMPWORKSTEP_WORKTYPE_COSTCODE.OBJOBID = COMPWORKSTEP_WORKTYPE.OBID AND COMPWORKSTEP_WORKTYPE_COSTCODE.PROPERTYDEFUID = 'ComponentWorkType_CostCode' AND COMPWORKSTEP_WORKTYPE_COSTCODE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--Component#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_COMP_REL ON COMPWORKSTEP_COMP_REL.UID2 = COMPWORKSTEP_WORKTYPE.OBJUID AND COMPWORKSTEP_COMP_REL.DEFUID = 'SPC_ComponentItem_ComponentWorkType' AND COMPWORKSTEP_COMP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_COMP ON COMPWORKSTEP_COMP.OBJUID = COMPWORKSTEP_COMP_REL.UID1 AND COMPWORKSTEP_COMP.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_COMP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--Quantity Planned#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_QUANTITYPLANNED ON COMPONENTITEM_QUANTITYPLANNED.OBJOBID = COMPWORKSTEP_COMP.OBID AND COMPONENTITEM_QUANTITYPLANNED.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_QUANTITYPLANNED.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  LEFT JOIN DATAOBJPR FIWP_PURPOSE_PR ON FIWP_PURPOSE_PR.OBJOBID = COMPWORKSTEP_FIWP.OBID AND FIWP_PURPOSE_PR.PROPERTYDEFUID = 'FIWP_Purpose' AND FIWP_PURPOSE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_PURPOSE ON FIWP_PURPOSE.OBJUID = FIWP_PURPOSE_PR.STRVALUE AND FIWP_PURPOSE.TERMINATIONDATE = '9999/12/31-23:59:59:999'),#(lf)#(tab)#(lf)SPCRPT_COMPONENTWORKSTEP  as#(lf)(   #(lf)  SELECT#(lf)  -- Section #5a: IObject properties#(lf)        t1.COMPWORKSTEPOBID, COMPWORKSTEPUID, PROJECT, NAME as ""EVENTS"", SEQUENCE,  --DESCRIPTION, UNITRATE, RATEUOM, NOTES, #(lf)        PLANNEDMANHOURS, ACTUALMANHOURS, ACTUALDATECOMPLETE, QUANTITYCOMPLETE, -- sample: Prop2Column,#(lf)            COSTCODE, FIWPOBID, WORKTYPEOBID, COMPOBID, QUANTITYPLANNED , t2.LASTUPDATED, t2.DESCRIPTION, t3.PURPOSE, t2.LASTUPDATEDBY -- sample: ,Prop3Column#(tab)  #(lf)  FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP t1#(lf)  LEFT JOIN SPCRPT_WORKSTEP_DIR_PROP_TMP t2 ON t2.COMPWORKSTEPOBID = t1.COMPWORKSTEPOBID#(lf)  LEFT JOIN SPCRPT_WORKSTEP_REL_PROP_TMP t3 ON t3.COMPWORKSTEPOBID = t1.COMPWORKSTEPOBID#(lf)),#(lf)#(lf)DETAILBYTAG as#(lf)(#(lf)SELECT #(lf)            COMPONENTITEM.COMPWORKSTEPOBID,#(lf)            COMPONENTITEM.COMPOBID AS ""COMPOBID"",#(lf)            COMPONENTITEM.FIWPOBID,#(lf)            COMPONENTITEM.DESCRIPTION,#(lf)            COMPONENTITEM.PROJECT, COMPONENTITEM.PURPOSE,#(lf)            COMPONENTITEM_NAME.STRVALUE AS ""NAME"",#(lf)            COMPONENTITEM.QUANTITYCOMPLETE,#(lf)            #(lf)            COMPONENTITEM.SEQUENCE,            #(lf)           CAST(COMPONENTITEM.PLANNEDMANHOURS AS FLOAT) AS ""FABHRS"",#(lf)          CAST(COMPONENTITEM.ACTUALMANHOURS AS FLOAT) AS ""ACTUALHRS"", #(lf)          CASE WHEN COMPONENTITEM.PLANNEDMANHOURS>0 THEN COMPONENTITEM.ACTUALMANHOURS / COMPONENTITEM.PLANNEDMANHOURS ELSE 0 END as ""PROGRESS"",#(lf)          FIWP_NAME.STRVALUE AS ""WPNO"",#(lf)          FIWP_DISCIPLINE.OBJNAME AS ""DISCIPLINE"",#(lf)          SUBSTR(COMPONENTITEM.ACTUALDATECOMPLETE, 1,10)  as ""DATEPROGRESS"",#(lf)#(tab)  SUBSTR(COMPONENTITEM.LASTUPDATED, 1,10)  as ""DATEPROGRESS1"",#(lf)          COMPONENTITEM.LASTUPDATEDBY,#(lf)          SHORTDESC.STRVALUE AS ""SHORTDESC"",#(lf)#(tab)  UNITS.STRVALUE AS ""UNITS"",#(lf)    ClassDesignation.STRVALUE As ""CLASSDESIG"",#(lf)    COMPONENTITEM_LOCATION.Strvalue as ""COMPLOCATION"",#(lf)    COMPONENTITEM_TYPE.STRVALUE AS ""COMPTYPE""#(lf)#(lf)  FROM SPCRPT_COMPONENTWORKSTEP COMPONENTITEM#(lf)#(tab)--Name#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_NAME ON COMPONENTITEM_NAME.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_NAME.PROPERTYDEFUID = 'Name' AND COMPONENTITEM_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--Description#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DESCRIPTION ON COMPONENTITEM_DESCRIPTION.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DESCRIPTION.PROPERTYDEFUID = 'SPC_ComponentItem_ShortDescription' AND COMPONENTITEM_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  #(tab)--Short Description #(lf)  LEFT JOIN DATAOBJPR SHORTDESC ON SHORTDESC.OBJOBID = COMPONENTITEM.COMPOBID AND SHORTDESC.PROPERTYDEFUID = 'SPC_ComponentItem_ShortDescription' AND SHORTDESC.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--Units#(lf)  LEFT JOIN DATAOBJPR UNITS ON UNITS.OBJOBID = COMPONENTITEM.COMPOBID AND UNITS.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND UNITS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--Class#(lf) LEFT JOIN DATAOBJPR ClassDesignation ON ClassDesignation.OBJOBID = COMPONENTITEM.COMPOBID AND ClassDesignation.PROPERTYDEFUID = 'SpcNonPublishedClassDesignation' AND  ClassDesignation.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  --LEFT JOIN DATAOBJPR FABHRS ON FABHRS.OBJOBID = COMPONENTITEM.COMPOBID AND FABHRS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ManHours' AND FABHRS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  LEFT JOIN DATAOBJPR FIWP_NAME ON FIWP_NAME.OBJOBID = COMPONENTITEM.FIWPOBID AND FIWP_NAME.PROPERTYDEFUID = 'Name' AND FIWP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  --LEFT JOIN DATAOBJPR COMPWORKSTEP_DATECOMPLETE ON COMPWORKSTEP_DATECOMPLETE.OBJOBID = COMPONENTITEM.COMPWORKSTEPOBID AND COMPWORKSTEP_DATECOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualDateComplete'-- AND COMPWORKSTEP_DATECOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  #(tab)--IWP DISCIPLINE#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DISCIPLINE_PR ON FIWP_DISCIPLINE_PR.OBJOBID = COMPONENTITEM.FIWPOBID AND FIWP_DISCIPLINE_PR.PROPERTYDEFUID = 'FIWP_Discipline' AND FIWP_DISCIPLINE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_DISCIPLINE ON FIWP_DISCIPLINE.OBJUID = FIWP_DISCIPLINE_PR.STRVALUE AND FIWP_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  --Location#(lf)  LEFT JOIN DATAOBJPR COMPONENTITEM_LOCATION ON COMPONENTITEM_LOCATION.OBJOBID = COMPONENTITEM.COMPOBID AND #(lf)  COMPONENTITEM_LOCATION.PROPERTYDEFUID = 'SPC_ComponentItem_LocationDescription' AND COMPONENTITEM_LOCATION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  --Type#(lf)   LEFT JOIN DATAOBJPR COMPONENTITEM_TYPE ON COMPONENTITEM_TYPE.OBJOBID = COMPONENTITEM.COMPOBID AND #(lf)  COMPONENTITEM_TYPE.PROPERTYDEFUID = 'SPC_ComponentItem_Type' AND COMPONENTITEM_TYPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  WHERE FIWP_DISCIPLINE.OBJNAME IN('Electrical')#(lf)#(lf)),#(lf)#(lf)DUMP AS#(lf)( #(lf)    SELECT ax.COMPWORKSTEPOBID, ax.FIWPOBID,#(lf)    ax.Project, #(lf)    ax.Name,    #(lf)    ax.PURPOSE,#(lf)    ax.DISCIPLINE,#(lf)    ax.WPNO, ax.SEQUENCE,ax.ACTUALHRS , ax.QUANTITYCOMPLETE,    #(lf)#(lf)    CASE WHEN ax.PURPOSE in('Installation')  AND ax.Discipline='Electrical' then ax.WPNO else null end as InstallationWPNo,#(lf)    CASE WHEN ax.PURPOSE in('Installation')  AND ax.Discipline='Electrical' then ax.FABHRS else null end as InstallationPlanHrs,#(lf)    CASE WHEN ax.PURPOSE in('Installation')  AND ax.Discipline='Electrical' then ax.ACTUALHRS else null end as InstallationEarnedHrs,#(lf)    #(lf)    CASE WHEN ax.SEQUENCE = 1 AND ax.PURPOSE in('Installation') AND ax.Discipline='Electrical' And ax.FABHRS = ax.ACTUALHRS then ax.DATEPROGRESS1 ELSE null END as General,#(lf)    #(lf)    CASE WHEN ax.SEQUENCE = 1 AND ax.PURPOSE in('Installation') AND ax.Discipline='Electrical' And ax.FABHRS > 0 then Round((ax.ACTUALHRS/ax.FABHRS)*100,2) ELSE null END as Generalprg,#(lf)#(lf)    CASE WHEN ax.Discipline in ('Electrical') then ax.DATEPROGRESS else null end as LASTPROGRESSDATE, ax.LASTUPDATEDBY,#(lf)    ax.SHORTDESC,ax.UNITS,ax.CLASSDESIG,ax.CompLocation,ax.CompType#(lf)    #(lf) #(lf)    FROM DETAILBYTAG ax     #(lf)     order by WPNO, SEQUENCE#(lf)),#(lf)#(lf)FINAL as (#(lf) #(lf)SELECT #(lf) #(lf)    ax.Project as ""PLANT NAME"", #(lf)    ax.Name as ""TAG"", #(lf)    #(lf)  MAX(ax.InstallationWPNo) as InstallationWPNo,#(lf)  SUM(ax.InstallationPlanHrs) as InstallationPlanHrs,#(lf)  SUM(ax.InstallationEarnedHrs) as InstallationEarnedHrs,#(lf)#(lf)  MAX(ax.General) as General,#(lf)  MAX(ax.Generalprg) as GeneralPrg,#(lf)  ax.SHORTDESC,ax.UNITS,ax.CompLocation,ax.CompType,ax.QUANTITYCOMPLETE#(lf)#(lf)FROM DUMP ax#(lf)WHERE  ax.CLASSDESIG in('Non_Published_Grounding') And ax.DISCIPLINE = 'Electrical' And ax.PURPOSE IN('Fabrication', 'Installation')#(lf)GROUP BY      ax.Project,     ax.Name,ax.SHORTDESC,ax.UNITS,ax.CompLocation,ax.CompType,ax.QUANTITYCOMPLETE#(lf) )#(lf) #(lf) select * from FINAL #(lf) --where tag = 'DBD-EC07'#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

