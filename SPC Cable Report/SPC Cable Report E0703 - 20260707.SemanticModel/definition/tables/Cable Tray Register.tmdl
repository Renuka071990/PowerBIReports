     LEFT JOIN DATAOBJPR FIWP_PURPOSE_PR ON FIWP_PURPOSE_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_PURPOSE_PR.PROPERTYDEFUID = 'FIWP_Purpose' AND FIWP_PURPOSE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN SCHEMAOBJ FIWP_PURPOSE ON FIWP_PURPOSE.OBJUID = FIWP_PURPOSE_PR.STRVALUE AND FIWP_PURPOSE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_DISCIPLINE_PR ON FIWP_DISCIPLINE_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_DISCIPLINE_PR.PROPERTYDEFUID = 'FIWP_Discipline' AND FIWP_DISCIPLINE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN SCHEMAOBJ FIWP_DISCIPLINE ON FIWP_DISCIPLINE.OBJUID = FIWP_DISCIPLINE_PR.STRVALUE AND FIWP_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_STATUS_PR ON FIWP_STATUS_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_STATUS_PR.PROPERTYDEFUID = 'Package_Status' AND FIWP_STATUS_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN SCHEMAOBJ FIWP_STATUS ON FIWP_STATUS.OBJUID = FIWP_STATUS_PR.STRVALUE AND FIWP_STATUS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                ),#(lf)#(lf)SPCRPT_FIWP_REL_PROP_TMP as (#(lf)  SELECT#(lf)            FIWP.FIWPOBID AS ""FIWPOBID"",#(lf)            CAST(FIWP_PLANNEDMANHOURS.STRVALUE AS FLOAT) AS ""PLANNEDMANHOURS"",#(lf)            CAST(FIWP_ACTUALMANHOURS.STRVALUE AS FLOAT) AS ""ACTUALMANHOURS"",#(lf)            CAST(FIWP_COMPLETEDMANHOURS.STRVALUE AS FLOAT) AS ""COMPLETEDMANHOURS"",#(lf)            --CAST(FIWP_COMPONENTTOTALCONSTRAINTS.STRVALUE AS INT) AS ""TOTALCOMPONENTCONSTRAINTS"",#(lf)            --CAST(FIWP_COMPONENTOPENCONSTRAINTS.STRVALUE AS INT) AS ""OPENCOMPONENTCONSTRAINTS"",#(lf)            FIWP_CONTRACT.STRVALUE AS ""CONTRACT"",#(lf)            FIWP_CONTRACTOR.STRVALUE AS ""CONTRACTOR"",#(lf)            FIWP_DESIGNAREA.STRVALUE AS ""DESIGNAREA"",#(lf)#(lf)            --FIWP_NAMEDCREW.OBID AS ""CREWOBID"",#(lf)               FIWP_CWP.OBID AS ""CWPOBID""#(lf)#(lf)#(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)                LEFT JOIN DATAREL FIWP_PACKAGEROLLUPDATE_REL ON FIWP_PACKAGEROLLUPDATE_REL.UID1 = FIWP.FIWPUID AND FIWP_PACKAGEROLLUPDATE_REL.DEFUID = 'SPC_Package_PackageRollupData' AND FIWP_PACKAGEROLLUPDATE_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJ FIWP_PACKAGEROLLUPDATE ON FIWP_PACKAGEROLLUPDATE.OBJUID = FIWP_PACKAGEROLLUPDATE_REL.UID2 AND FIWP_PACKAGEROLLUPDATE.CONFIG = FIWP.PROJECT AND FIWP_PACKAGEROLLUPDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)    LEFT JOIN DATAOBJPR FIWP_PLANNEDMANHOURS ON FIWP_PLANNEDMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_PLANNEDMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalManHours' AND FIWP_PLANNEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_ACTUALMANHOURS ON FIWP_ACTUALMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_ACTUALMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalActualManHours' AND FIWP_ACTUALMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_COMPLETEDMANHOURS ON FIWP_COMPLETEDMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPLETEDMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalManHoursCompleted' AND FIWP_COMPLETEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                --LEFT JOIN DATAOBJPR FIWP_COMPONENTTOTALCONSTRAINTS ON FIWP_COMPONENTTOTALCONSTRAINTS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPONENTTOTALCONSTRAINTS.PROPERTYDEFUID = 'PackageRollupData_TotalConstraints' AND FIWP_COMPONENTTOTALCONSTRAINTS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                --LEFT JOIN DATAOBJPR FIWP_COMPONENTOPENCONSTRAINTS ON FIWP_COMPONENTOPENCONSTRAINTS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPONENTOPENCONSTRAINTS.PROPERTYDEFUID = 'PackageRollupData_OpenConstraints' AND FIWP_COMPONENTOPENCONSTRAINTS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAREL FIWP_CONTRACT_REL ON FIWP_CONTRACT_REL.UID1 = FIWP.FIWPUID AND FIWP_CONTRACT_REL.DEFUID = 'SPC_Package_Contract' AND FIWP_CONTRACT_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJ FIWP_CONTRACT_OBJ ON FIWP_CONTRACT_OBJ.OBJUID = FIWP_CONTRACT_REL.UID2 AND FIWP_CONTRACT_OBJ.CONFIG = FIWP.PROJECT AND FIWP_CONTRACT_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_CONTRACT ON FIWP_CONTRACT.OBJOBID = FIWP_CONTRACT_OBJ.OBID AND FIWP_CONTRACT.PROPERTYDEFUID = 'Description' AND FIWP_CONTRACT.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAREL FIWP_CONTRACTOR_REL ON FIWP_CONTRACTOR_REL.UID1 = FIWP.FIWPUID AND FIWP_CONTRACTOR_REL.DEFUID = 'SPC_Package_Contractor' AND FIWP_CONTRACTOR_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJ FIWP_CONTRACTOR_OBJ ON FIWP_CONTRACTOR_OBJ.OBJUID = FIWP_CONTRACTOR_REL.UID2 AND FIWP_CONTRACTOR_OBJ.CONFIG = FIWP.PROJECT AND FIWP_CONTRACTOR_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_CONTRACTOR ON FIWP_CONTRACTOR.OBJOBID = FIWP_CONTRACTOR_OBJ.OBID AND FIWP_CONTRACTOR.PROPERTYDEFUID = 'Name' AND FIWP_CONTRACTOR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAREL FIWP_DESIGNAREA_REL ON FIWP_DESIGNAREA_REL.UID2 = FIWP.FIWPUID AND FIWP_DESIGNAREA_REL.DEFUID = 'SPC_FunctionalArea_FIWPs' AND FIWP_DESIGNAREA_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJ FIWP_DESIGNAREA_OBJ ON FIWP_DESIGNAREA_OBJ.OBJUID = FIWP_DESIGNAREA_REL.UID1 AND FIWP_DESIGNAREA_OBJ.CONFIG = FIWP.PROJECT AND FIWP_DESIGNAREA_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJPR FIWP_DESIGNAREA ON FIWP_DESIGNAREA.OBJOBID = FIWP_DESIGNAREA_OBJ.OBID AND FIWP_DESIGNAREA.PROPERTYDEFUID = 'Name' AND FIWP_DESIGNAREA.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                --LEFT JOIN DATAREL FIWP_NAMEDCREW_REL ON FIWP_NAMEDCREW_REL.UID1 = FIWP.FIWPUID AND FIWP_NAMEDCREW_REL.DEFUID = 'SPC_Package_Crew' AND FIWP_NAMEDCREW_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                --LEFT JOIN DATAOBJ FIWP_NAMEDCREW ON FIWP_NAMEDCREW.OBJUID = FIWP_NAMEDCREW_REL.UID2 AND FIWP_NAMEDCREW.CONFIG = FIWP.PROJECT AND FIWP_NAMEDCREW.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAREL FIWP_CWP_REL ON FIWP_CWP_REL.UID2 = FIWP.FIWPUID AND FIWP_CWP_REL.DEFUID = 'SPC_CWP_FIWPs' AND FIWP_CWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)                LEFT JOIN DATAOBJ FIWP_CWP ON FIWP_CWP.OBJUID = FIWP_CWP_REL.UID1 AND FIWP_CWP.CONFIG = FIWP.PROJECT AND FIWP_CWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)#(lf)DETAIL_DS AS (#(lf)#(lf)  SELECT #(lf) #(lf)  NULLIF(PURPOSE,'NA') as ""PURPOSE"",#(lf)    RG.""DECKNAME"",#(lf)    RG.""TAGID"",#(lf)    RG.""SERVICE"",#(lf)    RG.""CABLEPOWER"",#(lf)    RG.""Volt_AC_DC"",#(lf)    RG.""FromEquipment"",#(lf)    RG.""ToEquipment"",#(lf)    RG.""FromTag"",#(lf)    RG.""FromDescription"",#(lf)    RG.""ToTag"",#(lf)    RG.""ToDescription"" AS ""TODESCRIPTION"",#(lf)    RG.""CoreNo"",#(lf)    RG.""CoreSize"",#(lf)    RG.""CableVoltage"",#(lf)    RG.""UNITS"",#(lf)    RG.""SCOPE"",#(lf)    RG.""FROMDECKLEVEL"",#(lf)    RG.""TODECKLEVEL"",#(lf)    RG.""FromGlandScope"",#(lf)    RG.""ToGlandScope"",#(lf)    RG.""CableDrumNo"",#(lf)    RG.""RevHistory"",#(lf)    RG.""Remarks"",#(lf)    RG.""LocationDescription"",#(lf)    RG.""CableAssociatedTo"",#(lf)    RG.""CommodityCode"",#(lf)    RG.""PartNumber"",#(lf)    RG.""ClassDesignation"",#(lf)    RG.""CREATED_BY"",#(lf)    RG.""CREATED_DATE"",#(lf)    RG.""Description"",#(lf)    RG.""Quantity"",#(lf)    RG.""Type"",#(lf)#(tab)RG.""RoomNo"",#(lf)    RG.""Length"",#(lf)    RG.""Height"",#(lf)    RG.""Facility"",#(lf)    RG.""Width"",#(lf)    RG.""ProgressStatus"",#(lf)    RG.""DRAWINGNO"",#(lf)    RG.""ACTIVITY"",RG.""CORRECTEDTAG"",#(lf)#(lf)    --case when STEPNAME='Pull' then ACTUALDRUMNO  else null end  AS ""ACTUAL DRUM NO"",#(lf)    case when STEPNAME='Fit Up' then ACTUALQUANTITY  else null end AS ""ACTUALLENGTH"",#(lf)#(lf)    t2.NAME AS ""INSTALLED IWP NO"",#(lf)    t5.COSTCODE  AS ""INSTALLED COST CODE"",#(lf)#(lf)    --CASE WHEN STEPNAME='Fit Up' THEN T5.PLANNEDMANHOURS   ELSE 0 END AS ""INSTALLED MANHOURS"",#(lf)    --CASE WHEN STEPNAME='Fit Up' THEN T5.ACTUALMANHOURS   ELSE 0 END AS ""INSTALLED ACTUAL"",#(lf)#(lf)    CASE WHEN STEPNAME in('Fabricate','Install','Inspection','Set in Place','preparation','Install Accep','lift/set in place','Fitup','General','cut out','weld/bolt','Accept','weld','Cut','Crimp','Roll','Machining','Cladding','Stabbing', 'Girth Weld','Field Welding Accepted','Blast' || chr(38) || '  Prime - Shop Primer', 'MID COAT','Blast' || chr(38) ||'  Prime - Project Primer','TOP COAT','APPLY AGGREGATE','NDT','Delivery','Preparation (Threading & Joining)','Fitup (Tack Weld)','NDT Clear (Field)','Flush/Fill','Pressurize','Dewater','Reinstate','Acceptance') THEN T5.PLANNEDMANHOURS   ELSE 0 END AS ""INSTALLED MANHOURS"",#(lf)#(lf)    CASE WHEN STEPNAME in('Fabricate','Install','Inspection','Set in Place','preparation','Install Accep','lift/set in place','Fitup','General','cut out','weld/bolt','Accept','weld','Cut','Crimp','Roll','Machining','Cladding','Stabbing', 'Girth Weld','Field Welding Accepted','Blast' || chr(38) || '  Prime - Shop Primer', 'MID COAT','Blast' || chr(38) || '  Prime - Project Primer','TOP COAT','APPLY AGGREGATE','NDT','Delivery','Preparation (Threading & Joining)','Fitup (Tack Weld)','NDT Clear (Field)','Flush/Fill','Pressurize','Dewater','Reinstate','Acceptance') THEN T5.ACTUALMANHOURS   ELSE 0 END AS ""INSTALLED ACTUAL"",#(lf)#(lf)    --CASE WHEN STEPNAME='Weld' THEN T5.PLANNEDMANHOURS ELSE 0 END AS ""WELD Manhours"",#(lf)    --CASE WHEN STEPNAME='Weld' THEN T5.ACTUALMANHOURS   ELSE 0 END AS ""WELD ACTUAL"",#(lf)#(lf)   --CASE WHEN STEPNAME in('Install Accep','lift/set in place') THEN T5.PLANNEDMANHOURS ELSE 0 END AS ""WELD Manhours"",#(lf)   --CASE WHEN STEPNAME in('Install Accep','lift/set in place') THEN T5.ACTUALMANHOURS   ELSE 0 END AS ""WELD ACTUAL"",#(lf)#(lf)    CREATIONUSER AS ""Last Progress User"",#(lf)    CASE WHEN PROGRESSCOMPLETE = 1  THEN CREATIONDATE ELSE '' END AS PROGRESSEDDATE,#(lf)    STEPNAME, PROGRESSCOMPLETE#(lf)#(lf)#(lf)#(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_FIWP_DIRECT_PROP_TMP t2 ON t2.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_FIWP_DIR_ENUM_PROP_TMP t3 ON t3.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_FIWP_REL_PROP_TMP t4 ON t4.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN WORKSTEPS t5 ON t5.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_COMPONENTITEM1 t6 ON t6.COMPOBID = t5.COMPOBID#(lf)FULL OUTER JOIN SPCRPT_REG_DIRECT_PROP_TMP RG ON RG.TAGID = T6.NAME#(lf)--INNER JOIN SPCRPT_REG_DIRECT_PROP_TMP RG ON RG.TAGID = T6.NAME#(lf)WHERE RG.""ClassDesignation"" in('Non_Published_CableTray')#(lf)#(lf)#(lf))#(lf)#(lf)#(lf)#(lf)select#(lf)""DECKNAME"",#(lf)#(lf)""ProgressStatus"" as ""RegisterName"",#(lf)""TAGID"",#(lf)""ACTIVITY"",#(lf)""CORRECTEDTAG"",#(lf)""CREATED_BY"",#(lf)""CREATED_DATE"",#(lf)""ClassDesignation"",#(lf)""LocationDescription"",#(lf)""DRAWINGNO"",#(lf)""UNITS"", --CAST(""UNITS"" AS FLOAT) as ""UNITS"",#(lf)""Description"",#(lf)""Quantity"",#(lf)""Type"",#(lf)""RoomNo"",#(lf)""Length"",#(lf)""Height"",#(lf)""Width"",#(lf)#(lf)--MAX(""ACTUAL DRUM NO"") as ""ACTUAL DRUM NO"",#(lf)MAX(""ACTUALLENGTH"") as ""ACTUALLENGTH"",#(lf)#(lf)Max(Case when DETAIL_DS.PURPOSE IN ('Installation','Cut','Fabrication','Machining','Cladding','Roll','Assemble','Testing','Trial Fit','Dismantle','Erection - Blast, Prime, ' || chr(38) || ' Tie Coat','Erection - Intermediate ' || chr(38) || ' Top','Stenciling, Marking, Color Code','Touch Up','Apply Aggregate','Erection - Special Coat','Fabrication - Site Run','Installation - Site Run','Mechanical Completion','Material Handling','Clean Up','Yard Preparation','JEIT','Rigging') Then ""INSTALLED IWP NO"" Else Null End) As ""INSTALLED IWP NO"",#(lf)Max(Case when DETAIL_DS.PURPOSE = 'Calibration'  Then ""INSTALLED IWP NO"" Else Null End) As ""CALIBRATION IWP NO"",#(lf)#(lf)MAX(""INSTALLED COST CODE"") as ""INSTALLED COST CODE"",#(lf)SUM(""INSTALLED MANHOURS"") as ""INSTALLED MANHOURS"",#(lf)SUM(""INSTALLED ACTUAL"") as ""INSTALLED ACTUAL"",#(lf)#(lf)CASE WHEN SUM(""INSTALLED MANHOURS"")>0 THEN SUM(""INSTALLED ACTUAL"")/ SUM(""INSTALLED MANHOURS"") * 100  ELSE 0 END AS ""INSTALLED %"",#(lf)--CASE WHEN SUM(""INSTALLED ACTUAL"")>0 THEN MAX(""PROGRESSEDDATE"") ELSE '' END AS ""INSTALLED Comp Date"",#(lf)--CASE WHEN SUM(""INSTALLED ACTUAL"")>0 THEN MAX(""Last Progress User"") ELSE '' END AS ""INSTALLED Prog By"",#(lf)#(lf)Max(CASE WHEN ""INSTALLED ACTUAL"" >0 And DETAIL_DS.PURPOSE IN ('Installation','Cut','Fabrication','Machining','Cladding','Roll','Assemble','Testing','Trial Fit','Dismantle','Erection - Blast, Prime, ' || chr(38) || ' Tie Coat','Erection - Intermediate ' || chr(38) || ' Top','Stenciling, Marking, Color Code','Touch Up','Apply Aggregate','Erection - Special Coat','Fabrication - Site Run','Installation - Site Run','Mechanical Completion','Material Handling','Clean Up','Yard Preparation','JEIT','Rigging') THEN ""PROGRESSEDDATE"" ELSE Null END) AS ""INSTALLED Comp Date"",#(lf)Max(CASE WHEN ""INSTALLED ACTUAL"" >0 And DETAIL_DS.PURPOSE IN ('Installation','Cut','Fabrication','Machining','Cladding','Roll','Assemble','Testing','Trial Fit','Dismantle','Erection - Blast, Prime, ' || chr(38) || ' Tie Coat','Erection - Intermediate ' || chr(38) || ' Top','Stenciling, Marking, Color Code','Touch Up','Apply Aggregate','Erection - Special Coat','Fabrication - Site Run','Installation - Site Run','Mechanical Completion','Material Handling','Clean Up','Yard Preparation','JEIT','Rigging') THEN ""Last Progress User"" ELSE Null END) AS ""INSTALLED Prog By""#(lf)#(lf)#(lf)--SUM(""WELD Manhours"") as ""WELD Manhours"",#(lf)--SUM(""WELD ACTUAL"") as ""WELD ACTUAL"",#(lf)#(lf)--CASE WHEN SUM(""WELD Manhours"")>0 THEN SUM(""WELD ACTUAL"")/ SUM(""WELD Manhours"") * 100  ELSE 0 END AS ""Weld %"",#(lf)--CASE WHEN SUM(""WELD ACTUAL"")>0 THEN MAX(""PROGRESSEDDATE"") ELSE '' END AS ""Weld Comp Date"",#(lf)--CASE WHEN SUM(""WELD ACTUAL"")>0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Weld Prog By"",#(lf)--CASE WHEN (SUM(""INSTALLED MANHOURS"") + SUM(""WELD Manhours""))>0 THEN#(lf)--(SUM(""INSTALLED ACTUAL"") + SUM(""WELD ACTUAL"")) / (SUM(""INSTALLED MANHOURS"") + SUM(""WELD Manhours"")) * 100 ELSE 0 END as ""OverAll %"",#(lf)--CASE WHEN (SUM(""INSTALLED ACTUAL"") + SUM(""WELD ACTUAL""))>0 THEN MAX(""Last Progress User"") ELSE '' END AS ""Last Prog By""#(lf)#(lf)from DETAIL_DS#(lf)#(lf)#(lf)GROUP BY ""DECKNAME"", ""TAGID"",#(lf)""UNITS"",#(lf)  ""ClassDesignation"",#(lf)""Description"",#(lf)""Quantity"",#(lf)""Length"",#(lf)""Height"",#(lf)""Width"",#(lf)""ProgressStatus"",#(lf)""LocationDescription"",#(lf)""CREATED_BY"",""CREATED_DATE"", #(lf)""DRAWINGNO"", #(lf)""ACTIVITY"",""CORRECTEDTAG"",#(lf)""RoomNo"",#(lf)""Type""#(lf)#(lf)#(lf)--Select * from SPCRPT_FIWP_IOBJECT_PROP_TMP where FIWPOBID = '1U9Z00LA'"])
				in
				    Source

