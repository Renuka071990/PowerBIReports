	column 'COMPONENT N' = ```
			VAR A = Find("/",[COMPONENT])
			VAR B = IF(ISERROR(Find(" of",[COMPONENT])),BLANK(),Find(" of",[COMPONENT])-1)
			VAR Length = LEN([COMPONENT])
			VAR Output = MID([COMPONENT],A+1,Length-A)
			VAR Output2 = LEFT([COMPONENT],B)
			VAR FinalOutput = Output&" - "&Output2  
			RETURN
			FinalOutput
			```
		lineageTag: e1c7270d-6570-4ff7-8800-5ef6fd5315d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

