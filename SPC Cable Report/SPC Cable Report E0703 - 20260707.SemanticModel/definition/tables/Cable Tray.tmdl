	partition 'Cable Tray-49d4f801-c230-4deb-a4d2-5f99dfa35e25' = m
		mode: import
		source =
				let
				    Source = Oracle.Database("SPFC5DUP.world", [HierarchicalNavigation=true, Query="#(lf)SELECT COMPONENTITEM.OBID AS ""COMPOBID"",#(lf)        COMPONENTITEM.OBJNAME as ""COMPONENT"",#(lf)        COMPONENTITEM.CONFIG AS ""PROJECT"" ,#(lf)        COMPONENTITEM_FIWP.OBID AS ""FIWPOBID"",#(lf)        COMPONENTITEM_FIWP.OBJUID AS ""FIWPUID"",#(lf)        COMPONENTITEM_FIWP_NAME.STRVALUE AS ""WPNO"",#(lf)        FIWP_DISCIPLINE.OBJNAME AS ""DISCIPLINE"",#(lf)        FIWP_PURPOSE.OBJNAME AS ""PURPOSE"",#(lf)        FIWP_DESIGNAREA.STRVALUE AS ""DESIGNAREA"",#(lf)        CAST(COMPONENTITEM_QUANTITYPLANNED.STRVALUE AS FLOAT) AS ""QUANTITYPLANNED"",#(lf)        FIWP_CONTRACTOR.STRVALUE AS ""CONTRACTOR"", #(lf)        FIWP_TaskNo.STRVALUE AS ""TASKNO"",#(lf)        CAST(FIWP_Estimated.STRVALUE AS FLOAT) AS ""AFCHRS"" ,#(lf)        enumpr.objname AS ""WP_REVNO"",#(lf)        FIWP_STATUS.OBJNAME AS ""WP STATUS"" ,#(lf)        FIWP_REVDATE.STRVALUE AS ""REVDATE"",#(lf)        FIWP_RECEDATE.STRVALUE AS ""RECEDATE"",#(lf)        TO_DATE(FIWP_PLANNEDSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDSTARTDATE"",            #(lf)        TO_DATE(FIWP_PLANNEDFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDFINISHDATE"",#(lf)        TO_DATE(FIWP_ACTUALSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALSTARTDATE"",#(lf)        TO_DATE(FIWP_ACTUALFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALFINISHDATE"",#(lf)        #(lf)#(tab)#(tab)#(tab)#(tab)----Component Properties#(lf)        MDR_DISCIPLINE.STRVALUE as ""MDR_DISCIPLINE"",#(tab)#(tab)      #(lf)        MDR_ROOMNO.STRVALUE as ""MDR_ROOMNO"",#(lf)        MDR_TYPE.STRVALUE as ""MDR_TYPE"",#(lf)        MDR_LEVEL.STRVALUE as ""MDR_LEVEL"",#(lf)        MDR_PARTNUMBER.STRVALUE as ""MDR_PARTNUMBER"",#(lf)        MDR_DRAWINGNO.STRVALUE as ""MDR_DRAWINGNO"",#(lf)        MDR_PARENTNAME.STRVALUE as ""MDR_PARENTNAME"",        #(lf)        MDR_SHORTDESC.STRVALUE as ""MDR_SHORTDESC"",  #(lf)#(tab)#(tab)MDR_ZONECOLD.STRVALUE as ""MDR_ZONECOLD"",  #(lf)#(tab)#(tab)MDR_ITEMZONE.STRVALUE as ""MDR_ITEMZONE"", #(lf)#(tab)#(tab)MDR_SYSTEMPATH.STRVALUE as ""MDR_SYSTEMPATH"",#(lf)        MDR_UNITS.STRVALUE as ""MDR_UNITS"",#(lf)#(tab)#(tab)MDR_PARTNUMBER1.STRVALUE as ""MDR_PARTNUMBER1"",#(lf)        MDR_PARTCODE_ESTI.STRVALUE as ""MDR_PARTCODE_ESTI"",        #(lf)        COMP_IDENTCODE_M.STRVALUE as ""COMP_IDENTCODE_M"",#(tab)#(tab)#(lf)        COMP_SHORTDESC.STRVALUE as ""COMP_SHORTDESC"",#(tab)#(tab)#(lf)#(tab)#(tab)PIP_COMPNODE.STRVALUE as ""PIP_COMPNODE"",#(tab)#(tab)#(lf)        MDR_MATCUSTOM.STRVALUE as ""MDR_MATCUSTOM"",#(lf)#(tab)#(tab)COMPNODE_COMPTYPE.STRVALUE as ""COMPNODE_COMPTYPE"",#(lf)#(tab)#(tab)#(lf)        ClassDesignation.STRVALUE As ""CLASSDESIG"",#(lf)        IsAssembly.STRVALUE As ""ISASSEMBLY"",#(tab)#(tab)#(lf)        COMPONENTITEM.OBJDEFUID as ""CLASSDEF"",#(lf)        Case When Tomobj.CreationDate Is Null Then 'False' Else 'True' End as ""TombstoneItem""#(lf)#(tab)#(tab)#(lf)            #(lf)  FROM DATAOBJ COMPONENTITEM#(lf)#(lf)  LEFT JOIN DATAREL COMPONENTITEM_FIWP_REL ON COMPONENTITEM_FIWP_REL.UID2 = COMPONENTITEM.OBJUID AND COMPONENTITEM_FIWP_REL.DEFUID = 'SPC_Package_ComponentItems' AND COMPONENTITEM_FIWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPONENTITEM_FIWP ON COMPONENTITEM_FIWP.OBJUID = COMPONENTITEM_FIWP_REL.UID1 AND COMPONENTITEM_FIWP.CONFIG = COMPONENTITEM.CONFIG AND COMPONENTITEM_FIWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf) #(tab)#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DISCIPLINE_PR ON FIWP_DISCIPLINE_PR.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_DISCIPLINE_PR.PROPERTYDEFUID = 'FIWP_Discipline' AND FIWP_DISCIPLINE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR COMPONENTITEM_FIWP_NAME ON COMPONENTITEM_FIWP_NAME.OBJOBID = COMPONENTITEM_FIWP.OBID AND COMPONENTITEM_FIWP_NAME.PROPERTYDEFUID = 'Name' AND COMPONENTITEM_FIWP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_DISCIPLINE ON FIWP_DISCIPLINE.OBJUID = FIWP_DISCIPLINE_PR.STRVALUE AND FIWP_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf) #(lf)  LEFT JOIN DATAOBJPR FIWP_PURPOSE_PR ON FIWP_PURPOSE_PR.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_PURPOSE_PR.PROPERTYDEFUID = 'FIWP_Purpose' AND FIWP_PURPOSE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_PURPOSE ON FIWP_PURPOSE.OBJUID = FIWP_PURPOSE_PR.STRVALUE AND FIWP_PURPOSE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR COMPONENTITEM_QUANTITYPLANNED ON COMPONENTITEM_QUANTITYPLANNED.OBJOBID = COMPONENTITEM.OBID  AND COMPONENTITEM_QUANTITYPLANNED.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_QUANTITYPLANNED.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)LEFT JOIN DATAREL FIWP_CONTRACTOR_REL ON FIWP_CONTRACTOR_REL.UID1 = COMPONENTITEM_FIWP.OBJUID AND FIWP_CONTRACTOR_REL.DEFUID = 'SPC_Package_Contractor' AND FIWP_CONTRACTOR_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CONTRACTOR_OBJ ON FIWP_CONTRACTOR_OBJ.OBJUID = FIWP_CONTRACTOR_REL.UID2 AND FIWP_CONTRACTOR_OBJ.CONFIG = COMPONENTITEM.CONFIG AND FIWP_CONTRACTOR_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CONTRACTOR ON FIWP_CONTRACTOR.OBJOBID = FIWP_CONTRACTOR_OBJ.OBID AND FIWP_CONTRACTOR.PROPERTYDEFUID = 'Name' AND FIWP_CONTRACTOR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_DESIGNAREA_REL ON FIWP_DESIGNAREA_REL.UID2 = COMPONENTITEM_FIWP.OBJUID AND FIWP_DESIGNAREA_REL.DEFUID = 'SPC_FunctionalArea_FIWPs' AND FIWP_DESIGNAREA_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_DESIGNAREA_OBJ ON FIWP_DESIGNAREA_OBJ.OBJUID = FIWP_DESIGNAREA_REL.UID1 AND FIWP_DESIGNAREA_OBJ.CONFIG = COMPONENTITEM.CONFIG AND FIWP_DESIGNAREA_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DESIGNAREA ON FIWP_DESIGNAREA.OBJOBID = FIWP_DESIGNAREA_OBJ.OBID AND FIWP_DESIGNAREA.PROPERTYDEFUID = 'Name' AND FIWP_DESIGNAREA.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(tab)#(lf)  #(lf)        #(tab)--IWP REVDATE#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_REVDATE ON FIWP_REVDATE.OBJOBID =  COMPONENTITEM_FIWP.OBID AND FIWP_REVDATE.PROPERTYDEFUID = 'MDR_RevDate' AND FIWP_REVDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_REV ON FIWP_REV.OBJOBID =  COMPONENTITEM_FIWP.OBID AND FIWP_REV.PROPERTYDEFUID = 'MDR_Rev' AND FIWP_REV.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(tab)#(lf)  LEFT JOIN DATAOBJPR FIWP_RECEDATE ON FIWP_RECEDATE.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_RECEDATE.PROPERTYDEFUID = 'MDR_RecievedDate' AND FIWP_RECEDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  left join schemaobj enumpr on FIWP_REV.strvalue=enumpr.objuid and enumpr.objdefuid='EnumEnum' and enumpr.terminationdate='9999/12/31-23:59:59:999'#(lf)  #(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_TaskNo ON FIWP_TaskNo.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_TaskNo.PROPERTYDEFUID = 'MDR_FIWPTaskNo' AND FIWP_TaskNo.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--FIWP AFC Hrs#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_Estimated ON FIWP_Estimated.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_Estimated.PROPERTYDEFUID = 'FIWP_Estimated_Manhours' AND FIWP_Estimated.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  LEFT JOIN DATAOBJPR FIWP_STATUS_PR ON FIWP_STATUS_PR.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_STATUS_PR.PROPERTYDEFUID = 'Package_Status' AND FIWP_STATUS_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_STATUS ON FIWP_STATUS.OBJUID = FIWP_STATUS_PR.STRVALUE AND FIWP_STATUS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  --DATES#(lf)  LEFT JOIN DATAOBJPR FIWP_PLANNEDSTARTDATE ON FIWP_PLANNEDSTARTDATE.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_PLANNEDSTARTDATE.PROPERTYDEFUID = 'FIWP_PlannedStartDate' AND FIWP_PLANNEDSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PLANNEDFINISHDATE ON FIWP_PLANNEDFINISHDATE.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_PLANNEDFINISHDATE.PROPERTYDEFUID = 'FIWP_PlannedFinishDate' AND FIWP_PLANNEDFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALSTARTDATE ON FIWP_ACTUALSTARTDATE.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_ACTUALSTARTDATE.PROPERTYDEFUID = 'FIWP_ActualStartDate'  AND FIWP_ACTUALSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALFINISHDATE ON FIWP_ACTUALFINISHDATE.OBJOBID = COMPONENTITEM_FIWP.OBID AND FIWP_ACTUALFINISHDATE.PROPERTYDEFUID = 'FIWP_ActualFinishDate'  AND FIWP_ACTUALFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf) #(lf)----Component Properties #(lf)  LEFT JOIN DATAOBJPR MDR_DISCIPLINE ON MDR_DISCIPLINE.objobid = COMPONENTITEM.OBID AND MDR_DISCIPLINE.propertydefuid = 'MDR_Discipline'   AND MDR_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_MATCUSTOM ON MDR_MATCUSTOM.objobid = COMPONENTITEM.OBID AND MDR_MATCUSTOM.propertydefuid = 'MDR_MaterialICustom'   AND MDR_MATCUSTOM.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(tab)  #(lf)  LEFT JOIN DATAOBJPR MDR_ROOMNO ON MDR_ROOMNO.objobid = COMPONENTITEM.OBID AND MDR_ROOMNO.propertydefuid = 'MDR_RoomNo'   AND MDR_ROOMNO.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_TYPE ON MDR_TYPE.objobid = COMPONENTITEM.OBID AND MDR_TYPE.propertydefuid = 'MDR_Type'   AND MDR_TYPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_LEVEL ON MDR_LEVEL.objobid = COMPONENTITEM.OBID AND MDR_LEVEL.propertydefuid = 'MDR_Level'   AND MDR_LEVEL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_PARTNUMBER ON MDR_PARTNUMBER.objobid = COMPONENTITEM.OBID AND MDR_PARTNUMBER.propertydefuid = 'MDR_PartNumber1'   AND MDR_PARTNUMBER.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_DRAWINGNO ON MDR_DRAWINGNO.objobid = COMPONENTITEM.OBID AND MDR_DRAWINGNO.propertydefuid = 'MDR_IDOCS_DrawingNo'   AND MDR_DRAWINGNO.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_PARENTNAME ON MDR_PARENTNAME.objobid = COMPONENTITEM.OBID AND MDR_PARENTNAME.propertydefuid = 'MDR_ParentName'   AND MDR_PARENTNAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_SHORTDESC ON MDR_SHORTDESC.objobid = COMPONENTITEM.OBID AND MDR_SHORTDESC.propertydefuid = 'SPC_ComponentItem_ShortDescription'   AND MDR_SHORTDESC.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)   #(lf)   LEFT JOIN DATAOBJPR MDR_ZONECOLD ON MDR_ZONECOLD.objobid = COMPONENTITEM.OBID AND MDR_ZONECOLD.propertydefuid = 'MDR_Zone_Cold'   AND MDR_ZONECOLD.TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)   LEFT JOIN DATAOBJPR MDR_ITEMZONE ON MDR_ITEMZONE.objobid = COMPONENTITEM.OBID AND MDR_ITEMZONE.propertydefuid = 'SPC_ComponentItem_Zone'   AND MDR_ITEMZONE.TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)  #(lf)  LEFT JOIN DATAOBJPR MDR_SYSTEMPATH ON MDR_SYSTEMPATH.objobid = COMPONENTITEM.OBID AND MDR_SYSTEMPATH.propertydefuid = 'SPC_SystemPath'   AND MDR_SYSTEMPATH.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_UNITS ON MDR_UNITS.objobid = COMPONENTITEM.OBID AND MDR_UNITS.propertydefuid = 'SPC_ComponentItem_Units'   AND MDR_UNITS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_PARTNUMBER1 ON MDR_PARTNUMBER1.objobid = COMPONENTITEM.OBID AND MDR_PARTNUMBER1.propertydefuid = 'MDR_PartNumber1'   AND MDR_PARTNUMBER1.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR MDR_PARTCODE_ESTI ON MDR_PARTCODE_ESTI.objobid = COMPONENTITEM.OBID AND MDR_PARTCODE_ESTI.propertydefuid = 'MDR_PartCode_Esti'   AND MDR_PARTCODE_ESTI.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR COMP_IDENTCODE_M ON COMP_IDENTCODE_M.objobid = COMPONENTITEM.OBID AND COMP_IDENTCODE_M.propertydefuid = 'SPC_ComponentItem_IdentCode_M'   AND COMP_IDENTCODE_M.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR COMP_SHORTDESC ON COMP_SHORTDESC.objobid = COMPONENTITEM.OBID AND COMP_SHORTDESC.propertydefuid = 'SPC_ComponentItem_ShortDescription'   AND COMP_SHORTDESC.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR PIP_COMPNODE ON PIP_COMPNODE.objobid = COMPONENTITEM.OBID AND PIP_COMPNODE.propertydefuid = 'PipingComponentNode_ComponentType'   AND PIP_COMPNODE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  #(lf)  LEFT JOIN DATAOBJPR COMPNODE_COMPTYPE ON COMPNODE_COMPTYPE.objobid = COMPONENTITEM.OBID AND COMPNODE_COMPTYPE.propertydefuid = 'PipingComponentNode_ComponentType'   AND COMPNODE_COMPTYPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)  #(tab)--Class#(lf) LEFT JOIN DATAOBJPR ClassDesignation ON ClassDesignation.OBJOBID = COMPONENTITEM.OBID AND ClassDesignation.PROPERTYDEFUID = 'SpcNonPublishedClassDesignation' AND  ClassDesignation.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf) #(lf)  #(tab)  #(tab)--Assembly#(lf) LEFT JOIN DATAOBJPR IsAssembly ON IsAssembly.OBJOBID = COMPONENTITEM.OBID AND IsAssembly.PROPERTYDEFUID = 'SPC_Assembly_IsSimple' AND  IsAssembly.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf) #(lf) --TombstoneItem #(lf) Left Join DataobjIf Tomobj ON Tomobj.Objobid = COMPONENTITEM.OBID And Tomobj.Interfacedefuid = 'ISPC_TombstoneItem' And Tomobj.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf) #(lf) #(lf)#(tab) WHERE  MDR_DISCIPLINE.STRVALUE IS NOT NULL AND COMPONENTITEM.TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)   --And COMPONENTITEM.OBJNAME = 'BEND 1 of BRANCH /WD0016-T-100-SS/B1'#(lf)  --WHERE COMPONENTITEM.OBJUID IS NOT NULL  AND COMPONENTITEM_FIWP.OBJUID IS NOT NULL AND COMPONENTITEM.TERMINATIONDATE = '9999/12/31-23:59:59:999'  AND FIWP_DISCIPLINE.OBJNAME = 'Electrical'"])
				in
				    Source

	annotation PBI_ResultType = Table

