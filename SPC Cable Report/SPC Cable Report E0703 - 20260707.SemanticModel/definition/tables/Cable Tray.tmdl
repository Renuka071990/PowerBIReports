	column 'WP Hrs' = sumx(FILTER('Cable Tray (Progress)','Cable Tray (Progress)'[CombinedPOBID]='Cable Tray'[CombinedPOBID]&&'Cable Tray (Progress)'[FIWPOBID]<>BLANK()),'Cable Tray (Progress)'[WP Hrs])
