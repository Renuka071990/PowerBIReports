	measure 'MX_Cumm Actual_DEL' = (sum('Qty Plan'[FX_ACT_CUMM])/'FX_COMPU Table'[MX_Count_Weeks])
		lineageTag: 7f51fcd6-df7c-4a01-a558-5d750a096165

