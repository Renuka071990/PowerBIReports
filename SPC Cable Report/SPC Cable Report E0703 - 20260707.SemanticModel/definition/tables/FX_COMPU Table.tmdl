	measure MX_Week_Ending = (if(WEEKDAY(today()) < 6,(today()+5) - WEEKDAY(today()),((today()+5) - WEEKDAY(today()))+7))
		formatString: General Date
		lineageTag: d858e963-e936-4571-ab2a-4828687055fd

