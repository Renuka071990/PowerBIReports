	measure MX_ACT_WK_GLAND =
			calculate(
			    count(Query1[Glanding From Comp Date]),
			    filter(Query1,Query1[FX_GlanFromComp_WeekEnding]  = [MX_Week_Ending]))+
			    calculate(
			    count(Query1[Glanding To Comp Date]),
			    filter(Query1,Query1[FX_GlanToComp_WeekEnding]  = [MX_Week_Ending]))
		formatString: 0
		lineageTag: 4dc2ed64-2348-46e4-bb2d-cbda65caef6a

	measure MX_ACT_WK_Pull =
			calculate (sum(Query1[ACTUALLENGTH]),
			filter(Query1,Query1[FX_PulledtoComp_WeekEnding] = [MX_Week_Ending]
			))
		lineageTag: 13d235c6-05be-42bb-99a8-f90a1c96e2e4

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MX_ACT_WK_TERM =
			calculate(
			    count(Query1[Termination From Comp Date]),
			    filter(Query1,Query1[FX_TermFromComp_WeekEnding]  = [MX_Week_Ending]))
			    + calculate(
			    count(Query1[Termination To Comp Date]),
			    filter(Query1,Query1[FX_TermToComp_WeekEnding]  = [MX_Week_Ending]))
		formatString: 0
		lineageTag: cec1ddc5-8ebc-4563-9b1d-caae1e8dffff

	measure MX_ACT_WK_TEST =
			calculate(
			    count(Query1[Testing Comp Date]),
			    filter(Query1,Query1[FX_TestToComp_WeekEnding]  = [MX_Week_Ending]))
		formatString: 0
		lineageTag: 1261ebc5-2c03-48eb-93f5-aeec9cc3960b

	measure MX_Count_Weeks = count('FX_COMPU Table'[Week Ending])
		formatString: 0
		lineageTag: 2a5d8949-8cbd-4a28-a026-0d803bb31dd8

	measure 'MX_Cumm Actual' = sum('Subsystem-ItemType'[FX_ACT_CUMM])
		formatString: #,0
		lineageTag: abee5027-0b8b-4afd-b49a-ccc93a851274

		changedProperty = FormatString

	measure 'MX_Cumm Plan' =
			
			(CALCULATE(
			    sum('Qty Plan'[Value]),
			        FILTER(
			            ('Qty Plan'),'Qty Plan'[Week Ending]<=[WEEK ENDING NOW])))
		lineageTag: f64773b4-6a2a-445d-8749-dc50d9040ce4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MX_Cummulative Actual %' = ((sum('Subsystem-ItemType'[FX_ACT_CUMM])/[MX_Estimate]))
		formatString: 0%;-0%;0%
		lineageTag: dda32482-5071-45b4-b9e0-72bea34bcaa2

