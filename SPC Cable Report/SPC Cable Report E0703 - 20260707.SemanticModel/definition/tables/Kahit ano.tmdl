	partition 'Kahit ano' = calculated
		mode: import
		source =
				
				VAR Pull = SUMMARIZE(Query1,[DECKNAME],[SCOPE],[FromEquipment],[fx_eqp_from_iwp],[ToEquipment],[fx_eqp_to_iwp],[TAGID],[PULLING IWP NO],[UNITS],[Pulled Comp Date],"PURPOSE","PULLING")
				VAR GlandFrom = SUMMARIZE(Query1,[DECKNAME],[SCOPE],[FromEquipment],[fx_eqp_from_iwp],[ToEquipment],[fx_eqp_to_iwp],[TAGID],[GLANDING FROM IWP NO],[UNITS],[Glanding From Comp Date],"PURPOSE","GLAND FROM")
				VAR GlandTo = SUMMARIZE(Query1,[DECKNAME],[SCOPE],[FromEquipment],[fx_eqp_from_iwp],[ToEquipment],[fx_eqp_to_iwp],[TAGID],[GLANDING TO IWP NO],[UNITS],[Glanding To Comp Date],"PURPOSE","GLAND TO")
				VAR TermFrom = SUMMARIZE(Query1,[DECKNAME],[SCOPE],[FromEquipment],[fx_eqp_from_iwp],[ToEquipment],[fx_eqp_to_iwp],[TAGID],[Termination From IWP No],[UNITS],[Termination From Comp Date],"PURPOSE","TERM FROM")
				VAR TermTo = SUMMARIZE(Query1,[DECKNAME],[SCOPE],[FromEquipment],[fx_eqp_from_iwp],[ToEquipment],[fx_eqp_to_iwp],[TAGID],[Termination To IWP No],[UNITS],[Termination To Comp Date],"PURPOSE","TERM TO")
				VAR Test = SUMMARIZE(Query1,[DECKNAME],[SCOPE],[FromEquipment],[fx_eqp_from_iwp],[ToEquipment],[fx_eqp_to_iwp],[TAGID],[Testing IWP No],[UNITS],[Testing Comp Date],"PURPOSE","TEST")
				RETURN
				UNION(PULL,GlandFrom,GlandTo,TermFrom,TermTo,Test)

	annotation PBI_Id = 5660528166f34b9f9c2bbe72bebc755a

