	column Discipline = If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1) = "E","Electrical",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1) = "I","Instrumentation",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "L","Piping",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "T","Telecom",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "R","Mechanical",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "H","HVAC",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "A","Architectural",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "S","Safety",If(Mid(PIMS_aviw_CMS_Web_ObjectsEvents[CertID],4,1)= "N","Structural","")))))))))
