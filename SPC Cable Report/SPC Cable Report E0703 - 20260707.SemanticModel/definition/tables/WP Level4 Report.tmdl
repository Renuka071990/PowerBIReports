	column Column =
			VAR DECK = mid('WP Level4 Report'[WPNO],4,3)
			VAR DECKNAME = if(DECK="DBD","DBD DECK",
			if(DECK="DL1","DECK-1",
			if(DECK="DL2","DECK-2",
			if(DECK="DL3","DECK-3",
			if(DECK="DL4","DECK-4",
			if(DECK="DL5","DECK-5",
			if(DECK="DL6","DECK-6",
			if(DECK="DL7","DECK-7",
			if(DECK="DL8","DECK-8","")))))))))
			Return
			DECKNAME
		lineageTag: 3b37ba8f-425b-4f9f-82c3-7c4c53752e2e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'WP Level4 Report' = m
		mode: import
		source =
				let
				    Source = Oracle.Database("SPFC5DUP.world", [HierarchicalNavigation=true, Query="#(lf)WITH SPCRPT_CWP_IOBJECT_PROP_TMP AS#(lf)(#(lf) #(lf)SELECT #(lf)            CWP.OBID AS ""CWPOBID"",#(lf)            CWP.OBJUID AS ""CWPUID"",#(lf)            CWP.CONFIG AS ""PROJECT"" #(lf)-- sample: ,CWP.Property1 AS ""Prop1""#(lf)#(lf)FROM DATAOBJ CWP WHERE CWP.OBJDEFUID = 'SPC_CWP' AND CWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)#(lf)-- Section #2a: Columns for Direct properties#(lf)SPCRPT_CWP_DIRECT_PROP_TMP AS#(lf)(#(lf)#(lf)SELECT #(lf)            CWP.CWPOBID AS ""CWPOBID"",#(lf)            CWP_NAME.STRVALUE AS ""NAME"", #(lf)            CWP_DESCRIPTION.STRVALUE AS ""DESCRIPTION"",#(tab) #(lf)            CWP_EWPNUMBER.STRVALUE AS ""EWPNUMBER"",#(lf)            CAST(CWP_BUDGETEDLABORHOURS.STRVALUE AS FLOAT) AS ""BUDGETEDLABORHOURS"",#(lf)            TO_DATE(CWP_PLANNEDSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDSTARTDATE"",#(lf)            TO_DATE(CWP_PLANNEDFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDFINISHDATE"",#(lf)            TO_DATE(CWP_ACTUALSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALSTARTDATE"",#(lf)            TO_DATE(CWP_ACTUALFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALFINISHDATE"",#(lf)            TO_DATE(CWP_EARLYSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""EARLYSTARTDATE"",#(lf)            TO_DATE(CWP_EARLYFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""EARLYFINISHDATE"",#(lf)            TO_DATE(CWP_LATESTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""LATESTARTDATE"",#(lf)            TO_DATE(CWP_LATEFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""LATEFINISHDATE"",#(lf)            CWP_WBSPATH.STRVALUE AS ""WBSPATH""#(lf)-- sample: ,Property2.STRVALUE AS ""Prop2""#(lf)#(lf)FROM SPCRPT_CWP_IOBJECT_PROP_TMP CWP#(lf)#(lf)--Section #2c: Join SPF tables to get Direct Properties #(lf)#(lf)--#region "" Direct Properties ""#(lf)#(lf)#(tab)--NAME#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_NAME ON CWP_NAME.OBJOBID = CWP.CWPOBID AND CWP_NAME.PROPERTYDEFUID = 'Name' AND CWP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--DESCRIPTION#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_DESCRIPTION ON CWP_DESCRIPTION.OBJOBID = CWP.CWPOBID AND CWP_DESCRIPTION.PROPERTYDEFUID = 'Description' AND CWP_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--EWPNUMBER#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_EWPNUMBER ON CWP_EWPNUMBER.OBJOBID = CWP.CWPOBID AND CWP_EWPNUMBER.PROPERTYDEFUID = 'CWP_EWP_Number' AND CWP_EWPNUMBER.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--BUDGETEDLABORHOURS#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_BUDGETEDLABORHOURS ON CWP_BUDGETEDLABORHOURS.OBJOBID = CWP.CWPOBID AND CWP_BUDGETEDLABORHOURS.PROPERTYDEFUID = 'CWP_BudgetedLaborHours' AND CWP_BUDGETEDLABORHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--PLANNEDSTARTDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_PLANNEDSTARTDATE ON CWP_PLANNEDSTARTDATE.OBJOBID = CWP.CWPOBID AND CWP_PLANNEDSTARTDATE.PROPERTYDEFUID = 'CWP_PlannedStartDate' AND CWP_PLANNEDSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--PLANNEDFINISHDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_PLANNEDFINISHDATE ON CWP_PLANNEDFINISHDATE.OBJOBID = CWP.CWPOBID AND CWP_PLANNEDFINISHDATE.PROPERTYDEFUID = 'CWP_PlannedFinishDate' AND CWP_PLANNEDFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--ACTUALSTARTDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_ACTUALSTARTDATE ON CWP_ACTUALSTARTDATE.OBJOBID = CWP.CWPOBID AND CWP_ACTUALSTARTDATE.PROPERTYDEFUID = 'CWP_ActualStartDate' AND CWP_ACTUALSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--ACTUALFINISHDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_ACTUALFINISHDATE ON CWP_ACTUALFINISHDATE.OBJOBID = CWP.CWPOBID AND CWP_ACTUALFINISHDATE.PROPERTYDEFUID = 'CWP_ActualFinishDate' AND CWP_ACTUALFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--EARLYSTARTDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_EARLYSTARTDATE ON CWP_EARLYSTARTDATE.OBJOBID = CWP.CWPOBID AND CWP_EARLYSTARTDATE.PROPERTYDEFUID = 'CWP_EarlyStartDate' AND CWP_EARLYSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--EARLYFINISHDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_EARLYFINISHDATE ON CWP_EARLYFINISHDATE.OBJOBID = CWP.CWPOBID AND CWP_EARLYFINISHDATE.PROPERTYDEFUID = 'CWP_EarlyFinishDate' AND CWP_EARLYFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(tab)#(lf)#(tab)--LATESTARTDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_LATESTARTDATE ON CWP_LATESTARTDATE.OBJOBID = CWP.CWPOBID AND CWP_LATESTARTDATE.PROPERTYDEFUID = 'CWP_LateStartDate' AND CWP_LATESTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--LATEFINISHDATE#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_LATEFINISHDATE ON CWP_LATEFINISHDATE.OBJOBID = CWP.CWPOBID AND CWP_LATEFINISHDATE.PROPERTYDEFUID = 'CWP_LateFinishDate' AND CWP_LATEFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--WBSPATH#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_WBSPATH ON CWP_WBSPATH.OBJOBID = CWP.CWPOBID AND CWP_WBSPATH.PROPERTYDEFUID = 'CWP_WBSPath' AND CWP_WBSPATH.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)  ---- sample:#(lf)#(tab)--LEFT JOIN DATAOBJPR Property2 ON Property2.OBJOBID = FIWP.FIWPOBID AND Property2.PROPERTYDEFUID = '<PROPERTYDEFUID>' AND Property2.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)  #(lf)--#endregion "" Direct Properties ""#(lf)),#(lf)#(lf)SPCRPT_CWP_DIR_ENUM_PROP_TMP AS#(lf)(#(lf)SELECT #(lf)            CWP.CWPOBID AS ""CWPOBID"",#(lf)            CWP_DISCIPLINE.OBJNAME AS ""DISCIPLINE""#(lf)            #(lf)-- sample: ,Property3.OBJNAME AS Prop3#(lf)      #(lf)FROM SPCRPT_CWP_IOBJECT_PROP_TMP CWP#(lf)#(lf)-- Section #3c: Join SPF tables to Direct Properties (Enum Type)#(lf)#(lf)--#region "" Direct Properties with Enum Type ""#(lf)#(tab)#(lf)#(tab)--CWP Discipline#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_DISCIPLINE_PR ON CWP_DISCIPLINE_PR.OBJOBID = CWP.CWPOBID AND CWP_DISCIPLINE_PR.PROPERTYDEFUID = 'CWP_Discipline' AND CWP_DISCIPLINE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ CWP_DISCIPLINE ON CWP_DISCIPLINE.OBJUID = CWP_DISCIPLINE_PR.STRVALUE AND CWP_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)  ---- sample:#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab) #(lf)#(tab)-- LEFT JOIN DATAOBJPR Property3_PR ON Property3_PR.OBJOBID = CWP.CWPOBID AND Property3_PR.PROPERTYDEFUID = '<PROPERTYDEFUID>' AND Property3_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)-- LEFT JOIN SCHEMAOBJ Property3 ON Property3.OBJUID = Prop3_PR.STRVALUE AND Property3.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)--#endregion "" Direct Properties Enum Type ""#(lf)),#(lf)#(lf)-- Section #4a: Columns for Properties from related objects#(lf)SPCRPT_CWP_REL_PROP_TMP AS#(lf)(#(lf)#(lf)SELECT#(lf)            CWP.CWPOBID AS ""CWPOBID"",#(lf)            CWP_DESIGNAREA.STRVALUE AS ""DESIGNAREA"",#(lf)            CWP_CWA.OBID AS ""CWAOBID""#(lf)-- sample: ,Property4.STRVALUE AS ""Prop4""#(lf)#(lf)FROM SPCRPT_CWP_IOBJECT_PROP_TMP CWP#(lf)#(lf)-- Section #4c: Join SPF tables to get Properties from related objects#(tab)#(lf)#(lf)--#region "" Relationship other end properties ""#(lf)#(lf)#(tab)--Design Area#(lf)#(tab)LEFT JOIN DATAREL CWP_DESIGNAREA_REL ON CWP_DESIGNAREA_REL.UID2 = CWP.CWPUID AND CWP_DESIGNAREA_REL.DEFUID = 'SPC_FunctionalArea_CWP' AND CWP_DESIGNAREA_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ CWP_DESIGNAREA_OBJ ON CWP_DESIGNAREA_OBJ.OBJUID = CWP_DESIGNAREA_REL.UID1 AND CWP_DESIGNAREA_OBJ.CONFIG = CWP.PROJECT AND CWP_DESIGNAREA_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR CWP_DESIGNAREA ON CWP_DESIGNAREA.OBJOBID = CWP_DESIGNAREA_OBJ.OBID AND CWP_DESIGNAREA.PROPERTYDEFUID = 'Name' AND CWP_DESIGNAREA.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--CWAs#(lf)#(tab)LEFT JOIN DATAREL CWP_CWA_REL ON CWP_CWA_REL.UID2 = CWP.CWPUID  AND CWP_CWA_REL.DEFUID = 'SPC_CWA_CWPs' AND CWP_CWA_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ CWP_CWA ON CWP_CWA.OBJUID = CWP_CWA_REL.UID1 AND CWP_CWA.CONFIG = CWP.PROJECT AND CWP_CWA.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  ---- sample:#(lf)#(tab)-- LEFT JOIN DATAREL Property4_REL ON Property4_REL.UID1 = CWP.CWPUID AND Property4_REL.DEFUID = '<RELDEFUID>' AND Property4_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)-- LEFT JOIN DATAOBJ Property4_OBJ ON Property4_OBJ.OBJUID = Property4_REL.UID2 AND Property4_OBJ.CONFIG = CWP.PROJECT AND Property4_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)-- LEFT JOIN DATAOBJPR Property4 ON Property4.OBJOBID = Property4_OBJ.OBID AND Property4.PROPERTYDEFUID = '<PROPERTYDEFUID>' AND Property4.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)--#endregion "" Relationship other end properties ""#(lf)),#(lf)#(lf)SPCCWP AS #(lf)(#(lf)#(lf)SELECT#(lf)    -- Section #6a: IObject properties#(lf)#(tab)  t1.CWPOBID, CWPUID, PROJECT, -- sample: Prop1Column,#(lf)    -- Section #6b: Direct properties #(lf)        #(lf)    NAME, DESCRIPTION, EWPNUMBER, BUDGETEDLABORHOURS, #(lf)    PLANNEDSTARTDATE, #(lf)    PLANNEDFINISHDATE, #(lf)    ACTUALSTARTDATE, #(lf)    ACTUALFINISHDATE, #(lf)    EARLYSTARTDATE,#(tab)#(lf)    EARLYFINISHDATE, #(lf)    LATESTARTDATE, #(lf)    LATEFINISHDATE,#(tab)#(lf)    #(lf)    WBSPATH, -- sample: Prop2Column,#(lf)#(tab)  -- Section #6c: Direct properties (Enum type)#(tab)#(tab)#(tab) #(lf)    DISCIPLINE, -- sample: Prop3Column,#(lf)    -- Section #6d: Properties from related objects#(tab) #(lf)    DESIGNAREA, CWAOBID -- sample: ,Prop4Column#(tab)  #(lf)FROM SPCRPT_CWP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_CWP_DIRECT_PROP_TMP t2 ON t2.CWPOBID = t1.CWPOBID#(lf)LEFT JOIN SPCRPT_CWP_DIR_ENUM_PROP_TMP t3 ON t3.CWPOBID = t1.CWPOBID#(lf)LEFT JOIN SPCRPT_CWP_REL_PROP_TMP t4 ON t4.CWPOBID = t1.CWPOBID#(lf)),#(lf)SPCRPT_WORKSTEP_IOBJ_PROP_TMP as (#(lf)SELECT#(lf)            COMPWORKSTEP.OBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP.OBJUID AS ""COMPWORKSTEPUID"",#(tab)  #(lf)            COMPWORKSTEP.CONFIG AS ""PROJECT""#(lf)FROM DATAOBJ COMPWORKSTEP WHERE COMPWORKSTEP.OBJDEFUID = 'SPC_ComponentWorkTypeStep' AND COMPWORKSTEP.TERMINATIONDATE = '9999/12/31-23:59:59:999'),#(lf)#(lf)SPCRPT_WORKSTEP_DIR_PROP_TMP as (#(lf)SELECT#(lf)            COMPWORKSTEP.COMPWORKSTEPOBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP_NAME.STRVALUE AS ""NAME"", #(lf)            COMPWORKSTEP_DESCRIPTION.STRVALUE AS ""DESCRIPTION"",#(lf)            CAST(COMPWORKSTEP_SEQUENCE.STRVALUE AS INT) AS ""SEQUENCE"",#(lf)            CAST(COMPWORKSTEP_UNITRATE.STRVALUE AS FLOAT) AS ""UNITRATE"",#(lf)            COMPWORKSTEP_RATEUOM.STRVALUE AS ""RATEUOM"",#(lf)            COMPWORKSTEP_NOTES.STRVALUE AS ""NOTES"",#(lf)            CAST(COMPWORKSTEP_PLANNEDMANHOURS.STRVALUE AS FLOAT) AS ""PLANNEDMANHOURS"",#(lf)            CAST(COMPWORKSTEP_ACTUALMANHOURS.STRVALUE AS FLOAT) AS ""ACTUALMANHOURS"",#(lf)            COMPWORKSTEP_DATECOMPLETE.STRVALUE AS ""ACTUALDATECOMPLETE"",#(lf)            CAST(COMPWORKSTEP_QUANTITYCOMPLETE.STRVALUE AS FLOAT) AS ""QUANTITYCOMPLETE"",#(lf)            COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONDATE,#(lf)            COMPWORKSTEP_QUANTITYCOMPLETE.CREATIONUSER #(lf)            #(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP COMPWORKSTEP#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_NAME ON COMPWORKSTEP_NAME.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_NAME.PROPERTYDEFUID = 'Name' AND COMPWORKSTEP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_DESCRIPTION ON COMPWORKSTEP_DESCRIPTION.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_DESCRIPTION.PROPERTYDEFUID = 'Description' AND COMPWORKSTEP_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_SEQUENCE ON COMPWORKSTEP_SEQUENCE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_SEQUENCE.PROPERTYDEFUID = 'ComponentWorkTypeStep_Sequence' AND COMPWORKSTEP_SEQUENCE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_UNITRATE ON COMPWORKSTEP_UNITRATE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_UNITRATE.PROPERTYDEFUID = 'ComponentWorkTypeStep_UnitRate' AND COMPWORKSTEP_UNITRATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_RATEUOM ON COMPWORKSTEP_RATEUOM.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_RATEUOM.PROPERTYDEFUID = 'ComponentWorkTypeStep_RateUoM' AND COMPWORKSTEP_RATEUOM.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_NOTES ON COMPWORKSTEP_NOTES.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_NOTES.PROPERTYDEFUID = 'ComponentWorkTypeStep_Notes' AND COMPWORKSTEP_NOTES.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_PLANNEDMANHOURS ON COMPWORKSTEP_PLANNEDMANHOURS.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_PLANNEDMANHOURS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ManHours' AND COMPWORKSTEP_PLANNEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_ACTUALMANHOURS ON COMPWORKSTEP_ACTUALMANHOURS.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_ACTUALMANHOURS.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualHours' AND COMPWORKSTEP_ACTUALMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_DATECOMPLETE ON COMPWORKSTEP_DATECOMPLETE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_DATECOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_ActualDateComplete' AND COMPWORKSTEP_DATECOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)  LEFT JOIN DATAOBJPR COMPWORKSTEP_QUANTITYCOMPLETE ON COMPWORKSTEP_QUANTITYCOMPLETE.OBJOBID = COMPWORKSTEP.COMPWORKSTEPOBID AND COMPWORKSTEP_QUANTITYCOMPLETE.PROPERTYDEFUID = 'ComponentWorkTypeStep_QuantityComplete' AND COMPWORKSTEP_QUANTITYCOMPLETE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(lf)),#(lf)#(lf)SPCRPT_WORKSTEP_REL_PROP_TMP as (#(lf)SELECT#(lf)            COMPWORKSTEP.COMPWORKSTEPOBID AS ""COMPWORKSTEPOBID"",#(lf)            COMPWORKSTEP_WORKTYPE_COSTCODE.STRVALUE AS ""COSTCODE"",#(lf)            COMPWORKSTEP_FIWP.OBID AS ""FIWPOBID"",#(tab)  #(lf)            COMPWORKSTEP_WORKTYPE.OBID AS ""WORKTYPEOBID"",#(lf)            COMPWORKSTEP_COMP.OBID AS ""COMPOBID"",#(lf)            CAST(COMPONENTITEM_QUANTITYPLANNED.STRVALUE AS FLOAT) AS ""QUANTITYPLANNED"",#(lf)            #(lf)            CAST(COMPONENTITEM_UNITS.STRVALUE AS FLOAT) AS ""UNITS""#(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP COMPWORKSTEP#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_FIWP_REL ON COMPWORKSTEP_FIWP_REL.UID2 = COMPWORKSTEP.COMPWORKSTEPUID  AND COMPWORKSTEP_FIWP_REL.DEFUID = 'SPC_Package_ComponentWorkTypeStep' AND COMPWORKSTEP_FIWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_FIWP ON COMPWORKSTEP_FIWP.OBJUID = COMPWORKSTEP_FIWP_REL.UID1 AND COMPWORKSTEP_FIWP.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_FIWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_WORKTYPE_REL ON COMPWORKSTEP_WORKTYPE_REL.UID2 = COMPWORKSTEP.COMPWORKSTEPUID AND COMPWORKSTEP_WORKTYPE_REL.DEFUID = 'SPC_ComponentWorkType_ComponentWorkTypeSteps' AND COMPWORKSTEP_WORKTYPE_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_WORKTYPE ON COMPWORKSTEP_WORKTYPE.OBJUID = COMPWORKSTEP_WORKTYPE_REL.UID1 AND COMPWORKSTEP_WORKTYPE.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_WORKTYPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPWORKSTEP_WORKTYPE_COSTCODE ON COMPWORKSTEP_WORKTYPE_COSTCODE.OBJOBID = COMPWORKSTEP_WORKTYPE.OBID AND COMPWORKSTEP_WORKTYPE_COSTCODE.PROPERTYDEFUID = 'ComponentWorkType_CostCode' AND COMPWORKSTEP_WORKTYPE_COSTCODE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL COMPWORKSTEP_COMP_REL ON COMPWORKSTEP_COMP_REL.UID2 = COMPWORKSTEP_WORKTYPE.OBJUID AND COMPWORKSTEP_COMP_REL.DEFUID = 'SPC_ComponentItem_ComponentWorkType' AND COMPWORKSTEP_COMP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ COMPWORKSTEP_COMP ON COMPWORKSTEP_COMP.OBJUID = COMPWORKSTEP_COMP_REL.UID1 AND COMPWORKSTEP_COMP.CONFIG = COMPWORKSTEP.PROJECT AND COMPWORKSTEP_COMP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_QUANTITYPLANNED ON COMPONENTITEM_QUANTITYPLANNED.OBJOBID = COMPWORKSTEP_COMP.OBID AND COMPONENTITEM_QUANTITYPLANNED.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_QUANTITYPLANNED.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR COMPONENTITEM_UNITS ON COMPONENTITEM_UNITS.OBJOBID = COMPWORKSTEP_COMP.OBID AND COMPONENTITEM_UNITS.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_UNITS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)#(lf)#(lf)WorkStepsX as (#(lf)SELECT#(lf)#(lf)#(tab)    t1.COMPWORKSTEPOBID, COMPWORKSTEPUID, PROJECT, #(lf)      NAME, DESCRIPTION, SEQUENCE, UNITRATE, RATEUOM, NOTES, PLANNEDMANHOURS,  CASE WHEN NVL(t3.UNITS,0)=0 then 0 else CASE WHEN NVL(QUANTITYCOMPLETE,0)/ NVL(t3.UNITS,0)>1 THEN 1 ELSE NVL(QUANTITYCOMPLETE,0)/ NVL(t3.UNITS,0) END * NVL(PLANNEDMANHOURS,0) end as ACTUALMANHOURS, #(lf)      ACTUALDATECOMPLETE,  NVL(QUANTITYCOMPLETE,0) as UNIT_COMPLETED,#(lf)      CASE WHEN NVL(t3.UNITS,0)>0 THEN #(lf)      CASE WHEN NVL(QUANTITYCOMPLETE,0)/ NVL(t3.UNITS,0) * NVL(PLANNEDMANHOURS,0)>=PLANNEDMANHOURS THEN 1 ELSE 0 END      #(lf)      END AS QUANTITYCOMPLETE, COSTCODE, FIWPOBID, WORKTYPEOBID, COMPOBID, QUANTITYPLANNED, CREATIONUSER, CREATIONDATE, t3.UNITS , QUANTITYPLANNED as PLAN_UNITS#(lf)      #(lf)FROM SPCRPT_WORKSTEP_IOBJ_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_WORKSTEP_DIR_PROP_TMP t2 ON t2.COMPWORKSTEPOBID = t1.COMPWORKSTEPOBID#(lf)LEFT JOIN SPCRPT_WORKSTEP_REL_PROP_TMP t3 ON t3.COMPWORKSTEPOBID = t1.COMPWORKSTEPOBID),#(lf)#(lf)--Select * From WorkStepsX where FIWPOBID = 'FIWP_C10DL4I5B139706'#(lf)#(lf)WorkSteps as #(lf)(#(lf)#(lf)  SELECT COMPWORKSTEPOBID, COMPWORKSTEPUID, PROJECT, NAME, DESCRIPTION, SEQUENCE, UNITRATE, RATEUOM, NOTES, PLANNEDMANHOURS, ACTUALMANHOURS, ACTUALDATECOMPLETE, #(lf)  QUANTITYCOMPLETE, COSTCODE, FIWPOBID, WORKTYPEOBID, COMPOBID, CREATIONUSER, CREATIONDATE, UNITS , COUNT(DISTINCT COMPOBID) AS QUANTITYPLANNED, sum(PLAN_UNITS) as PLAN_UNITS, SUM( DISTINCT UNIT_COMPLETED) as UNIT_COMPLETED,#(lf)  CASE WHEN PLANNEDMANHOURS=0 then 0 else CASE WHEN (ACTUALMANHOURS / PLANNEDMANHOURS)>=1 THEN 1 ELSE 0 END END as Gate_QTYComplete#(lf)  FROM WorkStepsX#(lf)  GROUP by COMPWORKSTEPOBID, COMPWORKSTEPUID, PROJECT, NAME, DESCRIPTION, SEQUENCE, UNITRATE, RATEUOM, NOTES, PLANNEDMANHOURS, ACTUALMANHOURS, ACTUALDATECOMPLETE, #(lf)  QUANTITYCOMPLETE, COSTCODE, FIWPOBID, WORKTYPEOBID, COMPOBID, CREATIONUSER, CREATIONDATE, UNITS#(lf)  #(lf)),#(lf)#(lf)#(lf) SPCRPT_COMP_IOBJECT_PROP_TMP as (#(lf)SELECT #(lf)            COMPONENTITEM.OBID AS ""COMPOBID"",#(lf)            COMPONENTITEM.OBJUID AS ""COMPUID"",#(lf)            COMPONENTITEM.CONFIG AS ""PROJECT""#(lf)FROM DATAOBJ COMPONENTITEM WHERE COMPONENTITEM.OBJDEFUID IN ('SPC_ComponentItem', 'SPC_AdhocComponentItem',  'SPC_NonPublishedComponentItem', 'SPC_Spool', 'SPC_Assembly') AND COMPONENTITEM.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)#(lf)SPCRPT_COMP_DIRECT_PROP_TMP as (#(lf)SELECT #(lf)            COMPONENTITEM.COMPOBID AS ""COMPOBID"",#(lf)            COMPONENTITEM_NAME.STRVALUE AS ""NAME"", #(lf)            COMPONENTITEM_DESCRIPTION.STRVALUE AS ""DESCRIPTION"",#(tab)  #(lf)            COMPONENTITEM_MATERIAL.STRVALUE AS ""MATERIAL"",#(tab)  #(lf)            COMPONENTITEM_RATING.STRVALUE AS ""RATING"",#(tab)  #(lf)            COMPONENTITEM_CLASS.STRVALUE AS ""CLASS"",#(tab)  #(lf)            CAST(COMPONENTITEM_SIZE.STRVALUE AS FLOAT) AS ""COMPSIZE"",#(tab)  #(lf)            COMPONENTITEM_THICKNESS.STRVALUE AS ""THICKNESS"",#(tab)  #(lf)            CAST(COMPONENTITEM_UNITS.STRVALUE AS FLOAT) AS ""UNITS"",#(lf)            COMPONENTITEM_COMMODITYCODE.STRVALUE AS ""COMMODITYCODE"",#(lf)            COMPONENTITEM_DRAWINGTITLE.STRVALUE AS ""DRAWINGTITLE"",#(lf)            COMPONENTITEM_DRAWINGREVISION.STRVALUE AS ""DRAWINGREVISION"",#(lf)            COMPONENTITEM_REVISIONDATE.STRVALUE AS ""REVISIONDATE"",#(lf)            COMPONENTITEM_TRANSMITTALNO.STRVALUE AS ""TRANSMITTALNO"",#(lf)            COMPONENTITEM_COMPONENTSTATUS.STRVALUE AS ""COMPONENTSTATUS""#(lf)FROM SPCRPT_COMP_IOBJECT_PROP_TMP COMPONENTITEM#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_NAME ON COMPONENTITEM_NAME.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_NAME.PROPERTYDEFUID = 'Name' AND COMPONENTITEM_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DESCRIPTION ON COMPONENTITEM_DESCRIPTION.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DESCRIPTION.PROPERTYDEFUID = 'SPC_ComponentItem_ShortDescription' AND COMPONENTITEM_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)    LEFT JOIN DATAOBJPR COMPONENTITEM_MATERIAL ON COMPONENTITEM_MATERIAL.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_MATERIAL.PROPERTYDEFUID = 'SPC_ComponentItem_Material' AND COMPONENTITEM_MATERIAL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_RATING ON COMPONENTITEM_RATING.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_RATING.PROPERTYDEFUID = 'SPC_ComponentItem_Rating' AND COMPONENTITEM_RATING.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)    LEFT JOIN DATAOBJPR COMPONENTITEM_CLASS ON COMPONENTITEM_CLASS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_CLASS.PROPERTYDEFUID = 'SpcNonPublishedClassDesignation' AND COMPONENTITEM_CLASS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_SIZE ON COMPONENTITEM_SIZE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_SIZE.PROPERTYDEFUID = 'SPC_ComponentItem_Size' AND COMPONENTITEM_SIZE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_THICKNESS ON COMPONENTITEM_THICKNESS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_THICKNESS.PROPERTYDEFUID = 'SPC_ComponentItem_Thickness' AND COMPONENTITEM_THICKNESS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_UNITS ON COMPONENTITEM_UNITS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_UNITS.PROPERTYDEFUID = 'SPC_ComponentItem_Units' AND COMPONENTITEM_UNITS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_COMMODITYCODE ON COMPONENTITEM_COMMODITYCODE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_COMMODITYCODE.PROPERTYDEFUID = 'SPC_ComponentItem_CommodityCode' AND COMPONENTITEM_COMMODITYCODE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DRAWINGTITLE ON COMPONENTITEM_DRAWINGTITLE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DRAWINGTITLE.PROPERTYDEFUID = 'MDR_IDOCS_DrawingTitle' AND COMPONENTITEM_DRAWINGTITLE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_DRAWINGREVISION ON COMPONENTITEM_DRAWINGREVISION.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_DRAWINGREVISION.PROPERTYDEFUID = 'MDR_IDOCS_DrawingRevision' AND COMPONENTITEM_DRAWINGREVISION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_REVISIONDATE ON COMPONENTITEM_REVISIONDATE.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_REVISIONDATE.PROPERTYDEFUID = 'MDR_IDOCS_RevisionDate' AND COMPONENTITEM_REVISIONDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_TRANSMITTALNO ON COMPONENTITEM_TRANSMITTALNO.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_TRANSMITTALNO.PROPERTYDEFUID = 'MDR_IDOCS_TransmittalNo' AND COMPONENTITEM_TRANSMITTALNO.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR COMPONENTITEM_COMPONENTSTATUS ON COMPONENTITEM_COMPONENTSTATUS.OBJOBID = COMPONENTITEM.COMPOBID AND COMPONENTITEM_COMPONENTSTATUS.PROPERTYDEFUID = 'MDR_ComponentStatus' AND COMPONENTITEM_COMPONENTSTATUS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)),#(lf)SPCRPT_COMPONENTITEM1 as (#(lf)SELECT#(lf)      #(lf)#(tab)    t1.COMPOBID, COMPUID, PROJECT,     #(lf)#(tab)    NAME, DESCRIPTION, MATERIAL, RATING, CLASS, COMPSIZE, THICKNESS, UNITS, COMMODITYCODE,DRAWINGTITLE,DRAWINGREVISION,REVISIONDATE,TRANSMITTALNO,COMPONENTSTATUS#(lf)FROM SPCRPT_COMP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_COMP_DIRECT_PROP_TMP t2 ON t2.COMPOBID = t1.COMPOBID),#(lf)#(lf)SPCRPT_FIWP_IOBJECT_PROP_TMP as (#(lf)#(lf)SELECT #(lf)            FIWP.OBID AS ""FIWPOBID"",#(lf)            FIWP.OBJUID AS ""FIWPUID"",#(lf)            FIWP.CONFIG AS ""PROJECT"",#(lf)            FIWP.CREATIONUSER, FIWP.CREATIONDATE#(lf)FROM DATAOBJ FIWP WHERE FIWP.OBJDEFUID = 'SPC_FIWP' AND FIWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'),#(lf)#(lf) SPCRPT_FIWP_DIRECT_PROP_TMP  as (#(lf)#(lf)SELECT #(lf)            FIWP.FIWPOBID AS ""FIWPOBID"",#(lf)             FIWP_NAME.STRVALUE AS ""NAME"", #(lf)            FIWP_DESCRIPTION.STRVALUE AS ""DESCRIPTION"", #(lf)            TO_DATE(FIWP_PLANNEDSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDSTARTDATE"",            #(lf)            TO_DATE(FIWP_PLANNEDFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""PLANNEDFINISHDATE"",#(lf)            TO_DATE(FIWP_ACTUALSTARTDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALSTARTDATE"",#(lf)            TO_DATE(FIWP_ACTUALFINISHDATE.STRVALUE, 'YYYY/MM/DD') AS ""ACTUALFINISHDATE"",#(lf)            CAST(FIWP_ESTIMATEDMANHOURS.STRVALUE AS FLOAT) AS ""ESTIMATEDMANHOURS"",#(lf)            FIWP_SCOPE.STRVALUE AS ""SCOPE"",#(lf)            FIWP_NOTES.STRVALUE AS ""NOTES"",#(lf)            CAST(FIWP_CREWSIZE.STRVALUE AS INT) AS ""CREWSIZE"", #(lf)            FIWP_EWPNUMBER.STRVALUE AS ""EWPNUMBER"",#(lf)            FIWP_CREWDURATION.STRVALUE AS ""CREWDURATION"",#(lf)            FIWP.FIWPUID as ""UID"",#(lf)           CAST( FIWP_PREVPROGRESS.STRVALUE AS FLOAT) as ""PREV_PROGRESS"",#(lf)           CAST( FIWP_PREVEARNED.STRVALUE AS FLOAT)  as ""PREV_EARNED"",#(lf)           CAST(FIWP_PREVWKLYEARNED.STRVALUE AS FLOAT)  as ""PREV_WKLYEARNED""#(lf)           #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_NAME ON FIWP_NAME.OBJOBID = FIWP.FIWPOBID AND FIWP_NAME.PROPERTYDEFUID = 'Name' AND FIWP_NAME.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DESCRIPTION ON FIWP_DESCRIPTION.OBJOBID = FIWP.FIWPOBID AND FIWP_DESCRIPTION.PROPERTYDEFUID = 'Description' AND FIWP_DESCRIPTION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PLANNEDSTARTDATE ON FIWP_PLANNEDSTARTDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_PLANNEDSTARTDATE.PROPERTYDEFUID = 'FIWP_PlannedStartDate' AND FIWP_PLANNEDSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PLANNEDFINISHDATE ON FIWP_PLANNEDFINISHDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_PLANNEDFINISHDATE.PROPERTYDEFUID = 'FIWP_PlannedFinishDate' AND FIWP_PLANNEDFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALSTARTDATE ON FIWP_ACTUALSTARTDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_ACTUALSTARTDATE.PROPERTYDEFUID = 'FIWP_ActualStartDate'  AND FIWP_ACTUALSTARTDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALFINISHDATE ON FIWP_ACTUALFINISHDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_ACTUALFINISHDATE.PROPERTYDEFUID = 'FIWP_ActualFinishDate'  AND FIWP_ACTUALFINISHDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ESTIMATEDMANHOURS ON FIWP_ESTIMATEDMANHOURS.OBJOBID = FIWP.FIWPOBID AND FIWP_ESTIMATEDMANHOURS.PROPERTYDEFUID = 'FIWP_Estimated_Manhours'  AND FIWP_ESTIMATEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_SCOPE ON FIWP_SCOPE.OBJOBID = FIWP.FIWPOBID AND FIWP_SCOPE.PROPERTYDEFUID = 'FIWP_Scope' AND FIWP_SCOPE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_NOTES ON FIWP_NOTES.OBJOBID = FIWP.FIWPOBID AND FIWP_NOTES.PROPERTYDEFUID like 'FIWP_Notes' AND FIWP_NOTES.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CREWSIZE ON FIWP_CREWSIZE.OBJOBID = FIWP.FIWPOBID AND FIWP_CREWSIZE.PROPERTYDEFUID = 'FIWP_Crew_Size' AND FIWP_CREWSIZE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_EWPNUMBER ON FIWP_EWPNUMBER.OBJOBID = FIWP.FIWPOBID AND FIWP_EWPNUMBER.PROPERTYDEFUID = 'FIWP_EWP_Number' AND FIWP_EWPNUMBER.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CREWDURATION ON FIWP_CREWDURATION.OBJOBID = FIWP.FIWPOBID AND FIWP_CREWDURATION.PROPERTYDEFUID = 'SPC_CrewDuration' AND FIWP_CREWDURATION.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  #(lf)  LEFT JOIN DATAOBJPR FIWP_PREVPROGRESS ON FIWP_PREVPROGRESS.OBJOBID = FIWP.FIWPOBID AND FIWP_PREVPROGRESS.PROPERTYDEFUID = 'MDR_PreviousProgress' AND FIWP_PREVPROGRESS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR FIWP_PREVEARNED ON FIWP_PREVEARNED.OBJOBID = FIWP.FIWPOBID AND FIWP_PREVEARNED.PROPERTYDEFUID = 'MDR_PreviousEarned' AND FIWP_PREVEARNED.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR FIWP_PREVWKLYEARNED ON FIWP_PREVWKLYEARNED.OBJOBID = FIWP.FIWPOBID AND FIWP_PREVWKLYEARNED.PROPERTYDEFUID = 'MDR_PrevWeeklyEarned' AND FIWP_PREVWKLYEARNED.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)  ),#(lf)  #(lf)SPCRPT_FIWP_DIR_ENUM_PROP_TMP as ( #(lf)  SELECT #(lf)            FIWP.FIWPOBID AS ""FIWPOBID"",#(lf)            FIWP_PURPOSE.OBJNAME AS ""PURPOSE"",#(lf)            FIWP_DISCIPLINE.OBJNAME AS ""DISCIPLINE"",#(lf)            FIWP_STATUS.OBJNAME AS ""STATUS"" #(lf)            #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_PURPOSE_PR ON FIWP_PURPOSE_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_PURPOSE_PR.PROPERTYDEFUID = 'FIWP_Purpose' AND FIWP_PURPOSE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_PURPOSE ON FIWP_PURPOSE.OBJUID = FIWP_PURPOSE_PR.STRVALUE AND FIWP_PURPOSE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DISCIPLINE_PR ON FIWP_DISCIPLINE_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_DISCIPLINE_PR.PROPERTYDEFUID = 'FIWP_Discipline' AND FIWP_DISCIPLINE_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_DISCIPLINE ON FIWP_DISCIPLINE.OBJUID = FIWP_DISCIPLINE_PR.STRVALUE AND FIWP_DISCIPLINE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)  LEFT JOIN DATAOBJPR FIWP_STATUS_PR ON FIWP_STATUS_PR.OBJOBID = FIWP.FIWPOBID AND FIWP_STATUS_PR.PROPERTYDEFUID = 'Package_Status' AND FIWP_STATUS_PR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_STATUS ON FIWP_STATUS.OBJUID = FIWP_STATUS_PR.STRVALUE AND FIWP_STATUS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)--  WHERE  FIWP_STATUS.OBJNAME != 'Preliminary'#(lf)  #(lf)#(tab)),#(lf)#(lf)SPCRPT_FIWP_REL_PROP_TMP as (#(lf)  SELECT#(lf)            FIWP.FIWPOBID AS ""FIWPOBID"",#(lf)            CAST(FIWP_PLANNEDMANHOURS.STRVALUE AS FLOAT) AS ""PLANNEDMANHOURS"",#(lf)            CAST(FIWP_ACTUALMANHOURS.STRVALUE AS FLOAT) AS ""ACTUALMANHOURS"",#(lf)            CAST(FIWP_COMPLETEDMANHOURS.STRVALUE AS FLOAT) AS ""COMPLETEDMANHOURS"",#(lf)            CAST(FIWP_COMPONENTTOTALCONSTRAINTS.STRVALUE AS INT) AS ""TOTALCOMPONENTCONSTRAINTS"",#(lf)            CAST(FIWP_COMPONENTOPENCONSTRAINTS.STRVALUE AS INT) AS ""OPENCOMPONENTCONSTRAINTS"",#(lf)            FIWP_CONTRACT.STRVALUE AS ""CONTRACT"",#(lf)            FIWP_CONTRACTOR.STRVALUE AS ""CONTRACTOR"",#(lf)            FIWP_DESIGNAREA.STRVALUE AS ""DESIGNAREA"",#(lf)            FIWP_FOREMAN.STRVALUE AS ""FOREMAN"",#(lf)            FIWP_GENERALFOREMAN.STRVALUE AS ""GENERALFOREMAN"",#(lf)            FIWP_FIELDENGINEER.STRVALUE AS ""FIELDENGINEER"",#(lf)            FIWP_SUPERINTENDENT.STRVALUE AS ""SUPERINTENDENT"",#(lf)            FIWP_ISSUEDBY.STRVALUE AS ""ISSUEDBY"",#(lf)            FIWP_NAMEDCREW.OBID AS ""CREWOBID"",#(lf)            FIWP_CWP.OBID AS ""CWPOBID"",#(lf)            FIWP_REVDATE.STRVALUE AS ""REVDATE"",#(lf)            FIWP_RECEDATE.STRVALUE AS ""RECEDATE"",#(lf)            enumpr.objname AS ""WP_REVNO"",#(lf)            FIWP_TaskNo.STRVALUE AS ""FIWPTASKNO"",#(lf)            CAST(FIWP_Estimated.STRVALUE AS FLOAT) AS ""FIWPAFCHRS"",#(lf)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)FIWP_MDRWeightage.STRVALUE AS ""WEIGHTAGE"",#(lf)            FIWP_MDRResourceCode.STRVALUE AS ""RESOURCECODE"",#(lf)#(tab)#(tab)#(tab) #(lf)#(tab)#(tab)#(tab)FIWP_MDRWorkPhase.STRVALUE AS ""WORKPHASE"",#(lf)#(tab)#(tab)#(tab)FIWP_MDRProgressGrouping.STRVALUE AS ""PROGRESSGROUPING""#(lf)          #(lf)#(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP FIWP#(lf)#(tab)LEFT JOIN DATAREL FIWP_PACKAGEROLLUPDATE_REL ON FIWP_PACKAGEROLLUPDATE_REL.UID1 = FIWP.FIWPUID AND FIWP_PACKAGEROLLUPDATE_REL.DEFUID = 'SPC_Package_PackageRollupData' AND FIWP_PACKAGEROLLUPDATE_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_PACKAGEROLLUPDATE ON FIWP_PACKAGEROLLUPDATE.OBJUID = FIWP_PACKAGEROLLUPDATE_REL.UID2 AND FIWP_PACKAGEROLLUPDATE.CONFIG = FIWP.PROJECT AND FIWP_PACKAGEROLLUPDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)  LEFT JOIN DATAOBJPR FIWP_PLANNEDMANHOURS ON FIWP_PLANNEDMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_PLANNEDMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalManHours' AND FIWP_PLANNEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_ACTUALMANHOURS ON FIWP_ACTUALMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_ACTUALMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalActualManHours' AND FIWP_ACTUALMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_COMPLETEDMANHOURS ON FIWP_COMPLETEDMANHOURS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPLETEDMANHOURS.PROPERTYDEFUID = 'PackageRollupData_TotalManHoursCompleted' AND FIWP_COMPLETEDMANHOURS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_COMPONENTTOTALCONSTRAINTS ON FIWP_COMPONENTTOTALCONSTRAINTS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPONENTTOTALCONSTRAINTS.PROPERTYDEFUID = 'PackageRollupData_TotalConstraints' AND FIWP_COMPONENTTOTALCONSTRAINTS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_COMPONENTOPENCONSTRAINTS ON FIWP_COMPONENTOPENCONSTRAINTS.OBJOBID = FIWP_PACKAGEROLLUPDATE.OBID AND FIWP_COMPONENTOPENCONSTRAINTS.PROPERTYDEFUID = 'PackageRollupData_OpenConstraints' AND FIWP_COMPONENTOPENCONSTRAINTS.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_CONTRACT_REL ON FIWP_CONTRACT_REL.UID1 = FIWP.FIWPUID AND FIWP_CONTRACT_REL.DEFUID = 'SPC_Package_Contract' AND FIWP_CONTRACT_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CONTRACT_OBJ ON FIWP_CONTRACT_OBJ.OBJUID = FIWP_CONTRACT_REL.UID2 AND FIWP_CONTRACT_OBJ.CONFIG = FIWP.PROJECT AND FIWP_CONTRACT_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CONTRACT ON FIWP_CONTRACT.OBJOBID = FIWP_CONTRACT_OBJ.OBID AND FIWP_CONTRACT.PROPERTYDEFUID = 'Description' AND FIWP_CONTRACT.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)  LEFT JOIN DATAREL FIWP_CONTRACTOR_REL ON FIWP_CONTRACTOR_REL.UID1 = FIWP.FIWPUID AND FIWP_CONTRACTOR_REL.DEFUID = 'SPC_Package_Contractor' AND FIWP_CONTRACTOR_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CONTRACTOR_OBJ ON FIWP_CONTRACTOR_OBJ.OBJUID = FIWP_CONTRACTOR_REL.UID2 AND FIWP_CONTRACTOR_OBJ.CONFIG = FIWP.PROJECT AND FIWP_CONTRACTOR_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_CONTRACTOR ON FIWP_CONTRACTOR.OBJOBID = FIWP_CONTRACTOR_OBJ.OBID AND FIWP_CONTRACTOR.PROPERTYDEFUID = 'Name' AND FIWP_CONTRACTOR.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_DESIGNAREA_REL ON FIWP_DESIGNAREA_REL.UID1 = FIWP.FIWPUID AND FIWP_DESIGNAREA_REL.DEFUID = 'SPC_FunctionalArea_FIWPs' AND FIWP_DESIGNAREA_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_DESIGNAREA_OBJ ON FIWP_DESIGNAREA_OBJ.OBJUID = FIWP_DESIGNAREA_REL.UID1 AND FIWP_DESIGNAREA_OBJ.CONFIG = FIWP.PROJECT AND FIWP_DESIGNAREA_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_DESIGNAREA ON FIWP_DESIGNAREA.OBJOBID = FIWP_DESIGNAREA_OBJ.OBID AND FIWP_DESIGNAREA.PROPERTYDEFUID = 'Name' AND FIWP_DESIGNAREA.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--LEFT JOIN DATAREL FIWP_FOREMAN_REL ON FIWP_FOREMAN_REL.UID1 = FIWP.FIWPUID AND FIWP_FOREMAN_REL.DEFUID = 'SPC_Package_ForemanRole' AND FIWP_FOREMAN_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)LEFT JOIN#(lf)  (#(lf)    select DENSE_RANK() OVER (PARTITION BY UID1 ORDER BY CREATIONDATE DESC) AS SEQUENCE , UID1, UID2, CREATIONDATE#(lf)    FROM SCHEMAREL where  DEFUID='SPC_Package_ForemanRole'#(lf)    AND TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)  ) FIWP_FOREMAN_REL ON FIWP_FOREMAN_REL.UID1=FIWP.FIWPUID AND FIWP_FOREMAN_REL.SEQUENCE=1#(lf)#(tab)#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_FOREMAN_OBJ ON FIWP_FOREMAN_OBJ.OBJUID = FIWP_FOREMAN_REL.UID2 AND FIWP_FOREMAN_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJPR FIWP_FOREMAN ON FIWP_FOREMAN.OBJOBID = FIWP_FOREMAN_OBJ.OBID AND FIWP_FOREMAN.PROPERTYDEFUID = 'Name' AND FIWP_FOREMAN.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)#(lf)#(tab)--LEFT JOIN DATAREL FIWP_GENERALFOREMAN_REL ON FIWP_GENERALFOREMAN_REL.UID1 = FIWP.FIWPUID AND FIWP_GENERALFOREMAN_REL.DEFUID = 'SPC_Package_GeneralForemanRole' AND FIWP_GENERALFOREMAN_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)LEFT JOIN#(lf)  (#(lf)    select DENSE_RANK() OVER (PARTITION BY UID1 ORDER BY CREATIONDATE DESC) AS SEQUENCE , UID1, UID2, CREATIONDATE#(lf)    FROM SCHEMAREL where  DEFUID='SPC_Package_GeneralForemanRole'#(lf)    AND TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)  ) FIWP_GENERALFOREMAN_REL ON FIWP_GENERALFOREMAN_REL.UID1=FIWP.FIWPUID AND FIWP_GENERALFOREMAN_REL.SEQUENCE=1#(lf)#(tab)#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_GENERALFOREMAN_OBJ ON FIWP_GENERALFOREMAN_OBJ.OBJUID = FIWP_GENERALFOREMAN_REL.UID2 AND FIWP_GENERALFOREMAN_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJPR FIWP_GENERALFOREMAN ON FIWP_GENERALFOREMAN.OBJOBID = FIWP_GENERALFOREMAN_OBJ.OBID AND FIWP_GENERALFOREMAN.PROPERTYDEFUID = 'Name' AND FIWP_GENERALFOREMAN.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)#(lf)#(tab)LEFT JOIN SCHEMAREL FIWP_FIELDENGINEER_REL ON FIWP_FIELDENGINEER_REL.UID1 = FIWP.FIWPUID AND FIWP_FIELDENGINEER_REL.DEFUID = 'SPC_Package_FieldEngineerRole' AND FIWP_FIELDENGINEER_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_FIELDENGINEER_OBJ ON FIWP_FIELDENGINEER_OBJ.OBJUID = FIWP_FIELDENGINEER_REL.UID2 AND FIWP_FIELDENGINEER_OBJ.CONFIG = FIWP.PROJECT AND FIWP_FIELDENGINEER_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJPR FIWP_FIELDENGINEER ON FIWP_FIELDENGINEER.OBJOBID = FIWP_FIELDENGINEER_OBJ.OBID AND FIWP_FIELDENGINEER.PROPERTYDEFUID = 'Name' AND FIWP_FIELDENGINEER.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAREL FIWP_SUPERINTENDENT_REL ON FIWP_SUPERINTENDENT_REL.UID1 = FIWP.FIWPUID AND FIWP_SUPERINTENDENT_REL.DEFUID = 'SPC_Package_SuperintendentRole' AND FIWP_SUPERINTENDENT_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_SUPERINTENDENT_OBJ ON FIWP_SUPERINTENDENT_OBJ.OBJUID = FIWP_SUPERINTENDENT_REL.UID2 AND FIWP_SUPERINTENDENT_OBJ.CONFIG = FIWP.PROJECT AND FIWP_SUPERINTENDENT_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJPR FIWP_SUPERINTENDENT ON FIWP_SUPERINTENDENT.OBJOBID = FIWP_SUPERINTENDENT_OBJ.OBID AND FIWP_SUPERINTENDENT.PROPERTYDEFUID = 'Name' AND FIWP_SUPERINTENDENT.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(tab)#(lf)  LEFT JOIN SCHEMAREL FIWP_ISSUEDBY_REL ON FIWP_ISSUEDBY_REL.UID1 = FIWP.FIWPUID AND FIWP_ISSUEDBY_REL.DEFUID = 'SPC_Package_IWPIssuedBy' AND FIWP_ISSUEDBY_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJ FIWP_ISSUEDBY_OBJ ON FIWP_ISSUEDBY_OBJ.OBJUID = FIWP_ISSUEDBY_REL.UID2 AND  FIWP_ISSUEDBY_OBJ.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN SCHEMAOBJPR FIWP_ISSUEDBY ON FIWP_ISSUEDBY.OBJOBID = FIWP_ISSUEDBY_OBJ.OBID AND FIWP_ISSUEDBY.PROPERTYDEFUID = 'Name' AND FIWP_ISSUEDBY.TERMINATIONDATE = '9999/12/31-23:59:59:999' #(lf)  LEFT JOIN DATAREL FIWP_NAMEDCREW_REL ON FIWP_NAMEDCREW_REL.UID1 = FIWP.FIWPUID AND FIWP_NAMEDCREW_REL.DEFUID = 'SPC_Package_Crew' AND FIWP_NAMEDCREW_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_NAMEDCREW ON FIWP_NAMEDCREW.OBJUID = FIWP_NAMEDCREW_REL.UID2 AND FIWP_NAMEDCREW.CONFIG = FIWP.PROJECT AND FIWP_NAMEDCREW.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAREL FIWP_CWP_REL ON FIWP_CWP_REL.UID2 = FIWP.FIWPUID AND FIWP_CWP_REL.DEFUID = 'SPC_CWP_FIWPs' AND FIWP_CWP_REL.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJ FIWP_CWP ON FIWP_CWP.OBJUID = FIWP_CWP_REL.UID1 AND FIWP_CWP.CONFIG = FIWP.PROJECT AND FIWP_CWP.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)      #(tab)--IWP REVDATE#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_REVDATE ON FIWP_REVDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_REVDATE.PROPERTYDEFUID = 'MDR_RevDate' AND FIWP_REVDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_REV ON FIWP_REV.OBJOBID = FIWP.FIWPOBID AND FIWP_REV.PROPERTYDEFUID = 'MDR_Rev' AND FIWP_REV.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(tab)#(lf)  left join schemaobj enumpr on FIWP_REV.strvalue=enumpr.objuid and enumpr.objdefuid='EnumEnum' and enumpr.terminationdate='9999/12/31-23:59:59:999'#(lf)--where pr.propertydefuid='MDR_Rev' and pr.OBJOBID = '1SRI000A' #(lf)  #(lf)#(tab)--IWP RECEDATE#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_RECEDATE ON FIWP_RECEDATE.OBJOBID = FIWP.FIWPOBID AND FIWP_RECEDATE.PROPERTYDEFUID = 'MDR_RecievedDate' AND FIWP_RECEDATE.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--FIWP TASK NO#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_TaskNo ON FIWP_TaskNo.OBJOBID = FIWP.FIWPOBID AND FIWP_TaskNo.PROPERTYDEFUID = 'MDR_FIWPTaskNo' AND FIWP_TaskNo.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--FIWP AFC Hrs#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_Estimated ON FIWP_Estimated.OBJOBID = FIWP.FIWPOBID AND FIWP_Estimated.PROPERTYDEFUID = 'FIWP_Estimated_Manhours' AND FIWP_Estimated.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)#(tab)--MDR_Weld_Weightage#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_MDRWeightage ON FIWP_MDRWeightage.OBJOBID = FIWP.FIWPOBID AND FIWP_MDRWeightage.PROPERTYDEFUID = 'MDR_Weld_Weightage' AND FIWP_MDRWeightage.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--MDR_ResourceCode#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_MDRResourceCode ON FIWP_MDRResourceCode.OBJOBID = FIWP.FIWPOBID AND FIWP_MDRResourceCode.PROPERTYDEFUID = 'MDR_ResourceCode' AND FIWP_MDRResourceCode.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)--MDR_ProgressGrouping#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_MDRProgressGrouping ON FIWP_MDRProgressGrouping.OBJOBID = FIWP.FIWPOBID AND FIWP_MDRProgressGrouping.PROPERTYDEFUID = 'MDR_ProgressGrouping' AND FIWP_MDRProgressGrouping.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(lf)#(tab)--MDR_WorkPhase#(lf)#(tab)LEFT JOIN DATAOBJPR FIWP_MDRWorkPhase ON FIWP_MDRWorkPhase.OBJOBID = FIWP.FIWPOBID AND FIWP_MDRWorkPhase.PROPERTYDEFUID = 'MDR_WorkPhase' AND FIWP_MDRWorkPhase.TERMINATIONDATE = '9999/12/31-23:59:59:999'#(lf)#(tab)#(lf)#(tab)#(lf)),#(lf)#(lf)COMBINED AS #(lf)(#(lf) #(lf)  SELECT DISTINCT#(lf)    t1.FIWPUID,#(lf)    t1.PROJECT AS ""PROJECT"",#(lf)    t3.DISCIPLINE,#(lf)    t2.NAME AS ""WPNO"",#(lf)    t2.DESCRIPTION as ""WPDESCRIPTION"",#(lf)    t5.COSTCODE  AS ""ACTIVITYCODE"",#(tab)#(lf)    --T6.NAME AS ""NAME"",     #(lf)    T5.SEQUENCE ,#(lf)    sum(T5.ACTUALMANHOURS) AS ""COMPLETEDMANHOURS"",#(lf)    SUM(NULLIF(T5.PLANNEDMANHOURS,0)) AS ""PLANNEDHOURS"",#(lf)    --NVL(AVG(round((t5.QUANTITYCOMPLETE/t6.UNITS) * 100,1)),0) AS ""PERCCOMP"",#(lf)    t4.CWPOBID, t4.REVDATE, t4.RECEDATE, t4.FIWPTASKNO, t4.FIWPAFCHRS as FIWPAFCHRS ,t4.FIWPOBID,   t1.CREATIONUSER, t1.CREATIONDATE,#(lf)    t4.WEIGHTAGE ,t4.RESOURCECODE,t4.WORKPHASE,t4.PROGRESSGROUPING,#(lf)    NULLIF(t2.PREV_PROGRESS,0)  as ""PREV_PROGRESS"",#(lf)    NULLIF(t2.PREV_EARNED,0)  as ""PREV_EARNED"",#(lf)    NULLIF(t2.PREV_WKLYEARNED,0) as ""PREV_WKLYEARNED"" ,#(lf)    t5.RATEUOM, t3.PURPOSE, t4.CONTRACTOR as ""AREA"", t4.FOREMAN as ""FOREMAN"",t4.GENERALFOREMAN as ""GENERALFOREMAN"",t4.ISSUEDBY as ""ISSUEDBY"", t3.STATUS,#(lf)    t2.PLANNEDSTARTDATE, t2.PLANNEDFINISHDATE, t2.ACTUALSTARTDATE, t2.ACTUALFINISHDATE, SUM(t5.PLAN_UNITS) as PLAN_UNITS, SUM(t5.UNIT_COMPLETED) as UNIT_COMPLETED, t4.WP_REVNO#(lf)    #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_FIWP_DIRECT_PROP_TMP t2 ON t2.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_FIWP_DIR_ENUM_PROP_TMP t3 ON t3.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_FIWP_REL_PROP_TMP t4 ON t4.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN WORKSTEPS t5 ON t5.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN SPCRPT_COMPONENTITEM1 t6 ON t6.COMPOBID = t5.COMPOBID#(lf)--WHERE t5.PLANNEDMANHOURS > 0#(lf)--WHERE t3.STATUS='Issued For Construction' and t5.PLANNEDMANHOURS > 0 #(lf)GROUP BY t1.FIWPUID, T2.NAME, t2.DESCRIPTION, T1.PROJECT, T5.COSTCODE, t3.DISCIPLINE, T5.SEQUENCE , T4.CWPOBID, COMPLETEDMANHOURS,  t4.CWPOBID , #(lf)t4.REVDATE, t4.RECEDATE, t4.FIWPTASKNO, t4.FIWPOBID , t1.CREATIONUSER, t1.CREATIONDATE,  t2.PREV_PROGRESS,  t2.PREV_EARNED, t2.PREV_WKLYEARNED, t5.RATEUOM, t3.PURPOSE, t4.CONTRACTOR , t4.FOREMAN,t4.GENERALFOREMAN, t4.ISSUEDBY,t3.STATUS,#(lf)  t2.PLANNEDSTARTDATE, t2.PLANNEDFINISHDATE, t2.ACTUALSTARTDATE, t2.ACTUALFINISHDATE , t4.WP_REVNO, t4.FIWPAFCHRS, t4.WEIGHTAGE ,t4.RESOURCECODE,t4.WORKPHASE,t4.PROGRESSGROUPING#(lf)),#(lf)#(lf) #(lf)BY_WORKPACK AS #(lf)(#(lf) #(lf)  SELECT distinct#(lf)    t1.PROJECT AS ""PROJECT"",#(lf)    t2.NAME AS ""WPNO"",#(lf)    t5.CREATIONUSER, t5.CREATIONDATE#(lf)    #(lf)FROM SPCRPT_FIWP_IOBJECT_PROP_TMP t1#(lf)LEFT JOIN SPCRPT_FIWP_DIRECT_PROP_TMP t2 ON t2.FIWPOBID = t1.FIWPOBID#(lf)LEFT JOIN WORKSTEPS t5 ON t5.FIWPOBID = t1.FIWPOBID#(lf)#(lf)), #(lf)#(lf)GET_USERINFO as#(lf)(#(lf)  SELECT a.* from BY_WORKPACK a#(lf)  inner join#(lf)  (#(lf)    select project, wpno, max(creationdate) as creationdate from BY_WORKPACK group by project, wpno#(lf)  )b#(lf)  on a.project=b.project and a.wpno=b.wpno and a.creationdate=b.creationdate#(lf))#(lf),#(lf)#(lf)TOTALPLANHRS as#(lf)(#(lf)  SELECT DISTINCT B.DESIGNAREA AS JOBNO, A.ACTIVITYCODE AS ACTIVITYCODE, A.WPNO, A.FIWPUID,-- A.FIWPOBID as FIWPOBIDx,#(lf)  C.PLANNEDHOURS as PLANNEDHOURS, #(lf)  C.COMPLETEDMANHOURS - C.PLANNEDHOURS  as ""BALANCE"", C.CUMPROGRESS, C.UNIT_COMPLETED, C.PLAN_UNITS,  C.CUMPROGRESS * C.PLANNEDHOURS as CUMEARNED#(lf)  FROM  COMBINED A#(lf)  LEFT JOIN SPCCWP B ON A.CWPOBID = B.CWPOBID #(lf)  LEFT JOIN #(lf)  (#(lf)      select FIWPOBID, sum(PLANNEDHOURS) as PLANNEDHOURS, SUM(COMPLETEDMANHOURS) as COMPLETEDMANHOURS, SUM(PLAN_UNITS) as PLAN_UNITS,#(lf)      SUM(UNIT_COMPLETED) as UNIT_COMPLETED, SUM(COMPLETEDMANHOURS) / SUM(PLANNEDHOURS) as CUMPROGRESS, SUM(CUMEARNED) as CUMEARNED#(lf)      FROM#(lf)      (#(lf)      #(lf)       SELECT   FIWPOBID,  SUM(NULLIF(PLANNEDMANHOURS,0)) as PLANNEDHOURS, sum(ActualManHours) as COMPLETEDMANHOURS, sum(Plan_units)/ count(*) as PLAN_UNITS, #(lf)       sum(Unit_Completed) / count(*) as UNIT_COMPLETED, (sum(ActualManHours) /  SUM(NULLIF(PLANNEDMANHOURS,0))) as CUMPROGRESS,   #(lf)            (sum(ActualManHours) /  SUM(NULLIF(PLANNEDMANHOURS,0))) *   SUM(NULLIF(PLANNEDMANHOURS,0)) as CUMEARNED#(lf)            from WorkSteps #(lf)         --   where fiwpobid='2XCC000A'#(lf)            Group by FIWPOBID, COMPOBID#(lf)      ) XX GROUP BY FIWPOBID#(lf)       #(lf)  ) C ON C.FIWPOBID=A.FIWPOBID-- AND INSTR(A.WPNO, A.ACTIVITYCODE)>0#(lf)--  WHERE  INSTR(A.WPNO, A.ACTIVITYCODE)>0#(lf)  #(lf)),#(lf)FIWPTOTAL AS#(lf)(#(lf)      SELECT FIWPUID, #(lf)       SUM(QUANTITYCOMPLETE) as ""FIWP_QTYCOMPLETE"" , #(lf)       SUM(QUANTITYPLANNED) as  ""FIWP_QTYPLAN"", #(lf)       SUM(PLANNEDMANHOURS)  as ""FIWP_PLANH"", #(lf)       SUM(ACTUALMANHOURS)   as ""FIWP_ACTUAL""#(lf)       FROM#(lf)       (#(lf)        SELECT t1x.FIWPUID, t5x.COMPOBID, t5x.PROJECT,  t5x.FIWPOBID, SUM(t5x.ACTUALMANHOURS) as ACTUALMANHOURS, SUM(t5x.PLANNEDMANHOURS) as PLANNEDMANHOURS, #(lf)                                             AVG(t5x.QUANTITYCOMPLETE) as QUANTITYCOMPLETE, AVG(t5x.QUANTITYPLANNED) as QUANTITYPLANNED #(lf)        FROM WORKSTEPS t5x#(lf)        LEFT JOIN SPCRPT_FIWP_IOBJECT_PROP_TMP t1x ON t5x.FIWPOBID = t1x.FIWPOBID#(lf)        GROUP BY t1x.FIWPUID, t5x.COMPOBID, t5x.PROJECT,  t5x.FIWPOBID#(lf)        #(lf)       ) X#(lf)       GROUP BY FIWPUID  #(lf)),#(lf)#(lf)#(lf)BYGATES1 AS#(lf)(#(lf)    SELECT t1.FIWPUID, t5.Name, t5.sequence,  SUM(NULLIF(t5.PLANNEDMANHOURS,0))  as ""PLANH"", ROUND(SUM(NULLIF(t5.ACTUALMANHOURS,0)),2) as ""ACTUAL"" , SUM(t5.UNIT_COMPLETED) as UNIT_COMPLETED, #(lf)   -- CASE WHEN SUM(t5.PLAN_UNITS)=0 THEN 0 ELSE CASE WHEN SUM(t5.UNIT_COMPLETED) / SUM(t5.PLAN_UNITS)>1 THEN 1 ELSE SUM(t5.UNIT_COMPLETED) / SUM(t5.PLAN_UNITS) END  END as ""GATEPROGRESS"" #(lf)  CASE WHEN SUM(t5.PLANNEDMANHOURS)=0 THEN 0 ELSE CASE WHEN SUM(t5.ACTUALMANHOURS) / SUM(t5.PLANNEDMANHOURS)>1 THEN 1 ELSE SUM(t5.ACTUALMANHOURS) / SUM(t5.PLANNEDMANHOURS) END  END as ""GATEPROGRESS"",#(lf)  sum(t5.Gate_QTYComplete) as ""GATEQTY_COMPLETE"" #(lf)  FROM SPCRPT_FIWP_IOBJECT_PROP_TMP t1#(lf)    LEFT JOIN WORKSTEPS t5 ON t5.FIWPOBID = t1.FIWPOBID    #(lf)    --LEFT JOIN FIWPTOTAL t6 ON t6.FIWPUID = t1.FIWPUID    #(lf)    GROUP BY t1.FIWPUID,t5.sequence, t5.Name#(lf)    ORDER By t5.sequence#(lf)   #(lf)) ,#(lf)--Select * From BYGATES1 Where FIWPUID ='FIWP_C10DL4I5B139706'#(lf)#(lf)BYGATES AS#(lf)(#(lf)    SELECT FIWPUID ,Name,ROW_NUMBER() OVER (PARTITION BY FIWPUID ORDER BY Sequence Asc) As Sequence,Planh,Actual,UNIT_Completed,GATEPROGRESS,Gateqty_Complete,#(lf)    Sequence As Seqno#(lf)    FROM BYGATES1#(lf)) ,#(lf)--Select * From BYGATES Where FIWPUID ='FIWP_C10DL4I5B139706'#(lf)COUNTINFO as#(lf)(#(lf)   SELECT FIWPUID, SUM(TOTAL) as COUNT_COMPLETE , SUM(PLANNED) as COUNT_PLANNED#(lf)   FROM#(lf)   (#(lf)    select FIWPUID, COMPOBID, MAX(SEQUENCE), SUM(ISDONE), CASE WHEN MAX(SEQUENCE)= SUM(ISDONE) THEN 1 ELSE 0 END as TOTAL, 1 as PLANNED#(lf)    FROM#(lf)    (#(lf)         SELECT  FIWPUID, COMPOBID, NAME, SEQUENCE, CASE WHEN PLANNEDMANHOURS <= ACTUALMANHOURS THEN 1 else 0 end as IsDONE#(lf)         FROM SPCRPT_FIWP_IOBJECT_PROP_TMP t1x#(lf)         LEFT JOIN WORKSTEPS t5x ON t5x.FIWPOBID = t1x.FIWPOBID#(lf)        ORDER BY t1x.FIWPUID , COMPOBID#(lf)   ) A#(lf)   GROUP BY FIWPUID, COMPOBID#(lf)   ) B#(lf)   GROUP BY FIWPUID#(lf)#(lf)),#(lf)GATE as#(lf)(#(lf)  SELECT a.FIWPUID, G1.NAME as G1 , G2.NAME as G2  , G3.NAME as G3  , G4.NAME as G4  , G5.NAME as G5  , G6.NAME as G6,G7.NAME as G7,G8.NAME as G8,#(lf)                    G1.PLANH as G1H , G2.PLANH as G2H , G3.PLANH as G3H ,  G4.PLANH as G4H ,  G5.PLANH as G5H , G6.PLANH as G6H, G7.PLANH as G7H,G8.PLANH as G8H,#(lf)                    G1.ACTUAL as G1A , G2.ACTUAL as G2A , G3.ACTUAL as G3A ,  G4.ACTUAL as G4A ,  G5.ACTUAL as G5A , G6.ACTUAL as G6A,G7.ACTUAL as G7A,G8.ACTUAL as G8A,#(lf)                    t6.FIWP_QTYPLAN as QTYPLANNED, t6.FIWP_QTYCOMPLETE as QTYCOMPLETE, t6.FIWP_ACTUAL as FIWP_ACTUAL, C1.COUNT_COMPLETE, C1.COUNT_PLANNED, #(lf)                    G1.UNIT_COMPLETED as UNIT_COMPLETED_1, #(lf)                    G2.UNIT_COMPLETED as UNIT_COMPLETED_2, #(lf)                    G3.UNIT_COMPLETED as UNIT_COMPLETED_3, #(lf)                    G4.UNIT_COMPLETED as UNIT_COMPLETED_4, #(lf)                    G5.UNIT_COMPLETED as UNIT_COMPLETED_5, #(lf)                    G6.UNIT_COMPLETED as UNIT_COMPLETED_6,#(lf)                    G7.UNIT_COMPLETED as UNIT_COMPLETED_7,#(lf)                    G8.UNIT_COMPLETED as UNIT_COMPLETED_8,#(lf)                    G1.GATEPROGRESS as G1_PROGRESS, #(lf)                    G2.GATEPROGRESS as G2_PROGRESS,#(lf)                    G3.GATEPROGRESS as G3_PROGRESS,#(lf)                    G4.GATEPROGRESS as G4_PROGRESS,#(lf)                    G5.GATEPROGRESS as G5_PROGRESS,#(lf)                    G6.GATEPROGRESS as G6_PROGRESS,#(lf)                    G7.GATEPROGRESS as G7_PROGRESS,#(lf)                    G8.GATEPROGRESS as G8_PROGRESS,#(lf)                    G1.GATEQTY_COMPLETE as G1_QTYCOMPLETE,#(lf)                    G2.GATEQTY_COMPLETE as G2_QTYCOMPLETE,#(lf)                    G3.GATEQTY_COMPLETE as G3_QTYCOMPLETE,#(lf)                    G4.GATEQTY_COMPLETE as G4_QTYCOMPLETE,#(lf)                    G5.GATEQTY_COMPLETE as G5_QTYCOMPLETE,#(lf)                    G6.GATEQTY_COMPLETE as G6_QTYCOMPLETE,#(lf)                    G7.GATEQTY_COMPLETE as G7_QTYCOMPLETE,#(lf)                    G8.GATEQTY_COMPLETE as G8_QTYCOMPLETE#(lf)  FROM SPCRPT_FIWP_IOBJECT_PROP_TMP a#(lf)  LEFT JOIN FIWPTOTAL t6 ON t6.FIWPUID = A.FIWPUID  #(lf)  LEFT JOIN COUNTINFO C1 on C1.FIWPUID=A.FIWPUID#(lf)  LEFT JOIN BYGATES G1 on A.FIWPUID=G1.FIWPUID AND G1.sequence=1#(lf)  LEFT JOIN BYGATES G2 on A.FIWPUID=G2.FIWPUID AND G2.sequence=2#(lf)  LEFT JOIN BYGATES G3 on A.FIWPUID=G3.FIWPUID AND G3.sequence=3#(lf)  LEFT JOIN BYGATES G4 on A.FIWPUID=G4.FIWPUID AND G4.sequence=4#(lf)  LEFT JOIN BYGATES G5 on A.FIWPUID=G5.FIWPUID AND G5.sequence=5#(lf)  LEFT JOIN BYGATES G6 on A.FIWPUID=G6.FIWPUID AND G6.sequence=6#(lf)  LEFT JOIN BYGATES G7 on A.FIWPUID=G7.FIWPUID AND G7.sequence=7#(lf)  LEFT JOIN BYGATES G8 on A.FIWPUID=G8.FIWPUID AND G8.sequence=8#(lf)),#(lf)#(lf)--Select * From GATE where FIWPUID ='FIWP_C10DL4I5B139706'#(lf)REGISTER AS #(lf)(#(lf)  SELECT distinct A.FIWPUID,  A.PROJECT, FIWPOBID,#(lf)  A.FIWPTASKNO,#(lf)  --B.WBSPATH AS ""TASK NO"", #(lf)  A.FIWPTASKNO AS ""TASK NO"",#(lf)  B.DESIGNAREA AS ""JOB NO"", A.ACTIVITYCODE AS ""ACTIVITY CODE"", A.DISCIPLINE,  B.NAME as ""ACTIVITY ID"",  #(lf)  A.WPNO, A.WPDESCRIPTION as ""WP DESCRIPTION"",#(lf)  A.WP_REVNO,#(lf)  B.DESCRIPTION AS ""ACTIVITY ID DESCRIPTION"",#(lf)  --ROUND((B.BUDGETEDLABORHOURS),2) AS ""AFC Hrs"",#(lf)  #(lf)  --SUM(ROUND((A.FIWPAFCHRS),2)) AS ""AFC Hrs"",#(lf)  ROUND(A.FIWPAFCHRS,2) AS ""AFC Hrs"",#(lf)  --A.SEQUENCE, #(lf)  C.PLANNEDHOURS as ""WP Hrs"", #(lf)  --ROUND((B.BUDGETEDLABORHOURS),2) - C.PLANNEDHOURS as ""AFC WP DELTA Hrs"",#(lf) #(lf)  ROUND((A.FIWPAFCHRS),2) - C.PLANNEDHOURS as ""AFC WP DELTA Hrs"", #(lf)#(lf) #(lf)#(lf)  CASE WHEN  ROUND((A.FIWPAFCHRS),2)<=C.PLANNEDHOURS  THEN  CASE WHEN C.CUMPROGRESS>1 THEN 1 ELSE C.CUMPROGRESS END  ELSE ROUND(C.CUMEARNED/ROUND((A.FIWPAFCHRS),2),4) END   AS ""AFC Progress"",#(lf) #(lf)  --ROUND((CASE WHEN C.PLANNEDHOURS < ROUND((B.BUDGETEDLABORHOURS),2) THEN ROUND(C.CUMEARNED/ROUND((B.BUDGETEDLABORHOURS),2),4)  ELSE  C.CUMPROGRESS END) * ROUND--((B.BUDGETEDLABORHOURS),2),2) AS ""AFC Earned Hrs"",#(lf)#(lf)  CASE WHEN  ROUND((A.FIWPAFCHRS),2)<=C.PLANNEDHOURS  THEN  CASE WHEN C.CUMPROGRESS>1 THEN 1 ELSE C.CUMPROGRESS END  ELSE ROUND(C.CUMEARNED/ROUND((A.FIWPAFCHRS),2),4) END * A.FIWPAFCHRS  AS ""AFC Earned Hrs"",#(lf) #(lf)--ROUND((CASE WHEN C.PLANNEDHOURS < ROUND((B.BUDGETEDLABORHOURS),2) THEN ROUND(C.CUMEARNED/ROUND((B.BUDGETEDLABORHOURS),2),4)  ELSE  C.CUMPROGRESS END) * ROUND((B.BUDGETEDLABORHOURS),2),2) #(lf)--ROUND(C.CUMEARNED,2) As ""AFC WP Earned Delta Hrs"" ,#(lf)#(lf)ROUND((CASE WHEN C.PLANNEDHOURS < ROUND((A.FIWPAFCHRS),2) THEN ROUND(C.CUMEARNED/ROUND((A.FIWPAFCHRS),2),4)  ELSE  C.CUMPROGRESS END)  * ROUND((A.FIWPAFCHRS),2),2) -#(lf)ROUND(C.CUMEARNED,2) As ""AFC WP Earned Delta Hrs"" ,#(lf)#(lf)#(lf)--CASE WHEN C.PLANNEDHOURS < ROUND((B.BUDGETEDLABORHOURS),2) THEN ROUND(C.CUMEARNED/ROUND((B.BUDGETEDLABORHOURS),2),4)  ELSE  C.CUMPROGRESS END -  C.CUMPROGRESS #(lf)--As  ""AFC WP Progress Delta"",#(lf)#(lf)CASE WHEN C.PLANNEDHOURS < ROUND((A.FIWPAFCHRS),2) THEN ROUND(C.CUMEARNED/ROUND((A.FIWPAFCHRS),2),4)  ELSE  C.CUMPROGRESS END -  C.CUMPROGRESS #(lf)As  ""AFC WP Progress Delta"",#(lf)#(lf)  C.CUMPROGRESS  as ""WP Progress"",#(lf)  ROUND(C.CUMEARNED,2) as ""WP Earned Hrs"",#(lf)  E.QTYPLANNED AS ""WP Components Qty Planned"", #(lf)  E.QTYCOMPLETE AS ""WP Components Qty Complete"", #(lf)  C.PLAN_UNITS as PLAN_UNITS, C.PLAN_UNITS * C.CUMPROGRESS  as COMPLETED_UNITS,#(lf)  #(lf)  --A.RATEUOM,#(lf)  ' ' as RATEUOM,#(lf)  A.PURPOSE AS ""WP PURPOSE"",#(lf)  NVL(A.PREV_PROGRESS,0) as ""WP Last Week Progress"",#(lf)  NVL(A.PREV_EARNED,0) as ""WP Last Week Earned"",#(lf)  NVL(A.PREV_WKLYEARNED,0) as ""WP Last Week Weekly Earned"",#(lf)  NVL(C.CUMPROGRESS,0) -  NVL(A.PREV_PROGRESS,0) as ""WP Weekly Progress"",#(lf)  ROUND(NVL(C.CUMEARNED,0),3) -  ROUND(NVL(A.PREV_EARNED,0),3)  as ""WP Weekly Earned"",#(lf)  E.COUNT_COMPLETE AS ""WP Components Count Complete"", #(lf)E.COUNT_PLANNED AS ""WP Components Count Planned"", #(lf)A.AREA, A.STATUS#(lf)  ,A.REVDATE AS ""WP Revision Date"", #(lf)A.RECEDATE AS ""WP Receive Date"", #(lf)D.CREATIONUSER as ""WP Last Progress By"", SUBSTR(D.CREATIONDATE,1, 10) as ""WP Last Progress Date"", A.CREATIONUSER AS ""WP Creation User"", #(lf)SUBSTR(A.CREATIONDATE,1,10) as ""WP Creation Date"",#(lf)A.FOREMAN as ""Foreman"",#(lf)A.GENERALFOREMAN as ""General Foreman"",#(lf)A.ISSUEDBY as ""IWP Issued By"",  #(lf)  A.PLANNEDSTARTDATE AS ""WP Planned Start Date"",#(lf)  A.PLANNEDFINISHDATE AS ""WP Planned Finish Date"",#(lf)  A.ACTUALSTARTDATE AS ""WP Actual Start Date"", #(lf)  A.ACTUALFINISHDATE AS ""WP Actual Finish Date"",#(lf)  B.EARLYSTARTDATE AS ""L3 Forecast Start Date"", #(lf)  B.EARLYFINISHDATE AS ""L3 Forecast Finish Date"", #(lf)  B.LATESTARTDATE AS ""L3 Baseline Start Date"", #(lf)  B.LATEFINISHDATE AS ""L3 Baseline Finish Date"", #(lf)#(lf)  --C.BALANCE,#(lf) #(lf)  --CASE WHEN SUM(A.COMPLETEDMANHOURS)>SUM(A.PLANNEDHOURS) THEN 1 ELSE ROUND(SUM(A.COMPLETEDMANHOURS) / NULLIF(SUM(A.PLANNEDHOURS),0), 4) END as ""PERCCOMP"" #(lf)#(lf)  --GATES#(lf)  E.G1 AS ""ROC 1"", E.G2 AS ""ROC 2"", E.G3 AS ""ROC 3"", E.G4 AS ""ROC 4"", E.G5 AS ""ROC 5"", E.G6 AS ""ROC 6"",  E.G7 AS ""ROC 7"", E.G8 AS ""ROC 8"",#(lf)  #(lf)  --WEIGHTAGES#(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G1H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 1"",   #(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G2H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 2"",   #(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G3H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 3"",   #(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G4H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 4"",  #(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUNd(nullif(E.G5H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 5"",  #(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G6H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 6"", #(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G7H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 7"",#(lf)  CASE WHEN ROUND(E.G1H/nullif(C.PLANNEDHOURS,0),2)>1 then -1 else ROUND(nullif(E.G8H,0)/nullif(C.PLANNEDHOURS,0),2) end as ""ROC Weightage 8"",#(lf)  #(lf)  --PLANHOURS#(lf)  E.G1H AS 