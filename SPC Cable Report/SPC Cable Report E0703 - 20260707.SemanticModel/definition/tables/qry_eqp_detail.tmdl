		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column fx_installwp_hrs_earned =
			
			SUMX(FILTER(qry_eqp_progress,qry_eqp_progress[COMPONENT]=qry_eqp_detail[COMPONENT]),qry_eqp_progress[fx_wphrs_earned])
