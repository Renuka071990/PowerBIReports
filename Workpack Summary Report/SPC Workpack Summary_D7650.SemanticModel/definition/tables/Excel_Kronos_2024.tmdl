	column FX_WPNO =
			var wpno = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[WPNO],'Qry_IWP Detail'[WPNO],Excel_Kronos_2024[Activity Code]),BLANK())
			var wpno_fitter = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[WPNO],'Qry_IWP Detail'[FX_SPC_Fitter_ActCode],Excel_Kronos_2024[Activity Code]),BLANK())
			var wpno_welder = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[WPNO],'Qry_IWP Detail'[FX_SPC_Welder_ActCode],Excel_Kronos_2024[Activity Code]),BLANK())
			var output = if(wpno<>BLANK(),wpno,
			if(wpno_fitter<>BLANK(),wpno_fitter,
			if(wpno_welder<>BLANK(),wpno_welder,BLANK())))
			return
			IF(output=BLANK(),[Activity Code],output)
		lineageTag: 93320a43-db20-4263-9035-af2012f0bb31
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_LastWeek = if(WEEKDAY(Excel_Kronos_2024[Timesheet_Date]) < 6,(Excel_Kronos_2024[Timesheet_Date]+5) - WEEKDAY(Excel_Kronos_2024[Timesheet_Date]),((Excel_Kronos_2024[Timesheet_Date]+5) - WEEKDAY(Excel_Kronos_2024[Timesheet_Date]))+7)
		dataType: dateTime
		formatString: dd-mmm-yy
		lineageTag: 1f5088e1-b2bf-4ddf-88aa-51ae9f2a3838
