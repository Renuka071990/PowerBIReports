	column fx_lookup_mdm = ```
			
			var a = LOOKUPVALUE('Excel MDM'[WPNO],'Excel MDM'[WPNO],[Activity Code])
			var b = IF([Activity Code]<>BLANK()|| [Activity Code]<>"",LEFT([Activity Code],LEN([Activity Code])-1),[Activity Code])
			var c = LOOKUPVALUE('Excel MDM'[WPNO],'Excel MDM'[WPNO],b)
			var d = IF(a<>BLANK(),a,c)
			RETURN
			d
			
			
			```
		lineageTag: b3cdd6f2-a249-4ab5-b985-6fcab35f1876
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

