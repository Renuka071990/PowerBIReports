	column FX_DstrbHrs-ToGo%
		lineageTag: 325b01f1-e260-4764-b05c-11da4daea0d6
		summarizeBy: sum
		isNameInferred
		sourceColumn: Excel_Distrib-Alloc-ToGo[FX_DstrbHrs-ToGo%]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FIWPOBID
		lineageTag: 1dcd3720-493a-4cc5-ab9d-e7a862220e87
		summarizeBy: none
		isNameInferred
		sourceColumn: Excel_Distrib-Alloc-ToGo[FIWPOBID]

		annotation SummarizationSetBy = Automatic

	column FX_WP_Hrs =
			sumx(
			    FILTER('Qry_IWP Detail','Qry_IWP Detail'[FIWPOBID]=FX_Distribution_Allocation_Count[FIWPOBID]),'Qry_IWP Detail'[WP Hrs])
		lineageTag: 61a03cfe-1dd4-4c53-a486-04ba32ca2c16
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_WP_CompHrs =
			sumx(
			    FILTER('Qry_IWP Detail','Qry_IWP Detail'[FIWPOBID]=FX_Distribution_Allocation_Count[FIWPOBID]),'Qry_IWP Detail'[WP Earned Hrs])
		formatString: #,0
		lineageTag: d12b7949-3a2b-493c-bdac-f6a3d56c8f94
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column FX_Prog = FX_Distribution_Allocation_Count[COMPLETEDHRS]/FX_Distribution_Allocation_Count[PLANNEDMANHRS]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2f55ff28-2045-4b19-adf4-1dbde9438ea1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FX_WP_CompCount =
			sumx(
			    FILTER('Qry_IWP Detail','Qry_IWP Detail'[FIWPOBID]=FX_Distribution_Allocation_Count[FIWPOBID]),'Qry_IWP Detail'[WP Components Count Planned_])
		formatString: 0
		lineageTag: fcd90d98-aea9-41c0-9312-7dfe9a05f238
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FX_Comp_Bal = [FX_WP_CompCount]-([FX_WP_CompCount]*[FX_Prog])
		formatString: #,0
		lineageTag: a8cad04d-6e90-4397-a181-cf3d78ef3db4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column FX_Comp_Bal_Dist = [FX_Comp_Bal]*[FX_DstrbHrs-ToGo%]
		formatString: #,0
		lineageTag: 4d77a286-36d3-40cb-a721-65632f0a11df
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column FX_Quantity_Plan =
			sumx(
			    FILTER('Qry_IWP Detail','Qry_IWP Detail'[FIWPOBID]=FX_Distribution_Allocation_Count[FIWPOBID]),'Qry_IWP Detail'[PLAN_UNITS])
		formatString: #,0
		lineageTag: 51c4de82-d0ba-4ff3-90d3-5d499543a736
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column FX_Quantity_Bal = [FX_Quantity_Plan]-([FX_Quantity_Plan]*[FX_Prog])
		lineageTag: 4611e1d8-d0b8-4146-a06e-41027cde589a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_Quantity_Bal_Dist = [FX_Quantity_Bal]*[FX_DstrbHrs-ToGo%]
		lineageTag: 928997d1-5402-486a-9c27-19c67039930f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_UOM =
			var _uom = CALCULATE(FIRSTNONBLANK('dataflow_ProgressReportHistory'[FX_UOM],1),FILTER('dataflow_ProgressReportHistory',[FIWPOBID]=FX_Distribution_Allocation_Count[FIWPOBID]))
			RETURN
			_uom
		lineageTag: d2b2fa1c-e5e6-417d-9ce9-cb16cb4c6b9a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_UOM-00 = ```
			if([FX_UOM]="kg","t", [FX_UOM]) 
			```
		lineageTag: 4b1cab8f-69cb-4b30-9c8a-9a3f6d93de1b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_Quantity_Bal_Dist-00 = if([FX_UOM-00]="t", [FX_Quantity_Bal_Dist]/1000,[FX_Quantity_Bal_Dist])
		formatString: #,0
		lineageTag: 28029c4a-b0eb-446c-84f0-cd298d7593a1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

