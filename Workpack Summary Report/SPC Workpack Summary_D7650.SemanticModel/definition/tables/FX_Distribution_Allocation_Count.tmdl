		source = SUMMARIZE(FILTER('Excel_Distrib-Alloc-ToGo',[pqry_TYPE]="WPHRS"),[PROJECT],[NAME],[PLANNEDMANHRS],[COMPLETEDHRS],[TOGO],[DESIGNAREA],[FIWPOBID],[DATE],[FX_DstrbHrs-ToGo%],[DISCIPLINE],[CONTRACTOR],[PLAN START],[PLAN FINISH],[DESCRIPTION],'Excel_Distrib-Alloc-ToGo'[FX_STATUS])

