		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_To-go_Status = IF(FX_Distribution_Allocation_Count[PLAN FINISH]<=MIN(FX_Distribution_Allocation_Count[DATE])-7,"Late","On-Sched")
