			IF(ISBLANK('Qry_IWP Detail'[General Foreman]) && NOT(ISBLANK('Qry_IWP Detail'[Foreman])) && 'Qry_IWP Detail'[STATUS]="Issued for Construction","General Foreman",
			IF(ISBLANK('Qry_IWP Detail'[General Foreman]) && ISBLANK('Qry_IWP Detail'[Foreman]) && 'Qry_IWP Detail'[STATUS]="Issued for Construction","Missing Both","No Issue")))
