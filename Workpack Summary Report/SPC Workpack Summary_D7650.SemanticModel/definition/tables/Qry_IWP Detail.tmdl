	column fx_Plan_Duration_Days = if('Qry_IWP Detail'[WP Planned Finish Date] = BLANK() || 'Qry_IWP Detail'[WP Planned Start Date] = BLANK(),BLANK(), (1. * ('Qry_IWP Detail'[WP Planned Finish Date] - 'Qry_IWP Detail'[WP Planned Start Date])))
