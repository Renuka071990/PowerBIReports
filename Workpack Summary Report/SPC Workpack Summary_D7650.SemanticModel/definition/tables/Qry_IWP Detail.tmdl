	column FX_Anomaly_Exists = ```
			if(
			    'Qry_IWP Detail'[fx_anomaly_actcode] <> "Matched" || 
			    'Qry_IWP Detail'[FX_DUPLICATE WP]>1 || 
			    'Qry_IWP Detail'[FX_DateIssue]<>"No Date Issues" ||  
			    'Qry_IWP Detail'[FX_MissingAssignment]<>"No Issue" || 
			    [fx_anomaly_prelim_prog]="Anomaly" ||
			[fx_anomaly_gates_wt_L4] = "Anomaly" ||
			[fx_anomaly_gatesname_L4] = "Anomaly" ||
			[fx_anomaly_negative_ear] = "Negative" ||
			[fx_anomaly_prelim_prog] = "Anomaly" ||
			[fx_anomaly_prog%] = "Anomaly" ||
			[fx_anomaly_pwearn] = "Anomaly"
			    
			    ,"Anomaly","No Anomaly")
			```
		lineageTag: 2c8ccf94-a51c-4df6-a347-dc1c863ec2b8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_DateIssue =
			if('Qry_IWP Detail'[STATUS]="Issued for Construction" && ISBLANK('Qry_IWP Detail'[WP Revision Date]) && (ISBLANK('Qry_IWP Detail'[WP Planned Finish Date]) || ISBLANK('Qry_IWP Detail'[WP Planned Start Date])),"No Planned/Issued Dates",
			if('Qry_IWP Detail'[STATUS]="Issued for Construction" && ISBLANK('Qry_IWP Detail'[WP Revision Date]),"No Issuance Date",
			if('Qry_IWP Detail'[STATUS]="Issued for Construction" && (ISBLANK('Qry_IWP Detail'[WP Planned Finish Date]) || ISBLANK('Qry_IWP Detail'[WP Planned Start Date])),"No Planned Dates","No Date Issues")))
