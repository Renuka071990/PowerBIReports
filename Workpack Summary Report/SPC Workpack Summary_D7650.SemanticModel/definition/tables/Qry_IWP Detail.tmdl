	column fx_anomaly_prog% =
			var old = if([COMPLETED_UNITS]/[PLAN_UNITS]>1,"Anomaly","No Anomaly")
			var roc1 = ROUND([WP Earned Hrs ROC 1],0)/ROUND([WP Hrs ROC 1],0)
			var roc2 = ROUND([WP Earned Hrs ROC 2],0)/ROUND([WP Hrs ROC 2],0)
			var roc3 = ROUND([WP Earned Hrs ROC 3],0)/ROUND([WP Hrs ROC 3],0)
			var roc4 = ROUND([WP Earned Hrs ROC 4],0)/ROUND([WP Hrs ROC 4],0)
			var roc5 = ROUND([WP Earned Hrs ROC 5],0)/ROUND([WP Hrs ROC 5],0)
			var roc6 = ROUND([WP Earned Hrs ROC 6],0)/ROUND([WP Hrs ROC 6],0)
			var output = IF(roc1>1.1 || roc2>1.1 || roc3>1.1 || roc4>1.1 || roc5>1.1 || roc6>1.1, "Anomaly","No Anomaly")
			RETURN
			output
		lineageTag: ce725d9b-a39a-4b25-94e6-90328a680dca
		summarizeBy: none

