	column FX_SPC_Fitter_WPHrs =
			var _fitterweight = (100-'Qry_IWP Detail'[WEIGHTAGE])/100
			                    var _fitterweighthrs = 'Qry_IWP Detail'[WP Hrs]*_fitterweight
			return
			
			if('Qry_IWP Detail'[_FX_SPC_WeldGateCheck]="No Weld Gate",'Qry_IWP Detail'[WP Hrs],_fitterweighthrs)
		lineageTag: 56839bf0-c970-489c-927e-951ee442f64f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_SPC_Welder_WPHrs =
			var _welderweighthrs = 'Qry_IWP Detail'[WP Hrs]*('Qry_IWP Detail'[WEIGHTAGE]/100)
			return
			
			if('Qry_IWP Detail'[_FX_SPC_WeldGateCheck]="No Weld Gate",0,_welderweighthrs)
		lineageTag: 598dcdc0-39e7-4bfa-8897-4edd91af698d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

