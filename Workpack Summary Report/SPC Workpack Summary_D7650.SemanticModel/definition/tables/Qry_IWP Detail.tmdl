	column fx_Actual_Duration_Days =
			
			var actual_0 = [WP Actual Finish Date] - [WP Actual Start Date]
			var actual_inc = TODAY() - [WP Actual Start Date]
			var output = IF([WP Actual Start Date] = BLANK() || ([WP Progress]>=1 && [WP Actual Finish Date]=BLANK()),BLANK(),
			                    IF([WP Progress]<1,actual_inc,actual_0))
			RETURN
			output
		dataType: double
		lineageTag: 8150f336-41a4-4ec4-b8f9-857b736b8562
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

