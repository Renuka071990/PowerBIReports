	column fx_start_status = ```
			
			var currwe = TODAY()
			var output =
			if([WP Earned Hrs]>0,"Start",
			if([WP Planned Start Date]=BLANK(),"No Date",
			if(([WP Earned Hrs]=0 || [WP Earned Hrs]=BLANK())&& [WP Planned Start Date]>=currwe , "On Schedule",
			if(([WP Earned Hrs]=0 || [WP Earned Hrs]=BLANK())&& [WP Planned Start Date]<currwe, "Late"
			))))
			RETURN
			output
			
