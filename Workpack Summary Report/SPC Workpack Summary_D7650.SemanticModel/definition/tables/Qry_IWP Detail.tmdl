		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_WP_Complete = if([WP Progress]>=1,'Qry_IWP Detail'[WPNO]&" - Complete","")
		lineageTag: 23bd680a-5332-4b6d-900f-239dee1aade4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_IWP_Status = if('Qry_IWP Detail'[WP Progress]>= 1, "Complete","Incomplete")
		lineageTag: 0bc2e5b5-6045-4c4a-b615-377a7d49ad6a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_Issued_Status =
			if('Qry_IWP Detail'[STATUS]="Issued for Construction","01-Issued",
			                        if(ISBLANK('Qry_IWP Detail'[WP Planned Start Date]),"04-No Date",
			                            if('Qry_IWP Detail'[fx_planned_issued_date]<=TODAY() && 'Qry_IWP Detail'[STATUS]<>"Issued for Construction","03-Late",
			                                if('Qry_IWP Detail'[fx_planned_issued_date]>TODAY() && 'Qry_IWP Detail'[STATUS]<>"Issued for Construction","02-On Sched",
			                                    "No Data"))))
		lineageTag: 63490895-7929-4ca9-88bb-d081ec27fc6f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FX_Completion_Status =
			if('Qry_IWP Detail'[FX_IWP_Status]="Incomplete" && ISBLANK('Qry_IWP Detail'[WP Planned Finish Date]),"04-No Date",
			if('Qry_IWP Detail'[FX_IWP_Status]="Incomplete" && 'Qry_IWP Detail'[WP Planned Finish Date]<=today() && not(ISBLANK('Qry_IWP Detail'[WP Planned Finish Date])),"03-Late - Incomplete",
			if('Qry_IWP Detail'[FX_IWP_Status]="Incomplete" && 'Qry_IWP Detail'[WP Planned Finish Date]>today(),"02-On Sched - Incomplete",
			if('Qry_IWP Detail'[FX_IWP_Status]="Complete","01-IWP Completed","No Data"))))
		lineageTag: cfa6a476-9a50-47fa-a071-01dae0ddca46
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

