table Qry_IWP_Assignments
	lineageTag: 3fb8cf07-5205-4c3c-94e8-91c385046e6a

	measure mx_constraint_wkly = CALCULATE(DISTINCTCOUNT(Qry_IWP_Assignments[fx_constraint_wkly_earning]),Qry_IWP_Assignments[fx_constraint_wkly_earning]<>BLANK())
		formatString: 0
		lineageTag: 842b187c-bdff-49c7-bc07-df800232cd72

	measure mx_constraint_prevwkly = CALCULATE(DISTINCTCOUNT(Qry_IWP_Assignments[WP_OID]),Qry_IWP_Assignments[fx_constraint_prevwkly_earning]>0 && Qry_IWP_Assignments[fx_constraint]=1)
		formatString: 0
		lineageTag: 26d1a493-66f2-412a-8087-0b437f7a0e81

	measure mx_drill =
			var a = SELECTEDVALUE(Parameter_delete[Parameter Fields])
			RETURN
			SWITCH(a,
			"mx_constraint_wkly",CALCULATE(DISTINCTCOUNT(Qry_IWP_Constraints[WP_OID]),))
		lineageTag: 3c3525c1-6018-4e08-8193-ccf1131ebc96

