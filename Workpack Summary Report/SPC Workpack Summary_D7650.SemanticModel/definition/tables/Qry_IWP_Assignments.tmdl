	column Craft
		dataType: string
		lineageTag: e2e8c4b4-7b4e-43d6-8920-534ea922e1b9
		summarizeBy: none
		sourceColumn: Craft

		annotation SummarizationSetBy = Automatic

	column fx_WPNO_Craft =
			
			var fit = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[FX_SPC_Fitter_ActCode],'Qry_IWP Detail'[qpry_JOBNO_WPNO],Qry_IWP_Assignments[JOB_WPNO]),"Duplicate")
			var weld = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[FX_SPC_Welder_ActCode],'Qry_IWP Detail'[qpry_JOBNO_WPNO],Qry_IWP_Assignments[JOB_WPNO]),"Duplicate")
			var output = IF([Craft]="Welder",weld,fit)
			RETURN
			output
		lineageTag: ed140266-0ca2-4ca9-8c8d-cfba37f349e6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_description = LOOKUPVALUE('Qry_IWP Detail'[WP DESCRIPTION],'Qry_IWP Detail'[fx_job_wpno],[JOB_WPNO])
		lineageTag: 6156c23b-ef45-4e16-90b7-8ad34134c73e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_discipline = LOOKUPVALUE('Qry_IWP Detail'[DISCIPLINE],'Qry_IWP Detail'[FIWPOBID],[WP_OID])
		lineageTag: 957716a8-b245-4761-afce-c98b06f10674
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column WP_OID
		dataType: string
		lineageTag: 06c84252-35b7-44a3-bab5-78f536f53c25
		summarizeBy: none
		sourceColumn: WP_OID

		annotation SummarizationSetBy = Automatic

	column fx_jobno = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[JOB NO],'Qry_IWP Detail'[FIWPOBID],[WP_OID]),"Duplicate")
		lineageTag: cab59812-15f4-4ebb-8785-4548bfb218a6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_craft_no =
			
			IF(CONTAINSSTRING([Craft],"Fitter"),"1. Fitter",
			IF(CONTAINSSTRING([Craft],"Welder"),"2. Welder",
			IF(CONTAINSSTRING([Craft],"Paint"),"3. Painting",BLANK())))
		lineageTag: 3b26ba49-c7d6-4121-bdc1-c762ab40dc58
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_constraint = CALCULATE(MAX(Qry_IWP_Constraints[Value]),FILTER(Qry_IWP_Constraints,Qry_IWP_Constraints[JOB_WPNO]=Qry_IWP_Constraints[JOB_WPNO]))
		formatString: 0
		lineageTag: 393366d7-a96a-4f73-8e74-305f4fce2236
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column fx_constraint_wkly_earning =
			
			var a = CALCULATE(MAX('Qry_IWP Detail'[WP Weekly Earned]),FILTER('Qry_IWP Detail','Qry_IWP Detail'[qpry_JOBNO_WPNO]=Qry_IWP_Assignments[JOB_WPNO]))
			var output = IF(a>=1 && [fx_constraint_status]="Yes",[WP_OID],BLANK())
			RETURN
			output
		dataType: string
		lineageTag: 2c239808-5234-40c0-9e61-4c39e927c24a
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column fx_constraint_prevwkly_earning = CALCULATE(MAX('Qry_IWP Detail'[WP Last Week Weekly Earned]),FILTER('Qry_IWP Detail','Qry_IWP Detail'[qpry_JOBNO_WPNO]=Qry_IWP_Assignments[JOB_WPNO]))
		lineageTag: ea8bdd3b-cab3-4793-8162-18306c20eb14
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column count_oid = COUNTX(FILTER(Qry_IWP_Assignments,Qry_IWP_Assignments[WP_OID]=EARLIER(Qry_IWP_Assignments[WP_OID])),Qry_IWP_Assignments[WP_OID])
		formatString: 0
		lineageTag: 85988c65-8b83-47a1-b4c1-81b3bb14b436
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column fx_constraint_status = IF(CALCULATE(MAX(Qry_IWP_Constraints[Value]),FILTER(Qry_IWP_Constraints,Qry_IWP_Constraints[JOB_WPNO]=[JOB_WPNO]))=1,"Yes","No")
		lineageTag: 182c8a2d-b831-4720-99a1-c1483f2bc927
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

