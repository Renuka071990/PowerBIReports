			    SUMMARIZE('Qry_IWP_Constraints',[JOB NO],[Fitup Foreman],[WPNO]),
			    SUMMARIZE('Qry_IWP_Constraints',[JOB NO],[Fitup Supervisor],[WPNO]),
			    SUMMARIZE('Qry_IWP_Constraints',[JOB NO],[Weld Foreman],[WPNO]),
			    SUMMARIZE('Qry_IWP_Constraints',[JOB NO],[Weld Supervisor],[WPNO])
			    )
		lineageTag: 68dbcfe8-1e13-4af0-b5aa-ee4bac6e9c97
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_fitter_wpno = IFERROR(LOOKUPVALUE('Qry_IWP Detail'[FX_SPC_Fitter_ActCode],'Qry_IWP Detail'[fx_job_wpno],'Qry_IWP_Constraints'[JOB_WPNO]),"Duplicate")
		lineageTag: 1cd6ce7d-dd09-4acb-ab85-910ffd183ba3
