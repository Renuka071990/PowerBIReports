	column fx_constraint_wkly_earning =
			
			var a = CALCULATE(MAX('Qry_IWP Detail'[WP Weekly Earned]),FILTER('Qry_IWP Detail','Qry_IWP Detail'[qpry_JOBNO_WPNO]=Qry_IWP_Constraints[JOB_WPNO]))
			var output = IF(a>=1 && [fx_constraint_status]="Yes","Yes",BLANK())
			RETURN
			output
		lineageTag: b69077de-46b9-4718-a876-cdb7c8934416
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_constraint_status = IF(CALCULATE(MAX(Qry_IWP_Constraints[Value]),FILTER(Qry_IWP_Constraints,Qry_IWP_Constraints[JOB_WPNO]=EARLIER(Qry_IWP_Constraints[JOB_WPNO])))=1,"Yes","No")
		lineageTag: 95dc98ab-03c4-4f91-87bc-5b1c029f72fb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_constraint_prevwkly_earning =
			
			var a = CALCULATE(MAX('Qry_IWP Detail'[WP Last Week Weekly Earned]),FILTER('Qry_IWP Detail','Qry_IWP Detail'[qpry_JOBNO_WPNO]=Qry_IWP_Constraints[JOB_WPNO]))
			var output = IF(a>=1 && [fx_constraint_status]="Yes","Yes",BLANK())
			RETURN
			output
		lineageTag: 121632eb-008f-4a77-8850-a25d848cacb5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Type01
		dataType: string
		lineageTag: 34d64d7d-8fac-4ba3-b102-8092ffe98719
		summarizeBy: none
		sourceColumn: Type01

		annotation SummarizationSetBy = Automatic

	column fx_constraint_week_status =
			
			IF([fx_constraint_status]="Yes" && [fx_constraint_wkly_earning]="Yes" && [fx_constraint_prevwkly_earning]="Yes","Both",
			IF([fx_constraint_status]="Yes" && [fx_constraint_wkly_earning]="Yes" && [fx_constraint_prevwkly_earning]<>"Yes","Current",
			IF([fx_constraint_status]="Yes" && [fx_constraint_wkly_earning]<>"Yes" && [fx_constraint_prevwkly_earning]="Yes","Previous",
			IF([fx_constraint_status]="Yes" && [fx_constraint_wkly_earning]<>"Yes" && [fx_constraint_prevwkly_earning]<>"Yes","All","No constraint"))))
		lineageTag: a542ab25-0dfc-4dde-a6fb-69aed96ac313
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fx_craft_no =
			
			IF(CONTAINSSTRING([Type01],"Fitter"),"1. Fitter",
			IF(CONTAINSSTRING([Type01],"Welder"),"2. Welder",
			IF(CONTAINSSTRING([Type01],"Paint"),"3. Painting",BLANK())))
		lineageTag: 75f2d1be-03f8-41c1-8759-c19d60e4814e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

