table Qry_IWP_Constraints
	lineageTag: 12494d90-1069-4453-a4e3-006b3ca039ca

	measure _mx_hours =
			
			var a = SUMX(VALUES('Qry_IWP_Constraints'[JOB_WPNO]),
			CALCULATE(MAX('Qry_IWP_Constraints'[Hours])))
			RETURN
			IF(a=BLANK(),0,a)
		formatString: #,0
		lineageTag: 5d2efc8a-1868-4c7b-aa5a-745f170bcd36

		annotation PBI_FormatHint = {"isDecimal":true}

	measure _mx_wp_count = CALCULATE(DISTINCTCOUNT('Qry_IWP_Constraints'[WP_OID]),'Qry_IWP_Constraints'[Value]=1)
		formatString: 0
		lineageTag: e0f182b9-7021-40d0-8d17-6308130d1c3e

	measure mx_constraint_wkly_cons = CALCULATE(DISTINCTCOUNT(Qry_IWP_Constraints[WP_OID]),Qry_IWP_Constraints[fx_constraint_wkly_earning]="Yes")
		formatString: 0
		lineageTag: 90f30cf5-783b-4d30-bf59-4a0ea6920b3b

	measure mx_constraint_prevwkly_cons = CALCULATE(DISTINCTCOUNT(Qry_IWP_Constraints[WP_OID]),Qry_IWP_Constraints[fx_constraint_prevwkly_earning]="Yes")
		formatString: 0
		lineageTag: f250d0d1-192c-4e95-87db-3488ec65abeb

	measure mx_constraint_total = CALCULATE(DISTINCTCOUNT(Qry_IWP_Constraints[WP_OID]),Qry_IWP_Constraints[Value]=1)
		formatString: 0
		lineageTag: d6631737-ca14-4591-8df3-7da0e53dc038

