		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column fx_rank = RANKX(FILTER(Qry_IWP_Workstep,[FIWPUID]=EARLIER(Qry_IWP_Workstep[FIWPUID])),[fx_rank_min],,ASC,Dense)
