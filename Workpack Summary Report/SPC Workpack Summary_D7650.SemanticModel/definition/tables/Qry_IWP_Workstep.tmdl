	column fx_rank_min =
			
			var minn = MINX(FILTER(Qry_IWP_Workstep,[NAME]=EARLIER(Qry_IWP_Workstep[NAME]) && [FIWPUID]=EARLIER(Qry_IWP_Workstep[FIWPUID])),[SEQUENCE])
			var rnk = RANKX(FILTER(Qry_IWP_Workstep,[FIWPUID]=EARLIER(Qry_IWP_Workstep[FIWPUID])),minn,,ASC,Dense)
			RETURN
			minn
		lineageTag: cd4796e3-ff51-4d63-af14-d20f412e02e6
