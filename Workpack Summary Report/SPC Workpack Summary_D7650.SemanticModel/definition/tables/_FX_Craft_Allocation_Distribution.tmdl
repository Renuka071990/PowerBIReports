table _FX_Craft_Allocation_Distribution
	lineageTag: 8429a64a-a664-4aa3-842f-22d22b5ee432

	measure 'MX_Line_ManPower Forecast' = CALCULATE(SUMX(FILTER(_FX_Craft_Allocation_Distribution,[Status]="1. Forecast"),[FX_Manpower]),_FX_Craft_Allocation_Distribution[Status]="1. Forecast")
		lineageTag: 4e39315e-96b2-4f75-8a74-1ce70c6915bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MX_Line_ManPower MLF' = CALCULATE(SUMX(FILTER(_FX_Craft_Allocation_Distribution,[Status]="2. MLF"),[FX_Manpower]),_FX_Craft_Allocation_Distribution[Status]="2. MLF")
		lineageTag: afd8fffc-8920-4fde-bcc7-b51d1c7419de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MX_Line_ManPower Actual' = CALCULATE(SUMX(FILTER(_FX_Craft_Allocation_Distribution,[Status]="3. Actual" && _FX_Craft_Allocation_Distribution[FX_LastWeek]<[MX_CurrentWeekEnding]),[FX_Manpower]),_FX_Craft_Allocation_Distribution[Status]="3. Actual")
		lineageTag: a20ae589-6566-41c6-aa82-c0bd1416671a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MX_CF_AlternateColumn2 = ```
			
			var _weekending = SELECTEDVALUE(_FX_Craft_Allocation_Distribution[Status])
			var _RankWeekEndingTable = ALLSELECTED(_FX_Craft_Allocation_Distribution[fx_lastweek])
			var _weekendingRank = 
			RANKX(
			    _RankWeekEndingTable,
			    _FX_Craft_Allocation_Distribution[fx_lastweek],
			    _weekending,ASC,Dense
			)
			var CF = IF(_weekending="MLF" || _weekending=BLANK(),"lightgrey","white")
			RETURN
			CF
			```
		lineageTag: 6965caac-3871-43fb-aa37-ddf5d09b0d0f

	measure MX_ManPower =
			var _manpower = SUM(_FX_Craft_Allocation_Distribution[FX_Manpower])
			RETURN
			if(ISBLANK(_manpower),0,_manpower)
		formatString: 0
		lineageTag: 660327bf-f1fe-4bcd-b30a-12fea09102a4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure MX_Togo =
			var _togo = SUMX(FILTER(_FX_Craft_Allocation_Distribution,[Status]="1. To-Go WPhrs"),[Hours])
			RETURN
			_togo
		formatString: #,0
		lineageTag: 0ced58b6-4519-4bff-a4e0-a83655789d8d

		annotation PBI_FormatHint = {"isDecimal":true}

