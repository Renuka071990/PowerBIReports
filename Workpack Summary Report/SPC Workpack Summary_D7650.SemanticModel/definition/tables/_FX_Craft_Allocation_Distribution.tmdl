	partition _FX_Craft_Allocation_Distribution = calculated
		mode: import
		source =
				UNION(
				        SUMMARIZE(FILTER(Excel_Kronos_2024,[fx_lookup_mdm]<>BLANK()),[FX_LastWeek],[fx_lookup_mdm],[JOB Number],[FX_Plant],[FX_Discipline],[FX_Phase],[StaticTbl_Exc_Craft.Craft Standard],"Status","3. Actual","Hours",SUM(Excel_Kronos_2024[Kronos Hrs]),"ManPower Factor",FIRSTNONBLANK(Excel_Kronos_2024[Manpower Factor],0)),
				        SUMMARIZE(FILTER('Excel_Distrib-Alloc-ToGo',[pqry_TYPE]="WPHRS"),[DATE],[NAME],[DESIGNAREA],[PROJECT],[DISCIPLINE],[FX_Phase],[Craft],"Status","1. To-Go WPhrs","Hours",SUM('Excel_Distrib-Alloc-ToGo'[FX_Distribution_Hrs]),"ManPower Factor",60),
				        SUMMARIZE(FILTER('Excel_Distrib-Alloc-ToGo',[pqry_TYPE]="WPHRS"),[DATE],[NAME],[DESIGNAREA],[PROJECT],[DISCIPLINE],[FX_Phase],[Craft],"Status","4. To-Go AFCHrs","Hours",SUM('Excel_Distrib-Alloc-ToGo'[fx_afc_distrib]),"ManPower Factor",60),
				        SUMMARIZE(FILTER('Excel_Distrib-Alloc-ToGo',[pqry_TYPE]="AFCHRS" && [FX_STATUS] = BLANK()),[DATE],[NAME],[DESIGNAREA],[PROJECT],[DISCIPLINE],[FX_Phase],[Craft],"Status","1. To-Go AFCHrs Prelim","Hours",SUM('Excel_Distrib-Alloc-ToGo'[FX_Distribution_Hrs]),"ManPower Factor",60),
				        SUMMARIZE('Excel_D7650 MLF',[Week Ending],[FX_WPNO],[fx_dmy_jobno],[Facility],[Discipline],[Type],[Craft],"Status","2. MLF","Hours",SUM('Excel_D7650 MLF'[FX_Approved_Hrs]),"ManPower Factor",60))

	annotation PBI_Id = c660c94a110448eb8ed70d8595594d58

