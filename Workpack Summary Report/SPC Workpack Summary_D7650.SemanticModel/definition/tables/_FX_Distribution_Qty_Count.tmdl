	partition _FX_Distribution_Qty_Count = calculated
		mode: import
		source =
				union(
				SUMMARIZE(FX_Distribution_Allocation_Count,[NAME],[FIWPOBID],[DISCIPLINE],[DATE],"Count",sum(FX_Distribution_Allocation_Count[FX_Comp_Bal_Dist]),"Qty",sum(FX_Distribution_Allocation_Count[FX_Quantity_Bal_Dist-00]),"Hours Balance",sum(FX_Distribution_Allocation_Count[FX_WPHrs_Bal_Dist]),"Hours Completed",0,"uom",firstnonblank(FX_Distribution_Allocation_Count[FX_UOM-00],0),"Status","01. To-Go"),
				--SUMMARIZE(FILTER('Qry_IWP Detail','Qry_IWP Detail'[WP Progress]>=1),[WPNO],[DISCIPLINE],[FX_Comp_Actual_WkEnd],"Count",sum('Qry_IWP Detail'[FX_Count_Delta]),"Qty",sum('Qry_IWP Detail'[FX_Qty_Delta]),"Hours Balance",0,"Hours Completed",0,"UOM",FIRSTNONBLANK('Qry_IWP Detail'[FX_UOM],0),"Status","04. Completed"),
				SUMMARIZE('Excel_Distrib-Alloc-Plan',[NAME],[FIWPOBID],[DISCIPLINE],[DATE],"Count",SUM('Excel_Distrib-Alloc-Plan'[FX_Count_Distrib]),"Qty",SUM('Excel_Distrib-Alloc-Plan'[FX_Qty_Distrib]),"Hours Balance",0,"Hours Completed",0,"UOM",FIRSTNONBLANK('Excel_Distrib-Alloc-Plan'[FX_UOM],0),"Status","02. Planned"),
				SUMMARIZE(dataflow_ProgressReportHistory,[WPNO],[FIWPOBID],[DISCIPLINE],[Date],"Count",sum(dataflow_ProgressReportHistory[FX_CompCount_WklyProg]),"Qty",sum(dataflow_ProgressReportHistory[FX_CompQty_WklyProg]),"Hours Balance",0,"Hours Completed",SUM(dataflow_ProgressReportHistory[FX_Kronos_Wkly]),"UOM",FIRSTNONBLANK(dataflow_ProgressReportHistory[FX_UOM],1),"Status","04. Completed"),
				SUMMARIZE(_FX_Prod_ActivityCode,[WPNO],[FIWPOBID],[DISCIPLINE],"Date",[MX_CurrentWeekEnding],"Count",0,"Qty",0,"Hours Balance",0,"Hours Completed",SUM(_FX_Prod_ActivityCode[FX_Kronos_Hrs_Wk]),"UOM","","Status","04. Completed")
				
				)

	annotation PBI_Id = d1c885e1f57c4e23bddcf35ebe9e8df5

