table _FX_Distribution_Qty_Count
	lineageTag: d19f93f1-a955-4544-80e6-9e0292ff7cf9

	measure MX_QTY_Tot = sum(_FX_Distribution_Qty_Count[Qty])
		formatString: #,0
		lineageTag: 9ec01a37-1e0b-4cff-82fc-e162f43ffdd6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure MX_Count_Tot = sum(_FX_Distribution_Qty_Count[Count])
		formatString: #,0
		lineageTag: 625bc982-da41-4686-bb4e-5db7ba4cc0c5

		annotation PBI_FormatHint = {"isDecimal":true}

	measure mx_hour_bal =
			var _bal = SUM(_FX_Distribution_Qty_Count[Hours Balance])
			
			return
			IF(SELECTEDVALUE(_FX_Distribution_Qty_Count[DATE])<[MX_CurrentWeekEnding],BLANK(),_bal)
		lineageTag: d400030b-98cb-4e18-a875-7b64aa21358e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure mx_hour_complete =
			var _bal = SUM(_FX_Distribution_Qty_Count[Hours Completed])
			
			return
			IF(SELECTEDVALUE(_FX_Distribution_Qty_Count[DATE])>[MX_CurrentWeekEnding],BLANK(),_bal)
		lineageTag: 9d2397d9-53eb-41e1-9e11-8143728badb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

