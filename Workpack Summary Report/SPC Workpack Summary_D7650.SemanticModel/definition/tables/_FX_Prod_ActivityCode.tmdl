	column FX_Kronos_FitterWelderProgCheck =
			if([FX_SPC_Welder_ActCode]<>BLANK() && [FX_Kronos_Hrs_Wk_Fitter]>0 && [FX_Kronos_Hrs_Wk_Welder]>0,"Both",
			IF([FX_SPC_Welder_ActCode]<>BLANK() && ([FX_Kronos_Hrs_Wk_Fitter]=0 || [FX_Kronos_Hrs_Wk_Fitter]=BLANK()) && [FX_Kronos_Hrs_Wk_Welder]>0,"Welder Only",
			IF(([FX_Kronos_Hrs_Wk_Fitter]=0 || [FX_Kronos_Hrs_Wk_Fitter]=BLANK())  && ([FX_Kronos_Hrs_Wk_Welder]=0 || [FX_Kronos_Hrs_Wk_Welder]=BLANK()),"No Booking","Fitter Only")))
		lineageTag: d1481803-17bd-4192-86e9-36802d93a065
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _FX_SPC_Fitter_WPHrs_WklyEarn = ```
			var _fitterweigt = (100-_FX_Prod_ActivityCode[WELD_WEIGHTAGE])/100
			return
			IF(_FX_Prod_ActivityCode[FX_Kronos_FitterWelderProgCheck]="Welder Only",0,
			IF(_FX_Prod_ActivityCode[_FX_SPC_WeldGateCheck]="No Weld Gate" || _FX_Prod_ActivityCode[FX_Kronos_FitterWelderProgCheck]="Fitter Only",_FX_Prod_ActivityCode[FX_WPHrs_WklyEarn],_FX_Prod_ActivityCode[FX_WPHrs_WklyEarn]*_fitterweigt))
			
			```
		lineageTag: 7f87f48f-3a3c-414c-8c90-f0364b55196f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column _FX_SPC_Welder_WPHrs_WklyEarn = ```
			var _welderweigt = _FX_Prod_ActivityCode[WELD_WEIGHTAGE]/100
			return
			IF(_FX_Prod_ActivityCode[_FX_SPC_WeldGateCheck]="No Weld Gate" || _FX_Prod_ActivityCode[FX_Kronos_FitterWelderProgCheck]="Fitter Only", 0,
			IF(_FX_Prod_ActivityCode[FX_Kronos_FitterWelderProgCheck]="Welder Only",_FX_Prod_ActivityCode[FX_WPHrs_WklyEarn],
			_FX_Prod_ActivityCode[FX_WPHrs_WklyEarn]*_welderweigt))
			
			```
		lineageTag: 977d22a5-5f94-45a8-80ff-893bb9a6f1f1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_Fitter_Prod =
