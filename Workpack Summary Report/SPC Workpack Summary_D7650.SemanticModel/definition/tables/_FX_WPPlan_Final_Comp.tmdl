	partition _FX_WPPlan_Final_Comp-679679a7-db54-4084-b599-c28982b5169c = calculated
		mode: import
		source =
				var _comp_actual = CALCULATETABLE (SUMMARIZE('Qry_IWP Detail','Qry_IWP Detail'[WPNO],[FIWPOBID],'Qry_IWP Detail'[FX_Comp_Actual_WkEnd],'Qry_IWP Detail'[DISCIPLINE],'Qry_IWP Detail'[FX_Completion_Status],'Qry_IWP Detail'[STATUS],'Qry_IWP Detail'[WP PURPOSE],'Qry_IWP Detail'[AFC Hrs],"FX_Type","Complete Actual"),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Comp_Actual_WkEnd]<=[MX_CurrentWeekEnding]))
				var _comp_plan = SUMMARIZE('Qry_IWP Detail','Qry_IWP Detail'[WPNO],[FIWPOBID],'Qry_IWP Detail'[FX_Comp_Plan_WkEnd],'Qry_IWP Detail'[DISCIPLINE],'Qry_IWP Detail'[FX_Completion_Status],'Qry_IWP Detail'[STATUS],'Qry_IWP Detail'[WP PURPOSE],'Qry_IWP Detail'[AFC Hrs],'Qry_IWP Detail'[FX_CompPlan_Status])
				return
				
				union(_comp_actual,_comp_plan)

	annotation PBI_Id = d55d8aec2d344cc787a9938b72ef0aad

