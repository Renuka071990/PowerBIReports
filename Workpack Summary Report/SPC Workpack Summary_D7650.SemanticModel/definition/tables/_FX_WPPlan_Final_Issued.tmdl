	partition _FX_WPPlan_Final_Issued-a27a1087-9603-437c-a6ae-807ed96423aa = calculated
		mode: import
		source =
				
				var _issued_actual = CALCULATETABLE(SUMMARIZE('Qry_IWP Detail',[WPNO],[FIWPOBID],[FX_Issued_Actual_WkEnd],[DISCIPLINE],[FX_Issued_Status],[STATUS],[WP PURPOSE],[AFC Hrs],"FX_Type","Issued Actual","Weekly Earn",0),filter('Qry_IWP Detail',[FX_Issued_Actual_WkEnd]<=[MX_CurrentWeekEnding]))
				var _issued_plan = SUMMARIZE('Qry_IWP Detail',[WPNO],[FIWPOBID],[FX_Issued_Plan_WkEnd],[DISCIPLINE],[FX_Issued_Status],[STATUS],[WP PURPOSE],[AFC Hrs],[FX_IssuedPlan_Status],"Weekly Earn",0)
				var _issued_progress = SUMMARIZE(FILTER('dataflow_ProgressReportHistory',[WP Weekly Earned]>0),[WPNO],[FIWPOBID],[Date],[DISCIPLINE],"Issued Status","","Status","","WP Purpose","","AFC Hrs",0,"FX_Type","Weekly Progress","Weekly Earn",SUMX(FILTER(dataflow_ProgressReportHistory,[Date]=EARLIER([Date])),dataflow_ProgressReportHistory[WP Weekly Earned]))
				return
				
				union(_issued_actual,_issued_plan,_issued_progress)

	annotation PBI_Id = ba245bb06dc543c0a6a3b38b3209213d

