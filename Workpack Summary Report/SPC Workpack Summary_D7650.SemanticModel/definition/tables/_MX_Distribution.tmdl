	measure CF_Craft_Table =
			
			var _week = CALCULATE(FIRSTNONBLANK(_FX_Craft_Allocation_Distribution[FX_LastWeek],1),FILTER(_FX_Craft_Allocation_Distribution,[FX_LastWeek]=[MX_CurrentWeekEnding]))
