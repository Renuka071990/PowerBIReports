			IF(SELECTEDVALUE(Qry_IWP_Constraints[Type01])="Welder",
			    SUM(_FX_Prod_ActivityCode[_FX_SPC_Welder_WPHrs_WklyEarn]),
			IF(SELECTEDVALUE(Qry_IWP_Constraints[Type01])="Fitter",
			    CALCULATE(SUM(_FX_Prod_ActivityCode[_FX_SPC_Fitter_WPHrs_WklyEarn]),_FX_Prod_ActivityCode[DISCIPLINE]<>"Coating"),
			        IF(SELECTEDVALUE(Qry_IWP_Constraints[Type01])="Painting",
