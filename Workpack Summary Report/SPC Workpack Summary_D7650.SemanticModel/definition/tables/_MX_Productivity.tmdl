	measure MX_CurrentWeekEnding_dynamic =
			
			var curr = (if(WEEKDAY(today()) < 6,(today()+5) - WEEKDAY(today()),((today()+5) - WEEKDAY(today()))+7))
			var prev = (if(WEEKDAY(today()) < 6,(today()+5) - WEEKDAY(today()),((today()+5) - WEEKDAY(today()))+7))-7
			RETURN
			IF(SELECTEDVALUE(StaticTbl_CurrentPrevWeek[Week Type])="Current",curr,prev)
		formatString: General Date
