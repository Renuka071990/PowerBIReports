			var output = SUMX(VALUES(Qry_IWP_Constraints[Type01]),
			IF(Qry_IWP_Constraints[Type01] = "Welder", SUM(_FX_Prod_ActivityCode[FX_SPC_Welder_WPHrs]), 
			IF(Qry_IWP_Constraints[Type01] = "Fitter",CALCULATE(SUM(_FX_Prod_ActivityCode[FX_SPC_Fitter_WPHrs]),_FX_Prod_ActivityCode[DISCIPLINE]<>"Coating"),
