	measure MX_Prod_Fitter_WPHrs_Wkly = ```
			
			var output = SUMX(VALUES(Qry_IWP_Constraints[Type01]),
			IF(Qry_IWP_Constraints[Type01] = "Welder", SUM(_FX_Prod_ActivityCode[_FX_SPC_Welder_WPHrs_WklyEarn]), 
			IF(Qry_IWP_Constraints[Type01] = "Fitter",CALCULATE(SUM(_FX_Prod_ActivityCode[_FX_SPC_Fitter_WPHrs_WklyEarn]),_FX_Prod_ActivityCode[DISCIPLINE]<>"Coating"),
			IF(Qry_IWP_Constraints[Type01] = "Painting",CALCULATE(SUM(_FX_Prod_ActivityCode[_FX_SPC_Fitter_WPHrs_WklyEarn]),_FX_Prod_ActivityCode[DISCIPLINE]="Coating"),BLANK()))))
			RETURN
			output
			
			```
		formatString: #,0
		lineageTag: 369d71c1-a86c-4a83-917b-c20a59fce456

		annotation PBI_FormatHint = {"isDecimal":true}

