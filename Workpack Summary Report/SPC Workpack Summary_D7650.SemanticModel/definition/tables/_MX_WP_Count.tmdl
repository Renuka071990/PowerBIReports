table _MX_WP_Count
	lineageTag: 802b8dc0-80ab-4ba2-8b86-21f1d4c7f038

	measure MS_WP_Count = DISTINCTCOUNT('Qry_IWP Detail'[FIWPOBID])
		formatString: #,0
		lineageTag: 0015d71f-176a-4049-a045-7a423b3fcff7

		changedProperty = FormatString

	measure MS_WP_Issued = ```
			
			var a = CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),
			FILTER('Qry_IWP Detail',
			    ('Qry_IWP Detail'[FX_Issued_Actual_WkEnd]<=[MX_CurrentWeekEnding_dynamic] && 
			    'Qry_IWP Detail'[STATUS]="Issued for Construction")))
			RETURN
			if(a=0 || a=BLANK(),0,a)
			```
		formatString: #,0
		lineageTag: ec6ccfd0-a697-46ff-b969-02a97618338c

	measure MS_WP_Issued_Late = ```
			
			var old = if(isblank(CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Issued_Status]="03-Late"))),0,CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Issued_Status]="03-Late")))
			var currwe = [MX_CurrentWeekEnding]
			var new =     CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPOBID]),
			    'Qry_IWP Detail'[STATUS]<>"Issued for Construction" && 'Qry_IWP Detail'[WP Hrs]=BLANK()  && 'Qry_IWP Detail'[WP Planned Start Date]<currwe)
			    RETURN
			    old
			
			```
		formatString: 0
		lineageTag: 9ce938fb-4be1-4307-91e1-5d3798e254be

	measure MS_WP_Issued_OnSched = if(isblank(CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Issued_Status]="02-On Sched"))),0,CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Issued_Status]="02-On Sched")))
		formatString: #,0
		lineageTag: 1978303f-352a-499a-a8ce-5ed73022d5f0

		changedProperty = FormatString

	measure MS_WP_Comp = if(isblank(CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Completion_Status]="01-IWP Completed"))),0,CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPUID]),filter('Qry_IWP Detail','Qry_IWP Detail'[FX_Completion_Status]="01-IWP Completed")))
		formatString: 0
		lineageTag: 5e78a87b-6ce5-47a0-b6f1-68167cc6c521

