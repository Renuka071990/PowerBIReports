	measure mx_plan_issuance_wkly =
			
			var plan = MAX('Qry_IWP Detail'[FX_Issued_Plan_WkEnd])
			RETURN
			IF(plan=[MX_CurrentWeekEnding_dynamic],1,0)
		formatString: 0
