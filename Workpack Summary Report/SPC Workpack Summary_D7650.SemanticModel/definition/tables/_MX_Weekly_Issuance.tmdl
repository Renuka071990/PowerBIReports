	measure mx_actualstart_currwk =
			
			var currentwk = [MX_CurrentWeekEnding]
			var _type = SELECTEDVALUE(Statictbl_WPStatus[Status])
			
			var _count = CALCULATE(
			    DISTINCTCOUNT('Qry_IWP Detail'[FIWPOBID]),
			    'Qry_IWP Detail'[WP Actual Start Date]<=currentwk &&  'Qry_IWP Detail'[WP Actual Start Date]>(currentwk-7) && 'Qry_IWP Detail'[WP Progress]>0
			    )
			var _hours = CALCULATE(
			   SUMX(DISTINCT('Qry_IWP Detail'[FIWPOBID]),
			   CALCULATE(MAX('Qry_IWP Detail'[WP Hrs]))),
			    'Qry_IWP Detail'[WP Actual Start Date]<=currentwk &&  'Qry_IWP Detail'[WP Actual Start Date]>(currentwk-7) && 'Qry_IWP Detail'[WP Progress]>0
			    )
			  var output = IF(_type = "Count", _count,_hours)
			    RETURN
			output
		formatString: 0
		displayFolder: Start - Count
		lineageTag: eaaba4bb-4bc7-4aba-8e8c-7f22a726bd17

	measure mx_chrt_planissued_wkly =
			
			var currwe = [MX_CurrentWeekEnding]
			var _type = SELECTEDVALUE(Statictbl_WPStatus[Status])
			var _count = CALCULATE(
			    COUNT('Qry_IWP Detail'[FIWPOBID]),
			    USERELATIONSHIP(_FX_Date[Date],'Qry_IWP Detail'[WP Planned Start Date]))
			var _hours = CALCULATE(
			   SUMX(DISTINCT('Qry_IWP Detail'[FIWPOBID]),
			   CALCULATE(MAX('Qry_IWP Detail'[AFC Hrs]))),
			    USERELATIONSHIP(_FX_Date[Date],'Qry_IWP Detail'[WP Planned Start Date]))
			  var output = IF(_type = "Count", _count,_hours)
			RETURN
			IF(MAX(_FX_Date[Date])<= currwe,output,BLANK())
		formatString: 0
		displayFolder: Start - Count
