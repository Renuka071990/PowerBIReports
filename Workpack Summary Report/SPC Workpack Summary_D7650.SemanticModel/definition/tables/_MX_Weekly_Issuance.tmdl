	measure MX_WP_Issued_Plan_cumm =
			
			var old = sumx(filter(_FX_WPPlan_Final_Issued,_FX_WPPlan_Final_Issued[FX_Type]="IssuedPlan-Past" && _FX_WPPlan_Final_Issued[WeekEnding]=[MX_CurrentWeekEnding]),_FX_WPPlan_Final_Issued[FX_Issued_Plan_Cnt])
			RETURN
			CALCULATE(DISTINCTCOUNT('Qry_IWP Detail'[FIWPOBID]),
			FILTER('Qry_IWP Detail',
			    'Qry_IWP Detail'[FX_Issued_Plan_WkEnd]<=[MX_CurrentWeekEnding_dynamic] &&
			    'Qry_IWP Detail'[FX_Issued_Plan_WkEnd]<>BLANK()))
