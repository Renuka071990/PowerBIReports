	column FX_CompCount_WklyProg =
			
			var _prevweek = [Date]-7
			var _prevweekvalue = CALCULATE(SUM(dataflow_ProgressReportHistory[WP Components Count Complete]),FILTER('dataflow_ProgressReportHistory',[WPNO]=EARLIER([WPNO]) &&[JOB NO]=EARLIER([JOB NO]) && [Date] = EARLIER([Date])-7))
			var _wklyprog = [WP Components Count Complete]-_prevweekvalue
			return
			_wklyprog
		lineageTag: 9f995078-2d38-4252-8391-16b72882eff6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FX_CompQty_WklyProg =
			
			var _gatecount = IF([ROC 1]<>BLANK() && [ROC 2]=BLANK(),1,
			IF([ROC 2]<>BLANK() && [ROC 3]=BLANK(),2,
			IF([ROC 3]<>BLANK() && [ROC 4]=BLANK(),3,
			IF([ROC 4]<>BLANK() && [ROC 5]=BLANK(),4,
			IF([ROC 5]<>BLANK() && [ROC 6]=BLANK(),5,
			IF([ROC 6]<>BLANK(),6,0))))))
			var _prevweek = [Date]-7
			var _prevweekvalue = CALCULATE(SUM(dataflow_ProgressReportHistory[COMPLETED_UNITS]),FILTER('dataflow_ProgressReportHistory',[WPNO]=EARLIER([WPNO]) &&[JOB NO]=EARLIER([JOB NO]) && [Date] = EARLIER([Date])-7))
			var _wklyprog = IF([RATEUOM]="kg",([COMPLETED_UNITS]-_prevweekvalue)/1000,([COMPLETED_UNITS]-_prevweekvalue))
			var _wklyprog_20240606_adj = IF([RATEUOM]="kg",([COMPLETED_UNITS]-(_prevweekvalue/_gatecount))/1000,([COMPLETED_UNITS]-(_prevweekvalue/_gatecount)))
			
			return
			IF([Date]=DATE(2024,06,06),_wklyprog_20240606_adj,
			if([Date]>DATE(2024,06,06),_wklyprog,(_wklyprog/_gatecount)))
		lineageTag: 695ae6e2-621b-419b-8c02-229c01a8f8cd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

