			var _prevweek = [Date]-7
			var _prevweekvalue = CALCULATE(SUM(dataflow_ProgressReportHistory[WP Components Count Complete]),FILTER('dataflow_ProgressReportHistory',[WPNO]=EARLIER([WPNO]) && [Date] = EARLIER([Date])-7))
			var _wklyprog = [WP Components Count Complete]-_prevweekvalue
			var _gatecount = IF([ROC 1]<>BLANK() && [ROC 2]=BLANK(),1,
			IF([ROC 2]<>BLANK() && [ROC 3]=BLANK(),2,
			IF([ROC 3]<>BLANK() && [ROC 4]=BLANK(),3,
